  <transform>
    <type>ScriptValueMod</type>
    <name>Validate reconcile and build response</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var http_status = 200;
var response_json = "";
var operation = be_operation;
var batch_id = "";
var loaded_at = null;
var allowedOps = getVariable("HOP_MDM_USERS_ALLOWED_OPERATIONS", "INSERT,UPDATE,DELETE");
var serviceId = getVariable("HOP_MDM_USERS_SERVICE_ID", "mdm-users");

function hasOp(op) {
  return allowedOps.indexOf(op) >= 0;
}

// Field validation
if (!be_operation || !hasOp(String(be_operation))) {
  http_status = 400;
  response_json = JSON.stringify({ status: "ERROR", message: "Invalid operation" });
} else if (!user_id || user_id &lt;= 0) {
  http_status = 400;
  response_json = JSON.stringify({ status: "ERROR", message: "Invalid user_id" });
} else if (!username || String(username).trim().length == 0) {
  http_status = 400;
  response_json = JSON.stringify({ status: "ERROR", message: "Invalid username" });
} else if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(email))) {
  http_status = 400;
  response_json = JSON.stringify({ status: "ERROR", message: "Invalid email" });
} else if (age == null || age &lt;= 0) {
  http_status = 400;
  response_json = JSON.stringify({ status: "ERROR", message: "Invalid age" });
} else if (!gender || (String(gender) != "M" &amp;&amp; String(gender) != "F")) {
  http_status = 400;
  response_json = JSON.stringify({ status: "ERROR", message: "Invalid gender" });
} else if (!created_at || !last_update_timestamp) {
  http_status = 400;
  response_json = JSON.stringify({ status: "ERROR", message: "Missing timestamps" });
}

var exists_in_nds = (nds_user_sk != null &amp;&amp; nds_user_sk != undefined &amp;&amp; String(nds_user_sk).length > 0);

if (http_status == 200) {
  if (be_operation == "INSERT") {
    operation = exists_in_nds ? "UPDATE" : "INSERT";
  } else if (be_operation == "UPDATE") {
    operation = exists_in_nds ? "UPDATE" : "INSERT";
  } else if (be_operation == "DELETE") {
    if (!exists_in_nds) {
      http_status = 404;
      response_json = JSON.stringify({ status: "ERROR", message: "User not found in NDS" });
    } else {
      operation = "DELETE";
    }
  }
}

var Timestamp = Packages.java.sql.Timestamp;
var Instant = Packages.java.time.Instant;

function toTimestamp(val) {
  if (val == null) {
    return null;
  }
  var s = String(val).trim();
  if (s.length == 0) {
    return null;
  }
  return Timestamp.from(Instant.parse(s));
}

if (http_status == 200) {
  created_at = toTimestamp(created_at);
  last_update_timestamp = toTimestamp(last_update_timestamp);
  loaded_at = Timestamp.from(Instant.now());
  var batchSdf = new java.text.SimpleDateFormat("yyyyMMddHHmmss");
  var batchTs = batchSdf.format(new java.util.Date());
  batch_id = String(serviceId) + "-" + String(user_id) + "-" + batchTs;
  response_json = JSON.stringify({ status: "ACCEPTED", user_id: user_id, batch_id: batch_id });
}</jsScript_script>
      </jsScript>
    </jsScripts>
