<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>New pipeline</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/06/11 12:16:03.773</created_date>
    <modified_date>2026/06/11 12:16:03.773</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Query stg_ratings data by LSET/CET</name>
    <sql>SELECT 
    rating_id,
    user_id,
    movie_id,
    rating,
    rated_at,
    last_update_timestamp
FROM public.ratings
WHERE last_update_timestamp > '${RATING_LSET}'::timestamp
  AND last_update_timestamp &lt;= '${RATING_CET}'::timestamp;
</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>src-ratings-revenues</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>288</xloc>
      <yloc>32</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableInput</type>
    <name>Count stg_ratings rows by LSET/CET</name>
    <sql>SELECT COUNT(*)::integer AS rows_extracted
FROM public.ratings
WHERE last_update_timestamp > '${RATING_LSET}'::timestamp
  AND last_update_timestamp &lt;= '${RATING_CET}'::timestamp;
</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>src-ratings-revenues</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>576</xloc>
      <yloc>32</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Set RATING_ROWS_EXTRACTED</name>
    <fields>
      <field>
        <field_name>rows_extracted</field_name>
        <variable_name>RATING_ROWS_EXTRACTED</variable_name>
        <variable_type>PARENT_WORKFLOW</variable_type>
        <default_value>0</default_value>
      </field>
    </fields>
    <use_formatting>Y</use_formatting>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>576</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TextFileOutput</type>
    <name>Export to "exported_ratings.csv" file</name>
    <compression>None</compression>
    <create_parent_folder>Y</create_parent_folder>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <enclosure_forced>N</enclosure_forced>
    <enclosure_fix_disabled>N</enclosure_fix_disabled>
    <header>Y</header>
    <footer>N</footer>
    <format>DOS</format>
    <encoding/>
    <endedLine/>
    <fileNameInField>N</fileNameInField>
    <fileNameField/>
    <schema_definition/>
    <ignore_fields>N</ignore_fields>
    <file>
      <name>${STAGING_RATINGS_DIR}/exported_ratings</name>
      <do_not_open_new_file_init>Y</do_not_open_new_file_init>
      <extension>csv</extension>
      <append>N</append>
      <split>N</split>
      <haspartno>N</haspartno>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <SpecifyFormat>N</SpecifyFormat>
      <date_time_format/>
      <add_to_result_filenames>Y</add_to_result_filenames>
      <pad>N</pad>
      <fast_dump>N</fast_dump>
      <splitevery>0</splitevery>
    </file>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>288</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Query stg_ratings data by LSET/CET</from>
      <to>Export to "exported_ratings.csv" file</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Count stg_ratings rows by LSET/CET</from>
      <to>Set RATING_ROWS_EXTRACTED</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
