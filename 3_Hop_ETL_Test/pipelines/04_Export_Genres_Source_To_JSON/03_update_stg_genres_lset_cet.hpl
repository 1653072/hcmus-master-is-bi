    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/06/11 16:00:00.000</created_date>
    <modified_date>2026/06/11 16:00:00.000</modified_date>
  </info>
  <transform>
    <type>ExecSql</type>
    <name>Update stg_genres LSET/CET in etl_extraction_control</name>
    <connection>dw-control</connection>
    <sql>UPDATE control.etl_extraction_control
SET
	lset = '${GENRE_LSET}'::timestamp,
	cet = '${GENRE_CET}'::timestamp,
	rows_extracted = ${GENRE_ROWS_EXTRACTED},
	last_run_status = 'SUCCESS'
WHERE control_id = ${GENRE_CONTROL_ID};</sql>
    <execute_each_row>N</execute_each_row>
    <update_field/>
    <insert_field/>
    <delete_field/>
    <read_field/>
    <single_statement>N</single_statement>
    <replace_variables>Y</replace_variables>
    <quoteString>N</quoteString>
    <set_params>N</set_params>
    <arguments/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>192</xloc>
      <yloc>32</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order/>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
