<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>New pipeline</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/06/11 16:00:00.000</created_date>
    <modified_date>2026/06/11 16:00:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Get stg_revenues LSET from etl_extraction_control</name>
    <sql>SELECT 
	control_id,
	lset
FROM control.etl_extraction_control
WHERE 
	source_name = 'ratings_revenues' 
	AND table_name = 'stg_revenues'
	AND last_run_status = 'SUCCESS'</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>dw-control</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>240</xloc><yloc>96</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SystemInfo</type>
    <name>Get system info (CET)</name>
    <fields><field><name>cet</name><type>system date (variable)</type></field></fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>240</xloc><yloc>208</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Set REVENUE_CET, REVENUE_LSET, REVENUE_CONTROL_ID</name>
    <fields>
      <field><field_name>cet</field_name><variable_name>REVENUE_CET</variable_name><variable_type>PARENT_WORKFLOW</variable_type><default_value/></field>
      <field><field_name>lset</field_name><variable_name>REVENUE_LSET</variable_name><variable_type>PARENT_WORKFLOW</variable_type><default_value/></field>
      <field><field_name>control_id</field_name><variable_name>REVENUE_CONTROL_ID</variable_name><variable_type>PARENT_WORKFLOW</variable_type><default_value/></field>
    </fields>
    <use_formatting>Y</use_formatting>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>240</xloc><yloc>336</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>  <order>
    <hop><from>Get stg_revenues LSET from etl_extraction_control</from><to>Get system info (CET)</to><enabled>Y</enabled></hop>
    <hop><from>Get system info (CET)</from><to>Set REVENUE_CET, REVENUE_LSET, REVENUE_CONTROL_ID</to><enabled>Y</enabled></hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
