    <created_date>2026/06/11 17:00:00.000</created_date>
    <modified_date>2026/06/11 17:00:00.000</modified_date>
  </info>
  <transform>
    <type>SystemInfo</type>
    <name>Get batch timestamp</name>
    <fields>
      <field>
        <name>batch_ts</name>
        <type>system date (variable)</type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>128</xloc>
      <yloc>96</yloc>
