  <transform>
    <type>TableInput</type>
    <name>Query PSQL ratings-revenues table (LSET/CET)</name>
    <sql>SELECT 
    rating_id,
    user_id,
    movie_id,
    rating,
    rated_at,
    last_update_timestamp
FROM public.ratings
WHERE last_update_timestamp > '${LSET}'::timestamp
  AND last_update_timestamp &lt;= '${CET}'::timestamp;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>src-ratings-revenues</connection>
