    <parameters/>
    <name>03_validate_noaa_raw_to_staging</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Flow 2 — DQ gate for NOAA: 3 parallel streams from raw_noaa_weather. Stream A: row-level reject details to etl_dq_rule_result_details. Stream B: aggregate counts to etl_dq_rule_result_analysis. Stream C: clean rows cast and upserted into stg_weather.</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/09 22:27:14.458</created_date>
    <modified_date>2026/07/09 22:27:14.458</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read NOAA reject row details</name>
    <sql>WITH src AS (
    SELECT
        r.load_run_id,
        r.source_file,
        r.source_row_number,
        r.noaa_station_id,
        r.observation_ts,
        r.report_type,
        r.hourly_dry_bulb_temperature,
        r.hourly_precipitation,
        r.hourly_wind_speed,
        r.hourly_present_weather_type,
        r.source_city_code,
        COALESCE(NULLIF(BTRIM(r.noaa_station_id), ''), '(null)')
            || '@'
            || COALESCE(NULLIF(BTRIM(r.observation_ts), ''), '(null)') AS business_key,
        NULLIF(BTRIM(r.source_city_code), '')    AS source_city_code_norm,
        NULLIF(BTRIM(r.noaa_station_id), '')    AS noaa_station_id_norm,
        NULLIF(BTRIM(r.observation_ts), '')     AS observation_ts_norm,
        NULLIF(BTRIM(r.report_type), '')        AS report_type_norm,
        jsonb_build_object(
            'noaa_station_id',               r.noaa_station_id,
            'observation_ts',                r.observation_ts,
            'report_type',                   r.report_type,
            'hourly_dry_bulb_temperature',   r.hourly_dry_bulb_temperature,
            'hourly_precipitation',          r.hourly_precipitation,
            'hourly_wind_speed',             r.hourly_wind_speed,
            'hourly_present_weather_type',   r.hourly_present_weather_type,
            'source_city_code',              r.source_city_code
        ) AS raw_payload
    FROM staging.raw_noaa_weather AS r
),

dup_keys AS (
    SELECT
        source_city_code,
        observation_ts
    FROM staging.raw_noaa_weather
    GROUP BY
        source_city_code,
        observation_ts
    HAVING COUNT(*) > 1
)

-- Rule 1: required fields
SELECT
    load_run_id,
    'noaa_lcd'         AS source_name,
    'raw_noaa_weather' AS source_table,
    source_file,
    source_row_number,
    business_key,
    'NOAA_NULL_REQUIRED' AS rule_code,
    'null'               AS rule_type,
    'reject'             AS dq_verdict,
    'Required field(s) null or blank: noaa_station_id/observation_ts/source_city_code' AS reason,
    raw_payload
FROM src
WHERE source_city_code_norm IS NULL
   OR noaa_station_id_norm IS NULL
   OR observation_ts_norm IS NULL

UNION ALL

-- Rule 2: duplicate (source_city_code, observation_ts)
SELECT
    s.load_run_id,
    'noaa_lcd',
    'raw_noaa_weather',
    s.source_file,
    s.source_row_number,
    s.business_key,
    'NOAA_DUPLICATE_HOUR',
    'duplicate',
    'reject',
    'Duplicate (source_city_code, observation_ts) in this load run',
    s.raw_payload
FROM src AS s
INNER JOIN dup_keys AS d
    ON  s.source_city_code = d.source_city_code
    AND s.observation_ts   = d.observation_ts

UNION ALL

-- Rule 3: numeric weather fields
SELECT
    load_run_id,
    'noaa_lcd',
    'raw_noaa_weather',
    source_file,
    source_row_number,
    business_key,
    'NOAA_DATATYPE_NUMERIC',
    'datatype',
    'reject',
    'One or more numeric weather fields contain non-numeric text',
    raw_payload
FROM src
WHERE noaa_station_id_norm IS NOT NULL
  AND observation_ts_norm IS NOT NULL
  AND (
        (hourly_dry_bulb_temperature IS NOT NULL
         AND hourly_dry_bulb_temperature !~ '^-?[0-9]+(\.[0-9]+)?$')
     OR (hourly_precipitation IS NOT NULL
         AND hourly_precipitation !~ '^-?[0-9]+(\.[0-9]+)?$')
     OR (hourly_wind_speed IS NOT NULL
         AND hourly_wind_speed !~ '^-?[0-9]+(\.[0-9]+)?$')
      )

UNION ALL

-- Rule 4: report_type whitelist
SELECT
    load_run_id,
    'noaa_lcd',
    'raw_noaa_weather',
    source_file,
    source_row_number,
    business_key,
    'NOAA_FORMAT_REPORT_TYPE',
    'format',
    'reject',
    'report_type null or not in (FM-15, FM-16, FM-12)',
    raw_payload
FROM src
WHERE noaa_station_id_norm IS NOT NULL
  AND observation_ts_norm IS NOT NULL
  AND (
        report_type_norm IS NULL
     OR report_type NOT IN ('FM-15', 'FM-16', 'FM-12')
      );</sql>
