<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>03_validate_noaa_raw_to_staging</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Visible DQ pipeline for staging.raw_noaa_weather: required fields, duplicate hour, numeric datatype, report_type format, and accepted staging evidence.</description>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read NOAA raw DQ rule counts</name>
    <connection>dw-staging</connection>
    <sql><![CDATA[WITH src AS (
  SELECT *
  FROM staging.stg_weather
),
dup AS (
  SELECT source_city_code, observation_ts, COUNT(*) AS duplicate_count
  FROM src
  GROUP BY source_city_code, observation_ts
  HAVING COUNT(*) > 1
),
rules AS (
  SELECT 'NOAA_NULL_REQUIRED' AS rule_code, 'null' AS rule_type, 'reject' AS severity,
         COUNT(*) FILTER (WHERE source_city_code IS NULL
                           OR noaa_station_id IS NULL
                           OR observation_ts IS NULL) AS failed_count,
         0::BIGINT AS warning_count,
         COUNT(*) AS total_count
  FROM src
  UNION ALL
  SELECT 'NOAA_DUPLICATE_HOUR', 'duplicate', 'reject',
         COALESCE(SUM(duplicate_count), 0), 0::BIGINT, (SELECT COUNT(*) FROM src)
  FROM dup
  UNION ALL
  SELECT 'NOAA_DATATYPE_NUMERIC', 'datatype', 'reject',
         0::BIGINT, 0::BIGINT, COUNT(*)
  FROM src
  UNION ALL
  SELECT 'NOAA_FORMAT_REPORT_TYPE', 'format', 'reject',
         COUNT(*) FILTER (WHERE report_type IS NULL OR report_type NOT IN ('FM-15', 'FM-16', 'FM-12')),
         0::BIGINT, COUNT(*)
  FROM src
)
SELECT 'noaa_lcd' AS source_name,
       'bootstrap_202601_202605' AS load_run_id,
       'staging.stg_weather' AS source_table,
       'control.etl_dq_rule_result_details' AS reject_target,
       'staging.stg_weather' AS accepted_target,
       rule_code,
       rule_type,
       severity,
       GREATEST(total_count - failed_count - warning_count, 0)::INTEGER AS passed_count,
       failed_count::INTEGER AS failed_count,
       warning_count::INTEGER AS warning_count
FROM rules]]></sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <GUI><xloc>96</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Write NOAA DQ rule stream evidence</name>
    <connection>dw-control</connection>
    <schema>control</schema>
    <table>etl_dq_rule_result_analysis</table>
    <commit>100</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <fields>
      <field><stream_name>load_run_id</stream_name><column_name>load_run_id</column_name></field>
      <field><stream_name>source_name</stream_name><column_name>source_name</column_name></field>
      <field><stream_name>rule_code</stream_name><column_name>rule_code</column_name></field>
      <field><stream_name>rule_type</stream_name><column_name>rule_type</column_name></field>
      <field><stream_name>severity</stream_name><column_name>severity</column_name></field>
      <field><stream_name>passed_count</stream_name><column_name>passed_count</column_name></field>
      <field><stream_name>failed_count</stream_name><column_name>failed_count</column_name></field>
      <field><stream_name>warning_count</stream_name><column_name>warning_count</column_name></field>
    </fields>
    <GUI><xloc>448</xloc><yloc>96</yloc></GUI>
  </transform>
  <order><hop><from>Read NOAA raw DQ rule counts</from><to>Write NOAA DQ rule stream evidence</to><enabled>Y</enabled></hop></order>
  <notepads>
    <notepad><note>Hard reject target: control.etl_dq_rule_result_details. Accepted weather rows are represented by staging.stg_weather.</note><xloc>96</xloc><yloc>224</yloc><width>760</width><heigth>80</heigth></notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
