  <transform>
    <type>TableInput</type>
    <name>Read NOAA clean rows</name>
    <sql>SELECT DISTINCT ON (source_city_code, observation_ts)
       load_run_id,
       source_file,
       noaa_station_id,
       observation_ts,
       report_type,
       hourly_dry_bulb_temperature,
       hourly_precipitation,
       hourly_wind_speed,
       hourly_present_weather_type,
       source_city_code
FROM staging.raw_noaa_weather
WHERE NULLIF(BTRIM(source_city_code), '') IS NOT NULL
  AND NULLIF(BTRIM(noaa_station_id), '')  IS NOT NULL
  AND NULLIF(BTRIM(observation_ts), '')   IS NOT NULL
  AND NULLIF(BTRIM(report_type), '')      IS NOT NULL
  AND report_type IN ('FM-15', 'FM-16', 'FM-12')
  AND (hourly_dry_bulb_temperature IS NULL
       OR hourly_dry_bulb_temperature ~ '^-?[0-9]+(\.[0-9]+)?$')
  AND (hourly_precipitation IS NULL
       OR hourly_precipitation ~ '^-?[0-9]+(\.[0-9]+)?$')
  AND (hourly_wind_speed IS NULL
       OR hourly_wind_speed ~ '^-?[0-9]+(\.[0-9]+)?$')
ORDER BY
    source_city_code,
    observation_ts;</sql>
