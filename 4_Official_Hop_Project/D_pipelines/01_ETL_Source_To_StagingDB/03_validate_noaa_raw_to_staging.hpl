  <transform>
    <type>TableInput</type>
    <name>Read NOAA raw DQ rule counts</name>
    <sql>WITH src AS (
    SELECT
        r.*,
        NULLIF(BTRIM(r.source_city_code), '') AS source_city_code_norm,
        NULLIF(BTRIM(r.noaa_station_id), '')  AS noaa_station_id_norm,
        NULLIF(BTRIM(r.observation_ts), '')   AS observation_ts_norm,
        NULLIF(BTRIM(r.report_type), '')      AS report_type_norm
    FROM staging.raw_noaa_weather AS r
),

enriched AS (
    SELECT
        s.*,
        COUNT(*) OVER (
            PARTITION BY s.source_city_code, s.observation_ts
        ) AS hour_key_count
    FROM src AS s
),

metrics AS (
    SELECT
        COUNT(*)::BIGINT AS total_count,

        COUNT(*) FILTER (
            WHERE source_city_code_norm IS NULL
               OR noaa_station_id_norm IS NULL
               OR observation_ts_norm IS NULL
        )::BIGINT AS null_required_count,

        COUNT(*) FILTER (
            WHERE hour_key_count > 1
        )::BIGINT AS duplicate_hour_count,

        COUNT(*) FILTER (
            WHERE (hourly_dry_bulb_temperature IS NOT NULL
                   AND hourly_dry_bulb_temperature !~ '^-?[0-9]+(\.[0-9]+)?$')
               OR (hourly_precipitation IS NOT NULL
                   AND hourly_precipitation !~ '^-?[0-9]+(\.[0-9]+)?$')
               OR (hourly_wind_speed IS NOT NULL
                   AND hourly_wind_speed !~ '^-?[0-9]+(\.[0-9]+)?$')
        )::BIGINT AS bad_numeric_count,

        COUNT(*) FILTER (
            WHERE report_type_norm IS NULL
               OR report_type NOT IN ('FM-15', 'FM-16', 'FM-12')
        )::BIGINT AS bad_report_type_count
    FROM enriched
),

rules AS (
    SELECT
        rule_code,
        rule_type,
        severity,
        failed_count,
        warning_count,
        m.total_count
    FROM metrics AS m
    CROSS JOIN LATERAL (
        VALUES
            ('NOAA_NULL_REQUIRED',      'null',      'reject', m.null_required_count,   0::BIGINT),
            ('NOAA_DUPLICATE_HOUR',     'duplicate', 'reject', m.duplicate_hour_count,  0::BIGINT),
            ('NOAA_DATATYPE_NUMERIC',   'datatype',  'reject', m.bad_numeric_count,     0::BIGINT),
            ('NOAA_FORMAT_REPORT_TYPE', 'format',    'reject', m.bad_report_type_count, 0::BIGINT)
    ) AS rule_def (
        rule_code,
        rule_type,
        severity,
        failed_count,
        warning_count
    )
)

SELECT
    'noaa_lcd'                AS source_name,
    'bootstrap_202601_202605' AS load_run_id,
    rule_code,
    rule_type,
    severity,
    GREATEST(total_count - failed_count - warning_count, 0)::INTEGER AS passed_count,
    failed_count::INTEGER,
    warning_count::INTEGER
FROM rules;</sql>
