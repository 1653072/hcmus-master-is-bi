<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>05_audit_dq_rule_results</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Audits DQ results: reads aggregate rule counts from control.etl_dq_rule_result_analysis, computes per-source-per-rule-type totals, and inserts a row per (source, rule_type) into control.etl_job_log with job_name=etl_source_to_stagingdb_dq_validation.</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/09 01:14:45.318</created_date>
    <modified_date>2026/07/09 01:14:45.318</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read DQ rule result summary</name>
    <sql>SELECT
  COALESCE(load_run_id, 'latest') AS load_run_id,
  source_name,
  rule_type,
  COUNT(*)::INTEGER AS rule_count,
  SUM(passed_count)::INTEGER AS passed_count,
  SUM(failed_count)::INTEGER AS failed_count,
  SUM(warning_count)::INTEGER AS warning_count,
  MAX(checked_at) AS checked_at
FROM control.etl_dq_rule_result_analysis
GROUP BY COALESCE(load_run_id, 'latest'), source_name, rule_type
ORDER BY source_name, rule_type</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>dw-control</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>Add DQ audit job fields</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var job_name = "etl_source_to_stagingdb_dq_validation";
var status = failed_count > 0 ? "DQ_FAILED" : "DQ_PASSED";
var finished_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());
var started_at;
try {
  started_at = Packages.java.sql.Timestamp.valueOf(getVariable("ETL_STARTED_AT", "2026-01-01 00:00:00.0"));
} catch(e) {
  started_at = finished_at;
}
var total_rows_count   = passed_count + failed_count + warning_count;
var success_rows_count = passed_count + warning_count;
var failed_rows_count  = failed_count;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>job_name</name>
        <rename>job_name</rename>
        <type>String</type>
        <length>100</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>status</name>
        <rename>status</rename>
        <type>String</type>
        <length>20</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>finished_at</name>
        <rename>finished_at</rename>
        <type>Timestamp</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>started_at</name>
        <rename>started_at</rename>
        <type>Timestamp</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>total_rows_count</name>
        <rename>total_rows_count</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>success_rows_count</name>
        <rename>success_rows_count</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>failed_rows_count</name>
        <rename>failed_rows_count</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>384</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Insert DQ audit job log</name>
    <connection>dw-control</connection>
    <schema>control</schema>
    <table>etl_job_log</table>
    <commit>100</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>N</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>N</tablename_in_table>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field>
        <stream_name>job_name</stream_name>
        <column_name>job_name</column_name>
      </field>
      <field>
        <stream_name>source_name</stream_name>
        <column_name>source_name</column_name>
      </field>
      <field>
        <stream_name>started_at</stream_name>
        <column_name>started_at</column_name>
      </field>
      <field>
        <stream_name>finished_at</stream_name>
        <column_name>finished_at</column_name>
      </field>
      <field>
        <stream_name>status</stream_name>
        <column_name>status</column_name>
      </field>
      <field>
        <stream_name>total_rows_count</stream_name>
        <column_name>total_rows_count</column_name>
      </field>
      <field>
        <stream_name>success_rows_count</stream_name>
        <column_name>success_rows_count</column_name>
      </field>
      <field>
        <stream_name>failed_rows_count</stream_name>
        <column_name>failed_rows_count</column_name>
      </field>
    </fields>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>672</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Read DQ rule result summary</from>
      <to>Add DQ audit job fields</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Add DQ audit job fields</from>
      <to>Insert DQ audit job log</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads>
    <notepad>
      <note>DQ audit: one etl_job_log row per (source_name, rule_type) group.
status = DQ_PASSED when failed_count = 0 for that group, DQ_FAILED otherwise.
success_rows_count = passed + warning (both go to stg_*); failed_rows_count = rejected only.
started_at comes from ETL_STARTED_AT workflow variable set by 00_start_etl_source_to_staging.</note>
      <fontsize>-1</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>96</xloc>
      <yloc>224</yloc>
      <width>760</width>
      <height>-1</height>
    </notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
