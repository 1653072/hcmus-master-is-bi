  <transform>
    <type>TableInput</type>
    <name>Read Divvy raw DQ rule counts</name>
    <sql>WITH src AS (
  SELECT * FROM staging.raw_divvy_trips
),
dup AS (
  SELECT source_city_code, ride_id, COUNT(*) AS duplicate_count
  FROM src GROUP BY source_city_code, ride_id HAVING COUNT(*) > 1
),
rules AS (
  SELECT 'DIVVY_NULL_REQUIRED' AS rule_code, 'null' AS rule_type, 'reject' AS severity,
         COUNT(*) FILTER (WHERE NULLIF(BTRIM(ride_id),'') IS NULL
                           OR NULLIF(BTRIM(started_at),'') IS NULL
                           OR NULLIF(BTRIM(source_city_code),'') IS NULL) AS failed_count,
         0::BIGINT AS warning_count, COUNT(*) AS total_count
  FROM src
  UNION ALL
  SELECT 'DIVVY_DUPLICATE_RIDE', 'duplicate', 'reject',
         COALESCE(SUM(duplicate_count), 0), 0::BIGINT, (SELECT COUNT(*) FROM src)
  FROM dup
  UNION ALL
  SELECT 'DIVVY_DATATYPE_TIMESTAMP', 'datatype', 'reject',
         COUNT(*) FILTER (WHERE NULLIF(BTRIM(ride_id),'') IS NOT NULL
                           AND NULLIF(BTRIM(started_at),'') IS NOT NULL
                           AND started_at !~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'),
         0::BIGINT, COUNT(*)
  FROM src
  UNION ALL
  SELECT 'DIVVY_FORMAT_TRIP_MONTH', 'format', 'reject',
         COUNT(*) FILTER (WHERE trip_month IS NULL OR trip_month !~ '^[0-9]{6}$'),
         0::BIGINT, COUNT(*)
  FROM src
  UNION ALL
  SELECT 'DIVVY_WARN_STATION_ID', 'null', 'warning',
         0::BIGINT,
         COUNT(*) FILTER (WHERE NULLIF(BTRIM(ride_id),'') IS NOT NULL
                           AND NULLIF(BTRIM(started_at),'') IS NOT NULL
                           AND started_at ~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'
                           AND (trip_month IS NOT NULL AND trip_month ~ '^[0-9]{6}$')
                           AND (NULLIF(BTRIM(start_station_id),'') IS NULL
                                OR NULLIF(BTRIM(end_station_id),'') IS NULL)),
         COUNT(*)
  FROM src
)
SELECT 'divvy_trips' AS source_name,
       'bootstrap_202601_202605' AS load_run_id,
       rule_code, rule_type, severity,
       GREATEST(total_count - failed_count - warning_count, 0)::INTEGER AS passed_count,
       failed_count::INTEGER AS failed_count,
       warning_count::INTEGER AS warning_count
FROM rules</sql>
