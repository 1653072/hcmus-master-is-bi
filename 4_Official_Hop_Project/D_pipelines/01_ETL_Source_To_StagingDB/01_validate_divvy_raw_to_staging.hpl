  <transform>
    <type>TableInput</type>
    <name>Read Divvy raw DQ rule counts</name>
    <sql>WITH src AS (
    SELECT
        r.*,
        NULLIF(BTRIM(r.ride_id), '')          AS ride_id_norm,
        NULLIF(BTRIM(r.started_at), '')       AS started_at_norm,
        NULLIF(BTRIM(r.source_city_code), '') AS source_city_code_norm,
        NULLIF(BTRIM(r.start_station_id), '') AS start_station_id_norm,
        NULLIF(BTRIM(r.end_station_id), '')   AS end_station_id_norm
    FROM staging.raw_divvy_trips AS r
),

enriched AS (
    SELECT
        s.*,
        COUNT(*) OVER (
            PARTITION BY s.source_city_code, s.ride_id
        ) AS ride_key_count
    FROM src AS s
),

metrics AS (
    SELECT
        COUNT(*)::BIGINT AS total_count,

        COUNT(*) FILTER (
            WHERE ride_id_norm IS NULL
               OR started_at_norm IS NULL
               OR source_city_code_norm IS NULL
        )::BIGINT AS null_required_count,

        COUNT(*) FILTER (
            WHERE ride_key_count > 1
        )::BIGINT AS duplicate_ride_count,

        COUNT(*) FILTER (
            WHERE ride_id_norm IS NOT NULL
              AND started_at_norm IS NOT NULL
              AND started_at !~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'
        )::BIGINT AS bad_timestamp_count,

        COUNT(*) FILTER (
            WHERE trip_month IS NULL
               OR trip_month !~ '^[0-9]{6}$'
        )::BIGINT AS bad_trip_month_count,

        COUNT(*) FILTER (
            WHERE ride_id_norm IS NOT NULL
              AND started_at_norm IS NOT NULL
              AND started_at ~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'
              AND trip_month IS NOT NULL
              AND trip_month ~ '^[0-9]{6}$'
              AND start_station_id_norm IS NULL
              AND end_station_id_norm IS NULL
        )::BIGINT AS both_station_id_null_count,

        COUNT(*) FILTER (
            WHERE ride_id_norm IS NOT NULL
              AND started_at_norm IS NOT NULL
              AND started_at ~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'
              AND trip_month IS NOT NULL
              AND trip_month ~ '^[0-9]{6}$'
              AND (
                    (start_station_id_norm IS NULL AND end_station_id_norm IS NOT NULL)
                 OR (start_station_id_norm IS NOT NULL AND end_station_id_norm IS NULL)
              )
        )::BIGINT AS one_station_id_null_count
    FROM enriched
),

rules AS (
    SELECT
        rule_code,
        rule_type,
        severity,
        failed_count,
        warning_count,
        m.total_count
    FROM metrics AS m
    CROSS JOIN LATERAL (
        VALUES
            ('DIVVY_NULL_REQUIRED',      	  'null',      'reject',  m.null_required_count,         0::BIGINT),
            ('DIVVY_DUPLICATE_RIDE',          'duplicate', 'reject',  m.duplicate_ride_count,        0::BIGINT),
            ('DIVVY_DATATYPE_TIMESTAMP', 	  'datatype',  'reject',  m.bad_timestamp_count,         0::BIGINT),
            ('DIVVY_FORMAT_TRIP_MONTH',       'format',    'reject',  m.bad_trip_month_count,        0::BIGINT),
            ('DIVVY_REJECT_BOTH_STATION_ID',  'null',      'reject',  m.both_station_id_null_count,  0::BIGINT),
            ('DIVVY_WARN_STATION_ID',         'null',      'warning', 0::BIGINT,                     m.one_station_id_null_count)
    ) AS rule_def (
        rule_code,
        rule_type,
        severity,
        failed_count,
        warning_count
    )
)

SELECT
    'divvy_trips'             AS source_name,
    'bootstrap_202601_202605' AS load_run_id,
    rule_code,
    rule_type,
    severity,
    GREATEST(total_count - failed_count - warning_count, 0)::INTEGER AS passed_count,
    failed_count::INTEGER,
    warning_count::INTEGER
FROM rules;</sql>
