    <parameters/>
    <name>01_validate_divvy_raw_to_staging</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Flow 2 — DQ gate for Divvy: 3 parallel streams from raw_divvy_trips. Stream A: row-level reject/warning details to etl_dq_rule_result_details (both-null station reject; one-null warning). Stream B: aggregate counts to etl_dq_rule_result_analysis. Stream C: accepted rows (excluding both-null station) cast and upserted into stg_divvy_trips.</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/09 01:10:35.638</created_date>
    <modified_date>2026/07/09 01:10:35.638</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read Divvy reject+warning row details</name>
    <sql>WITH src AS (
    SELECT
        r.load_run_id,
        r.source_file,
        r.source_row_number,
        r.ride_id,
        r.started_at,
        r.trip_month,
        COALESCE(NULLIF(BTRIM(r.ride_id), ''), '(null)') AS business_key,
        NULLIF(BTRIM(r.ride_id), '')                     AS ride_id_norm,
        NULLIF(BTRIM(r.started_at), '')                  AS started_at_norm,
        NULLIF(BTRIM(r.source_city_code), '')            AS source_city_code_norm,
        NULLIF(BTRIM(r.start_station_id), '')            AS start_station_id_norm,
        NULLIF(BTRIM(r.end_station_id), '')              AS end_station_id_norm,
        jsonb_build_object(
            'ride_id',            r.ride_id,
            'rideable_type',      r.rideable_type,
            'started_at',         r.started_at,
            'ended_at',           r.ended_at,
            'start_station_name', r.start_station_name,
            'start_station_id',   r.start_station_id,
            'end_station_name',   r.end_station_name,
            'end_station_id',     r.end_station_id,
            'start_lat',          r.start_lat,
            'start_lng',          r.start_lng,
            'end_lat',            r.end_lat,
            'end_lng',            r.end_lng,
            'member_casual',      r.member_casual,
            'source_city_code',   r.source_city_code,
            'trip_month',         r.trip_month
        ) AS raw_payload
    FROM staging.raw_divvy_trips AS r
),

dup_keys AS (
    SELECT
        source_city_code,
        ride_id
    FROM staging.raw_divvy_trips
    GROUP BY
        source_city_code,
        ride_id
    HAVING COUNT(*) > 1
)

-- Rule 1: required fields
SELECT
    load_run_id,
    'divvy_trips'     AS source_name,
    'raw_divvy_trips' AS source_table,
    source_file,
    source_row_number,
    business_key,
    'DIVVY_NULL_REQUIRED' AS rule_code,
    'null'                AS rule_type,
    'reject'              AS dq_verdict,
    'Required field(s) null or blank: ride_id/started_at/source_city_code' AS reason,
    raw_payload
FROM src
WHERE ride_id_norm IS NULL
   OR started_at_norm IS NULL
   OR source_city_code_norm IS NULL

UNION ALL

-- Rule 2: duplicate (source_city_code, ride_id)
SELECT
    s.load_run_id,
    'divvy_trips',
    'raw_divvy_trips',
    s.source_file,
    s.source_row_number,
    s.business_key,
    'DIVVY_DUPLICATE_RIDE',
    'duplicate',
    'reject',
    'Duplicate (source_city_code, ride_id) in this load run',
    s.raw_payload
FROM src AS s
INNER JOIN dup_keys AS d
    ON  s.source_city_code_norm = NULLIF(BTRIM(d.source_city_code), '')
    AND s.ride_id_norm          = NULLIF(BTRIM(d.ride_id), '')

UNION ALL

-- Rule 3: started_at timestamp format
SELECT
    load_run_id,
    'divvy_trips',
    'raw_divvy_trips',
    source_file,
    source_row_number,
    business_key,
    'DIVVY_DATATYPE_TIMESTAMP',
    'datatype',
    'reject',
    'started_at not parseable as yyyy-MM-dd HH:mm:ss',
    raw_payload
FROM src
WHERE ride_id_norm IS NOT NULL
  AND started_at_norm IS NOT NULL
  AND started_at !~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'

UNION ALL

-- Rule 4: trip_month YYYYMM
SELECT
    load_run_id,
    'divvy_trips',
    'raw_divvy_trips',
    source_file,
    source_row_number,
    business_key,
    'DIVVY_FORMAT_TRIP_MONTH',
    'format',
    'reject',
    'trip_month null or not YYYYMM',
    raw_payload
FROM src
WHERE ride_id_norm IS NOT NULL
  AND (trip_month IS NULL OR trip_month !~ '^[0-9]{6}$')

UNION ALL

-- Rule 5a: both station ids null (reject)
SELECT
    load_run_id,
    'divvy_trips',
    'raw_divvy_trips',
    source_file,
    source_row_number,
    business_key,
    'DIVVY_REJECT_BOTH_STATION_ID',
    'null',
    'reject',
    'Both start_station_id and end_station_id are null',
    raw_payload
FROM src
WHERE ride_id_norm IS NOT NULL
  AND started_at_norm IS NOT NULL
  AND started_at ~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'
  AND trip_month IS NOT NULL
  AND trip_month ~ '^[0-9]{6}$'
  AND start_station_id_norm IS NULL
  AND end_station_id_norm IS NULL

UNION ALL

-- Rule 5b: exactly one station id null (warning)
SELECT
    load_run_id,
    'divvy_trips',
    'raw_divvy_trips',
    source_file,
    source_row_number,
    business_key,
    'DIVVY_WARN_STATION_ID',
    'null',
    'warning',
    'Exactly one of start_station_id / end_station_id is null',
    raw_payload
FROM src
WHERE ride_id_norm IS NOT NULL
  AND started_at_norm IS NOT NULL
  AND started_at ~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'
  AND trip_month IS NOT NULL
  AND trip_month ~ '^[0-9]{6}$'
  AND (
        (start_station_id_norm IS NULL AND end_station_id_norm IS NOT NULL)
     OR (start_station_id_norm IS NOT NULL AND end_station_id_norm IS NULL)
      );</sql>
