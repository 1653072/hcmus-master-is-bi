  <transform>
    <type>ScriptValueMod</type>
    <name>Cast Divvy clean rows</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>function blankToNull(v) { if (v == null) return null; var s = String(v).trim(); return s.length == 0 ? null : s; }
function toTimestamp(v) {
  var s = blankToNull(v); if (s == null) return null;
  var p = s.split(".");
  var fmt = new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss");
  return new Packages.java.sql.Timestamp(fmt.parse(p[0]).getTime());
}
function toNumber(v) { var s = blankToNull(v); return s == null ? null : java.lang.Double.valueOf(s); }
started_at = toTimestamp(started_at);
ended_at = toTimestamp(ended_at);
start_lat = toNumber(start_lat);
start_lng = toNumber(start_lng);
end_lat = toNumber(end_lat);
end_lng = toNumber(end_lng);
start_station_name = blankToNull(start_station_name);
start_station_id = blankToNull(start_station_id);
end_station_name = blankToNull(end_station_name);
end_station_id = blankToNull(end_station_id);
member_casual = blankToNull(member_casual);
var loaded_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());</jsScript_script>
      </jsScript>
    </jsScripts>
