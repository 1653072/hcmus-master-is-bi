  <transform>
    <type>InsertUpdate</type>
    <name>Upsert staging.stg_divvy_trips</name>
    <lookup>
      <key>
        <name>source_city_code</name>
        <field>source_city_code</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>ride_id</name>
        <field>ride_id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>ride_id</name>
        <rename>ride_id</rename>
        <update>Y</update>
