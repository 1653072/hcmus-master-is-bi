    <parameters/>
    <name>01_validate_divvy_raw_to_staging</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Flow 2 — DQ gate for Divvy: 3 parallel streams from raw_divvy_trips. Stream A: row-level reject/warning details to etl_dq_rule_result_details. Stream B: aggregate counts to etl_dq_rule_result_analysis. Stream C: clean rows cast and upserted into stg_divvy_trips.</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/09 01:10:35.638</created_date>
    <modified_date>2026/07/09 01:10:35.638</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read Divvy reject+warning row details</name>
    <sql>SELECT load_run_id, 'divvy_trips' AS source_name, 'raw_divvy_trips' AS source_table,
       source_file, source_row_number,
       COALESCE(NULLIF(BTRIM(ride_id),''), '(null)') AS business_key,
       'DIVVY_NULL_REQUIRED' AS rule_code, 'null' AS rule_type, 'reject' AS dq_verdict,
       'Required field(s) null or blank: ride_id/started_at/source_city_code' AS reason,
       NULL::JSONB AS raw_payload
FROM staging.raw_divvy_trips
WHERE NULLIF(BTRIM(ride_id),'') IS NULL
   OR NULLIF(BTRIM(started_at),'') IS NULL
   OR NULLIF(BTRIM(source_city_code),'') IS NULL

UNION ALL

SELECT r.load_run_id, 'divvy_trips', 'raw_divvy_trips',
       r.source_file, r.source_row_number,
       COALESCE(NULLIF(BTRIM(r.ride_id),''), '(null)'),
       'DIVVY_DUPLICATE_RIDE', 'duplicate', 'reject',
       'Duplicate (source_city_code, ride_id) in this load run', NULL::JSONB
FROM staging.raw_divvy_trips r
JOIN (SELECT source_city_code, ride_id FROM staging.raw_divvy_trips
      GROUP BY source_city_code, ride_id HAVING COUNT(*) > 1) d
  ON r.source_city_code = d.source_city_code AND r.ride_id = d.ride_id

UNION ALL

SELECT load_run_id, 'divvy_trips', 'raw_divvy_trips',
       source_file, source_row_number,
       COALESCE(NULLIF(BTRIM(ride_id),''), '(null)'),
       'DIVVY_DATATYPE_TIMESTAMP', 'datatype', 'reject',
       'started_at not parseable as yyyy-MM-dd HH:mm:ss', NULL::JSONB
FROM staging.raw_divvy_trips
WHERE NULLIF(BTRIM(ride_id),'') IS NOT NULL
  AND NULLIF(BTRIM(started_at),'') IS NOT NULL
  AND started_at !~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'

UNION ALL

SELECT load_run_id, 'divvy_trips', 'raw_divvy_trips',
       source_file, source_row_number,
       COALESCE(NULLIF(BTRIM(ride_id),''), '(null)'),
       'DIVVY_FORMAT_TRIP_MONTH', 'format', 'reject',
       'trip_month null or not YYYYMM', NULL::JSONB
FROM staging.raw_divvy_trips
WHERE NULLIF(BTRIM(ride_id),'') IS NOT NULL
  AND (trip_month IS NULL OR trip_month !~ '^[0-9]{6}$')

UNION ALL

SELECT r.load_run_id, 'divvy_trips', 'raw_divvy_trips',
       r.source_file, r.source_row_number,
       COALESCE(NULLIF(BTRIM(r.ride_id),''), '(null)'),
       'DIVVY_WARN_STATION_ID', 'null', 'warning',
       'Missing start_station_id or end_station_id', NULL::JSONB
FROM staging.raw_divvy_trips r
WHERE NULLIF(BTRIM(r.ride_id),'') IS NOT NULL
  AND NULLIF(BTRIM(r.started_at),'') IS NOT NULL
  AND r.started_at ~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'
  AND (r.trip_month IS NOT NULL AND r.trip_month ~ '^[0-9]{6}$')
  AND (NULLIF(BTRIM(r.start_station_id),'') IS NULL
       OR NULLIF(BTRIM(r.end_station_id),'') IS NULL)</sql>
