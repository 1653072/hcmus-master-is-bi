  <transform>
    <type>TableInput</type>
    <name>Read Divvy clean rows</name>
    <sql>SELECT DISTINCT ON (source_city_code, ride_id)
       load_run_id, source_file,
       ride_id, rideable_type, started_at, ended_at,
       start_station_name, start_station_id, end_station_name, end_station_id,
       start_lat, start_lng, end_lat, end_lng,
       member_casual, source_city_code, trip_month
FROM staging.raw_divvy_trips
WHERE NULLIF(BTRIM(ride_id),'') IS NOT NULL
  AND NULLIF(BTRIM(started_at),'') IS NOT NULL
  AND NULLIF(BTRIM(source_city_code),'') IS NOT NULL
  AND started_at ~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'
  AND (trip_month IS NOT NULL AND trip_month ~ '^[0-9]{6}$')
ORDER BY source_city_code, ride_id</sql>
    <limit>0</limit>
