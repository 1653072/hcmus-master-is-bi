<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>01_load_divvy_trips_to_staging</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Flow 1: read Divvy CSV as all-TEXT, no type casting, truncate-and-load into staging.raw_divvy_trips.</description>
  </info>
  <transform>
    <type>TextFileInput2</type>
    <name>Read Divvy trip CSV files</name>
    <file_type>CSV</file_type>
    <compression>None</compression>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <nr_headerlines>1</nr_headerlines>
    <noempty>Y</noempty>
    <include>Y</include>
    <include_field>source_file</include_field>
    <format>DOS</format>
    <encoding>UTF-8</encoding>
    <limit>0</limit>
    <date_format_lenient>Y</date_format_lenient>
    <date_format_locale>en_US</date_format_locale>
    <files>
      <file>
        <name>${DIVVY_TRIPS_DIR}/</name>
        <filemask>[0-9]{6}.*\.csv</filemask>
        <exclude_filemask/>
        <file_required>Y</file_required>
        <include_subfolders>Y</include_subfolders>
      </file>
    </files>
    <fields>
      <field><name>ride_id</name><type>String</type><position>-1</position><length>64</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>rideable_type</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>started_at</name><type>String</type><position>-1</position><length>40</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>ended_at</name><type>String</type><position>-1</position><length>40</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>start_station_name</name><type>String</type><position>-1</position><length>500</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>start_station_id</name><type>String</type><position>-1</position><length>100</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>end_station_name</name><type>String</type><position>-1</position><length>500</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>end_station_id</name><type>String</type><position>-1</position><length>100</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>start_lat</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>start_lng</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>end_lat</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>end_lng</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>member_casual</name><type>String</type><position>-1</position><length>20</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
    </fields>
    <GUI><xloc>96</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>Prepare Divvy raw fields</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var source_city_code = "CHI";
var load_run_id = "bootstrap_202601_202605";
var raw_loaded_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());
function blankToNull(v) { if (v == null) return null; var s = String(v).trim(); return s.length == 0 ? null : s; }
ride_id = blankToNull(ride_id);
rideable_type = blankToNull(rideable_type);
started_at = blankToNull(started_at);
ended_at = blankToNull(ended_at);
start_station_name = blankToNull(start_station_name);
start_station_id = blankToNull(start_station_id);
end_station_name = blankToNull(end_station_name);
end_station_id = blankToNull(end_station_id);
start_lat = blankToNull(start_lat);
start_lng = blankToNull(start_lng);
end_lat = blankToNull(end_lat);
end_lng = blankToNull(end_lng);
member_casual = blankToNull(member_casual);
var m = String(source_file).match(/(20[0-9]{4})/);
var trip_month = m == null ? null : m[1];</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>source_city_code</name><rename>source_city_code</rename><type>String</type><length>10</length><precision>-1</precision><replace>N</replace></field>
      <field><name>load_run_id</name><rename>load_run_id</rename><type>String</type><length>80</length><precision>-1</precision><replace>N</replace></field>
      <field><name>trip_month</name><rename>trip_month</rename><type>String</type><length>6</length><precision>-1</precision><replace>N</replace></field>
      <field><name>raw_loaded_at</name><rename>raw_loaded_at</rename><type>Timestamp</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>ride_id</name><rename>ride_id</rename><type>String</type><length>64</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>rideable_type</name><rename>rideable_type</rename><type>String</type><length>50</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>started_at</name><rename>started_at</rename><type>String</type><length>40</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>ended_at</name><rename>ended_at</rename><type>String</type><length>40</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>start_station_name</name><rename>start_station_name</rename><type>String</type><length>500</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>start_station_id</name><rename>start_station_id</rename><type>String</type><length>100</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>end_station_name</name><rename>end_station_name</rename><type>String</type><length>500</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>end_station_id</name><rename>end_station_id</rename><type>String</type><length>100</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>start_lat</name><rename>start_lat</rename><type>String</type><length>50</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>start_lng</name><rename>start_lng</rename><type>String</type><length>50</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>end_lat</name><rename>end_lat</rename><type>String</type><length>50</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>end_lng</name><rename>end_lng</rename><type>String</type><length>50</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>member_casual</name><rename>member_casual</rename><type>String</type><length>20</length><precision>-1</precision><replace>Y</replace></field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <GUI><xloc>352</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Load to raw_divvy_trips</name>
    <connection>dw-staging</connection>
    <schema>staging</schema>
    <table>raw_divvy_trips</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <fields>
      <field><stream_name>load_run_id</stream_name><column_name>load_run_id</column_name></field>
      <field><stream_name>source_file</stream_name><column_name>source_file</column_name></field>
      <field><stream_name>ride_id</stream_name><column_name>ride_id</column_name></field>
      <field><stream_name>rideable_type</stream_name><column_name>rideable_type</column_name></field>
      <field><stream_name>started_at</stream_name><column_name>started_at</column_name></field>
      <field><stream_name>ended_at</stream_name><column_name>ended_at</column_name></field>
      <field><stream_name>start_station_name</stream_name><column_name>start_station_name</column_name></field>
      <field><stream_name>start_station_id</stream_name><column_name>start_station_id</column_name></field>
      <field><stream_name>end_station_name</stream_name><column_name>end_station_name</column_name></field>
      <field><stream_name>end_station_id</stream_name><column_name>end_station_id</column_name></field>
      <field><stream_name>start_lat</stream_name><column_name>start_lat</column_name></field>
      <field><stream_name>start_lng</stream_name><column_name>start_lng</column_name></field>
      <field><stream_name>end_lat</stream_name><column_name>end_lat</column_name></field>
      <field><stream_name>end_lng</stream_name><column_name>end_lng</column_name></field>
      <field><stream_name>member_casual</stream_name><column_name>member_casual</column_name></field>
      <field><stream_name>source_city_code</stream_name><column_name>source_city_code</column_name></field>
      <field><stream_name>trip_month</stream_name><column_name>trip_month</column_name></field>
      <field><stream_name>raw_loaded_at</stream_name><column_name>raw_loaded_at</column_name></field>
    </fields>
    <GUI><xloc>624</xloc><yloc>80</yloc></GUI>
  </transform>
  <order>
    <hop><from>Read Divvy trip CSV files</from><to>Prepare Divvy raw fields</to><enabled>Y</enabled></hop>
    <hop><from>Prepare Divvy raw fields</from><to>Load to raw_divvy_trips</to><enabled>Y</enabled></hop>
  </order>
  <notepads>
    <notepad><note>Flow 1 — no type casting. DQ validation and transformation to stg_divvy_trips happen in 01_validate_divvy_raw_to_staging.hpl.</note><xloc>96</xloc><yloc>200</yloc><width>760</width><heigth>60</heigth></notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
