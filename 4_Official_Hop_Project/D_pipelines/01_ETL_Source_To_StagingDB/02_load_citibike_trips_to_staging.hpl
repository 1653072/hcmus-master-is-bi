  <transform>
    <type>ScriptValueMod</type>
    <name>Prepare Citi Bike raw fields</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var source_city_code = "NYC";
var load_run_id = "bootstrap_202601_202605";
var raw_loaded_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());
function blankToNull(v) { if (v == null) return null; var s = String(v).trim(); return s.length == 0 ? null : s; }
ride_id = blankToNull(ride_id); rideable_type = blankToNull(rideable_type);
started_at = blankToNull(started_at); ended_at = blankToNull(ended_at);
start_station_name = blankToNull(start_station_name); start_station_id = blankToNull(start_station_id);
end_station_name = blankToNull(end_station_name); end_station_id = blankToNull(end_station_id);
start_lat = blankToNull(start_lat); start_lng = blankToNull(start_lng);
end_lat = blankToNull(end_lat); end_lng = blankToNull(end_lng);
member_casual = blankToNull(member_casual);
var trip_month = null;
var ts = blankToNull(started_at);
if (ts != null) {
  var m = ts.match(/^(20[0-9]{2})-(0[1-9]|1[0-2])/);
  if (m != null) trip_month = m[1] + m[2];
}
if (typeof _last_file === 'undefined' || _last_file !== String(filename)) {
  _last_file = String(filename);
  _row_counter = 1;
} else {
  _row_counter++;
}
// The current source_row_number didn't include the header of CSV files (e.g., 1). If it includes the header, then it'll be 2.
var source_row_number = _row_counter;</jsScript_script>
      </jsScript>
    </jsScripts>
