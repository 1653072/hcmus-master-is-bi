<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>00_start_etl_source_to_staging</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Captures ETL start time and sets workflow variable ETL_STARTED_AT for use by downstream audit pipelines (05_audit_dq_rule_results, 05_audit_staging_load_counts).</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/09 01:05:30.673</created_date>
    <modified_date>2026/07/09 01:05:30.673</modified_date>
  </info>
  <transform>
    <type>RowGenerator</type>
    <name>Generate single start row</name>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <row_time_field>now</row_time_field>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <limit>1</limit>
    <fields/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>Compute ETL_STARTED_AT</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var etl_started_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>etl_started_at</name>
        <rename>etl_started_at</rename>
        <type>Timestamp</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>352</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Set ETL_STARTED_AT</name>
    <fields>
      <field>
        <field_name>etl_started_at</field_name>
        <variable_name>ETL_STARTED_AT</variable_name>
        <variable_type>JVM</variable_type>
        <default_value>2026-01-01 00:00:00.0</default_value>
      </field>
    </fields>
    <use_formatting>N</use_formatting>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>608</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Generate single start row</from>
      <to>Compute ETL_STARTED_AT</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Compute ETL_STARTED_AT</from>
      <to>Set ETL_STARTED_AT</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads>
    <notepad>
      <note>Sets ETL_STARTED_AT as a workflow-level variable.
Downstream pipelines read it via getVariable("ETL_STARTED_AT", ...) in ScriptValueMod
and write it as started_at in control.etl_job_log.</note>
      <fontsize>-1</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>96</xloc>
      <yloc>224</yloc>
      <width>760</width>
      <height>-1</height>
    </notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
