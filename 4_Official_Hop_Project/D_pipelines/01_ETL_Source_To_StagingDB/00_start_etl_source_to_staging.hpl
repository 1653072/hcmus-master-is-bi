<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>00_start_etl_source_to_staging</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Captures ETL start time and reads LSET/CET watermarks from control.etl_extraction_control.
Sets JVM variables: ETL_STARTED_AT, LSET_DIVVY_TRIPS, CET_DIVVY_TRIPS, LSET_CITIBIKE_TRIPS, CET_CITIBIKE_TRIPS,
LSET_NOAA_LCD, CET_NOAA_LCD, LSET_GBFS_STATION, CET_GBFS_STATION.
All variables are available to downstream pipelines via getVariable() in ScriptValueMod.</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/09 01:05:30.673</created_date>
    <modified_date>2026/07/09 01:05:30.673</modified_date>
  </info>
  <transform>
    <type>RowGenerator</type>
    <name>Generate single start row</name>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <row_time_field>now</row_time_field>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <limit>1</limit>
    <fields/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>176</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>Compute ETL_STARTED_AT</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var _fmt = new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss.SSS");
var etl_started_at = _fmt.format(new java.util.Date());</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>etl_started_at</name>
        <rename>etl_started_at</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>432</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Set ETL_STARTED_AT</name>
    <fields>
      <field>
        <field_name>etl_started_at</field_name>
        <variable_name>ETL_STARTED_AT</variable_name>
        <variable_type>JVM</variable_type>
        <default_value>2026-01-01 00:00:00.000</default_value>
      </field>
    </fields>
    <use_formatting>N</use_formatting>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>688</xloc>
      <yloc>80</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableInput</type>
    <name>Read divvy_trips watermarks</name>
    <sql>SELECT
  TO_CHAR(COALESCE(lset, TIMESTAMP '2026-01-01 00:00:00'), 'YYYY-MM-DD HH24:MI:SS.MS') AS lset_value,
  TO_CHAR(COALESCE(cet,  TIMESTAMP '2026-01-01 00:00:00'), 'YYYY-MM-DD HH24:MI:SS.MS') AS cet_value
FROM control.etl_extraction_control
WHERE source_name = 'divvy_trips' AND table_name = 'stg_divvy_trips'</sql>
    <limit>1</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>dw-control</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>176</xloc>
      <yloc>176</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
