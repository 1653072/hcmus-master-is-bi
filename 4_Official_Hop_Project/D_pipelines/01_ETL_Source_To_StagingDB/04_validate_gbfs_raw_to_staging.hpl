<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>04_validate_gbfs_raw_to_staging</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Visible DQ pipeline for staging.raw_gbfs_station: required fields, duplicate station, capacity datatype, coordinate format, and accepted staging evidence.</description>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read GBFS raw DQ rule counts</name>
    <connection>dw-staging</connection>
    <sql><![CDATA[WITH src AS (
  SELECT *
  FROM staging.raw_gbfs_station
),
dup AS (
  SELECT source_city_code, short_name, COUNT(*) AS duplicate_count
  FROM src
  GROUP BY source_city_code, short_name
  HAVING COUNT(*) > 1
),
rules AS (
  SELECT 'GBFS_NULL_REQUIRED' AS rule_code, 'null' AS rule_type, 'reject' AS severity,
         COUNT(*) FILTER (WHERE NULLIF(BTRIM(source_city_code), '') IS NULL
                           OR NULLIF(BTRIM(short_name), '') IS NULL) AS failed_count,
         0::BIGINT AS warning_count,
         COUNT(*) AS total_count
  FROM src
  UNION ALL
  SELECT 'GBFS_DUPLICATE_STATION', 'duplicate', 'reject',
         COALESCE(SUM(duplicate_count), 0), 0::BIGINT, (SELECT COUNT(*) FROM src)
  FROM dup
  UNION ALL
  SELECT 'GBFS_DATATYPE_CAPACITY', 'datatype', 'reject',
         COUNT(*) FILTER (WHERE capacity IS NOT NULL AND capacity !~ '^[0-9]+$'),
         0::BIGINT, COUNT(*)
  FROM src
  UNION ALL
  SELECT 'GBFS_FORMAT_COORDINATE', 'format', 'reject',
         COUNT(*) FILTER (WHERE latitude IS NULL OR longitude IS NULL
                           OR latitude !~ '^-?[0-9]+(\.[0-9]+)?$'
                           OR longitude !~ '^-?[0-9]+(\.[0-9]+)?$'
                           OR latitude::NUMERIC NOT BETWEEN -90 AND 90
                           OR longitude::NUMERIC NOT BETWEEN -180 AND 180),
         0::BIGINT, COUNT(*)
  FROM src
)
SELECT 'gbfs_station' AS source_name,
       'bootstrap_202601_202605' AS load_run_id,
       'staging.raw_gbfs_station' AS source_table,
       'staging.dq_reject_row' AS reject_target,
       'staging.stg_gbfs_station' AS accepted_target,
       rule_code,
       rule_type,
       severity,
       GREATEST(total_count - failed_count - warning_count, 0)::INTEGER AS passed_count,
       failed_count::INTEGER AS failed_count,
       warning_count::INTEGER AS warning_count
FROM rules]]></sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <GUI><xloc>96</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Write GBFS DQ rule stream evidence</name>
    <connection>dw-control</connection>
    <schema>control</schema>
    <table>etl_dq_rule_result</table>
    <commit>100</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <fields>
      <field><stream_name>load_run_id</stream_name><column_name>load_run_id</column_name></field>
      <field><stream_name>source_name</stream_name><column_name>source_name</column_name></field>
      <field><stream_name>rule_code</stream_name><column_name>rule_code</column_name></field>
      <field><stream_name>rule_type</stream_name><column_name>rule_type</column_name></field>
      <field><stream_name>severity</stream_name><column_name>severity</column_name></field>
      <field><stream_name>passed_count</stream_name><column_name>passed_count</column_name></field>
      <field><stream_name>failed_count</stream_name><column_name>failed_count</column_name></field>
      <field><stream_name>warning_count</stream_name><column_name>warning_count</column_name></field>
    </fields>
    <GUI><xloc>448</xloc><yloc>96</yloc></GUI>
  </transform>
  <order><hop><from>Read GBFS raw DQ rule counts</from><to>Write GBFS DQ rule stream evidence</to><enabled>Y</enabled></hop></order>
  <notepads>
    <notepad><note>Hard reject target: staging.dq_reject_row. Accepted station rows are represented by staging.stg_gbfs_station.</note><xloc>96</xloc><yloc>224</yloc><width>760</width><heigth>80</heigth></notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
