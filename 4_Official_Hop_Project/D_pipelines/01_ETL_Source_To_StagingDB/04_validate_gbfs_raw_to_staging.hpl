  <transform>
    <type>TableInput</type>
    <name>Read GBFS clean rows</name>
    <sql>SELECT DISTINCT ON (source_city_code, COALESCE(NULLIF(BTRIM(short_name),''), NULLIF(BTRIM(gbfs_station_id),'')))
       load_run_id, source_file,
       gbfs_station_id, station_name, short_name,
       longitude, latitude, capacity,
       station_type, region_id, source_city_code
FROM staging.raw_gbfs_station
WHERE NULLIF(BTRIM(source_city_code),'') IS NOT NULL
  AND (NULLIF(BTRIM(short_name),'') IS NOT NULL OR NULLIF(BTRIM(gbfs_station_id),'') IS NOT NULL)
  AND (capacity IS NULL OR NULLIF(BTRIM(capacity),'') IS NULL OR BTRIM(capacity) ~ '^[0-9]+$')
  AND NULLIF(BTRIM(latitude),'') IS NOT NULL
  AND NULLIF(BTRIM(longitude),'') IS NOT NULL
  AND BTRIM(latitude) ~ '^-?[0-9]+(\.[0-9]+)?$'
  AND BTRIM(longitude) ~ '^-?[0-9]+(\.[0-9]+)?$'
  AND CAST(BTRIM(latitude) AS NUMERIC) BETWEEN -90 AND 90
  AND CAST(BTRIM(longitude) AS NUMERIC) BETWEEN -180 AND 180
ORDER BY source_city_code, COALESCE(NULLIF(BTRIM(short_name),''), NULLIF(BTRIM(gbfs_station_id),''))</sql>
    <limit>0</limit>
