    <parameters/>
    <name>04_validate_gbfs_raw_to_staging</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Flow 2 — DQ gate for GBFS: 3 parallel streams from raw_gbfs_station. Stream A: row-level reject details to etl_dq_rule_result_details. Stream B: aggregate counts to etl_dq_rule_result_analysis. Stream C: clean rows cast and upserted into stg_gbfs_station.</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/09 22:27:54.525</created_date>
    <modified_date>2026/07/09 22:27:54.525</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read GBFS reject row details</name>
    <sql>WITH src AS (
    SELECT
        r.load_run_id,
        r.source_file,
        r.source_row_number,
        r.gbfs_station_id,
        r.station_name,
        r.short_name,
        r.longitude,
        r.latitude,
        r.capacity,
        r.station_type,
        r.region_id,
        r.source_city_code,
        COALESCE(
            NULLIF(BTRIM(r.short_name), ''),
            NULLIF(BTRIM(r.gbfs_station_id), ''),
            '(null)'
        ) AS business_key,
        NULLIF(BTRIM(r.source_city_code), '')  AS source_city_code_norm,
        NULLIF(BTRIM(r.short_name), '')        AS short_name_norm,
        NULLIF(BTRIM(r.gbfs_station_id), '')   AS gbfs_station_id_norm,
        NULLIF(BTRIM(r.capacity), '')          AS capacity_norm,
        NULLIF(BTRIM(r.latitude), '')         AS latitude_norm,
        NULLIF(BTRIM(r.longitude), '')        AS longitude_norm,
        jsonb_build_object(
            'gbfs_station_id',  r.gbfs_station_id,
            'station_name',   r.station_name,
            'short_name',     r.short_name,
            'longitude',      r.longitude,
            'latitude',       r.latitude,
            'capacity',       r.capacity,
            'station_type',   r.station_type,
            'region_id',      r.region_id,
            'source_city_code', r.source_city_code
        ) AS raw_payload
    FROM staging.raw_gbfs_station AS r
),

dup_keys AS (
    SELECT
        source_city_code,
        NULLIF(BTRIM(short_name), '') AS short_name_norm
    FROM staging.raw_gbfs_station
    WHERE NULLIF(BTRIM(short_name), '') IS NOT NULL
    GROUP BY
        source_city_code,
        NULLIF(BTRIM(short_name), '')
    HAVING COUNT(*) > 1
)

-- Rule 1: required fields
SELECT
    load_run_id,
    'gbfs_station'     AS source_name,
    'raw_gbfs_station' AS source_table,
    source_file,
    source_row_number,
    business_key,
    'GBFS_NULL_REQUIRED' AS rule_code,
    'null'               AS rule_type,
    'reject'             AS dq_verdict,
    'Required field(s) null or blank: source_city_code and short_name/gbfs_station_id' AS reason,
    raw_payload
FROM src
WHERE source_city_code_norm IS NULL
   OR (short_name_norm IS NULL AND gbfs_station_id_norm IS NULL)

UNION ALL

-- Rule 2: duplicate (source_city_code, short_name)
SELECT
    s.load_run_id,
    'gbfs_station',
    'raw_gbfs_station',
    s.source_file,
    s.source_row_number,
    s.business_key,
    'GBFS_DUPLICATE_STATION',
    'duplicate',
    'reject',
    'Duplicate (source_city_code, short_name) in this load run',
    s.raw_payload
FROM src AS s
INNER JOIN dup_keys AS d
    ON  s.source_city_code = d.source_city_code
    AND s.short_name_norm   = d.short_name_norm

UNION ALL

-- Rule 3: capacity must be integer when present
SELECT
    load_run_id,
    'gbfs_station',
    'raw_gbfs_station',
    source_file,
    source_row_number,
    business_key,
    'GBFS_DATATYPE_CAPACITY',
    'datatype',
    'reject',
    'capacity contains non-integer text',
    raw_payload
FROM src
WHERE source_city_code_norm IS NOT NULL
  AND (short_name_norm IS NOT NULL OR gbfs_station_id_norm IS NOT NULL)
  AND capacity IS NOT NULL
  AND capacity_norm IS NOT NULL
  AND BTRIM(capacity) !~ '^[0-9]+$'

UNION ALL

-- Rule 4: latitude/longitude format and range
SELECT
    load_run_id,
    'gbfs_station',
    'raw_gbfs_station',
    source_file,
    source_row_number,
    business_key,
    'GBFS_FORMAT_COORDINATE',
    'format',
    'reject',
    'latitude or longitude missing, non-numeric, or out of coordinate range',
    raw_payload
FROM src
WHERE source_city_code_norm IS NOT NULL
  AND (short_name_norm IS NOT NULL OR gbfs_station_id_norm IS NOT NULL)
  AND (
        capacity IS NULL
     OR capacity_norm IS NULL
     OR BTRIM(capacity) ~ '^[0-9]+$'
      )
  AND (
        latitude_norm IS NULL
     OR longitude_norm IS NULL
     OR BTRIM(latitude) !~ '^-?[0-9]+(\.[0-9]+)?$'
     OR BTRIM(longitude) !~ '^-?[0-9]+(\.[0-9]+)?$'
     OR CASE
            WHEN BTRIM(latitude) ~ '^-?[0-9]+(\.[0-9]+)?$'
            THEN CAST(BTRIM(latitude) AS NUMERIC) NOT BETWEEN -90 AND 90
            ELSE TRUE
        END
     OR CASE
            WHEN BTRIM(longitude) ~ '^-?[0-9]+(\.[0-9]+)?$'
            THEN CAST(BTRIM(longitude) AS NUMERIC) NOT BETWEEN -180 AND 180
            ELSE TRUE
        END
      );</sql>
