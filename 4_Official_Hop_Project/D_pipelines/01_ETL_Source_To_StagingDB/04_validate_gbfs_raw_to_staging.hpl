  <transform>
    <type>TableInput</type>
    <name>Read GBFS raw DQ rule counts</name>
    <sql>WITH src AS (
    SELECT
        r.*,
        NULLIF(BTRIM(r.source_city_code), '') AS source_city_code_norm,
        NULLIF(BTRIM(r.short_name), '')       AS short_name_norm,
        NULLIF(BTRIM(r.gbfs_station_id), '')  AS gbfs_station_id_norm,
        NULLIF(BTRIM(r.capacity), '')         AS capacity_norm,
        NULLIF(BTRIM(r.latitude), '')         AS latitude_norm,
        NULLIF(BTRIM(r.longitude), '')        AS longitude_norm
    FROM staging.raw_gbfs_station AS r
),

enriched AS (
    SELECT
        s.*,
        CASE
            WHEN s.short_name_norm IS NOT NULL
            THEN COUNT(*) OVER (
                PARTITION BY s.source_city_code, s.short_name_norm
            )
        END AS short_name_key_count
    FROM src AS s
),

metrics AS (
    SELECT
        COUNT(*)::BIGINT AS total_count,

        COUNT(*) FILTER (
            WHERE source_city_code_norm IS NULL
               OR (short_name_norm IS NULL AND gbfs_station_id_norm IS NULL)
        )::BIGINT AS null_required_count,

        COUNT(*) FILTER (
            WHERE short_name_norm IS NOT NULL
              AND short_name_key_count > 1
        )::BIGINT AS duplicate_station_count,

        COUNT(*) FILTER (
            WHERE capacity IS NOT NULL
              AND capacity_norm IS NOT NULL
              AND BTRIM(capacity) !~ '^[0-9]+$'
        )::BIGINT AS bad_capacity_count,

        COUNT(*) FILTER (
            WHERE latitude_norm IS NULL
               OR longitude_norm IS NULL
               OR BTRIM(latitude) !~ '^-?[0-9]+(\.[0-9]+)?$'
               OR BTRIM(longitude) !~ '^-?[0-9]+(\.[0-9]+)?$'
               OR CASE
                      WHEN BTRIM(latitude) ~ '^-?[0-9]+(\.[0-9]+)?$'
                      THEN CAST(BTRIM(latitude) AS NUMERIC) NOT BETWEEN -90 AND 90
                      ELSE TRUE
                  END
               OR CASE
                      WHEN BTRIM(longitude) ~ '^-?[0-9]+(\.[0-9]+)?$'
                      THEN CAST(BTRIM(longitude) AS NUMERIC) NOT BETWEEN -180 AND 180
                      ELSE TRUE
                  END
        )::BIGINT AS bad_coordinate_count
    FROM enriched
),

rules AS (
    SELECT
        rule_code,
        rule_type,
        severity,
        failed_count,
        warning_count,
        m.total_count
    FROM metrics AS m
    CROSS JOIN LATERAL (
        VALUES
            ('GBFS_NULL_REQUIRED',      'null',      'reject', m.null_required_count,     0::BIGINT),
            ('GBFS_DUPLICATE_STATION',  'duplicate', 'reject', m.duplicate_station_count, 0::BIGINT),
            ('GBFS_DATATYPE_CAPACITY',  'datatype',  'reject', m.bad_capacity_count,      0::BIGINT),
            ('GBFS_FORMAT_COORDINATE',  'format',    'reject', m.bad_coordinate_count,    0::BIGINT)
    ) AS rule_def (
        rule_code,
        rule_type,
        severity,
        failed_count,
        warning_count
    )
)

SELECT
    'gbfs_station'            AS source_name,
    'bootstrap_202601_202605' AS load_run_id,
    rule_code,
    rule_type,
    severity,
    GREATEST(total_count - failed_count - warning_count, 0)::INTEGER AS passed_count,
    failed_count::INTEGER,
    warning_count::INTEGER
FROM rules;</sql>
