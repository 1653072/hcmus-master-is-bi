  <transform>
    <type>ScriptValueMod</type>
    <name>Prepare GBFS raw fields</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var source_city_code = String(filename).indexOf("divvy") >= 0 ? "CHI" : "NYC";
var load_run_id = "bootstrap_202601_202605";
var raw_loaded_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());
function blankToNull(v) { if (v == null) return null; var s = String(v).trim(); return s.length == 0 ? null : s; }
gbfs_station_id = blankToNull(gbfs_station_id);
station_name = blankToNull(station_name);
short_name = blankToNull(short_name);
longitude = blankToNull(longitude);
latitude = blankToNull(latitude);
capacity = blankToNull(capacity);
station_type = blankToNull(station_type);
region_id = blankToNull(region_id);
if (typeof _last_file === 'undefined' || _last_file !== String(filename)) {
  _last_file = String(filename);
  _row_counter = 1;
} else {
  _row_counter++;
}
// The current source_row_number didn't include the header of CSV files (e.g., 1). If it includes the header, then it'll be 2.
var source_row_number = _row_counter;</jsScript_script>
      </jsScript>
    </jsScripts>
