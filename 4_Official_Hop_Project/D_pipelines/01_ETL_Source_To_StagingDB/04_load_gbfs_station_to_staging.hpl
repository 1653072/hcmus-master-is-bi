<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><pipeline_type>Normal</pipeline_type><pipeline_status>-1</pipeline_status><parameters/><name>04_load_gbfs_station_to_staging</name><name_sync_with_filename>Y</name_sync_with_filename></info>
  <transform>
    <type>TextFileInput2</type><name>Read GBFS station_information JSON files</name><file_type>CSV</file_type><compression>None</compression><separator>$[01]</separator><header>N</header><noempty>Y</noempty><include>Y</include><include_field>source_file</include_field><format>UNIX</format><encoding>UTF-8</encoding><limit>0</limit><date_format_lenient>Y</date_format_lenient><date_format_locale>en_US</date_format_locale>
    <files><file><name>${GBFS_STATION_DIR}/</name><filemask>.*station_information\.json</filemask><exclude_filemask/><file_required>Y</file_required><include_subfolders>N</include_subfolders></file></files>
    <fields><field><name>json_line</name><type>String</type><position>-1</position><length>2000000</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field></fields><GUI><xloc>96</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>JsonInput</type><name>Parse GBFS stations</name><valueField>json_line</valueField><IsInFields>Y</IsInFields><IsAFile>N</IsAFile><removeSourceField>Y</removeSourceField><ignoreMissingPath>Y</ignoreMissingPath>
    <fields><field><name>gbfs_station_id</name><path>$.data.stations[*].station_id</path><type>2</type></field><field><name>station_name</name><path>$.data.stations[*].name</path><type>2</type></field><field><name>short_name</name><path>$.data.stations[*].short_name</path><type>2</type></field><field><name>longitude</name><path>$.data.stations[*].lon</path><type>6</type></field><field><name>latitude</name><path>$.data.stations[*].lat</path><type>6</type></field><field><name>capacity</name><path>$.data.stations[*].capacity</path><type>5</type></field><field><name>station_type</name><path>$.data.stations[*].station_type</path><type>2</type></field><field><name>region_id</name><path>$.data.stations[*].region_id</path><type>2</type></field></fields><GUI><xloc>352</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>ScriptValueMod</type><name>Clean GBFS station fields</name>
    <jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>process</jsScript_name><jsScript_script>var source_city_code = String(source_file).indexOf("divvy") &gt;= 0 ? "CHI" : "NYC";
var station_status = "open";
var operation = "INSERT";
var loaded_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());
function blankToNull(v) { if (v == null) return null; var s = String(v).trim(); return s.length == 0 ? null : s; }
function toNumber(v) { var s = blankToNull(v); return s == null ? null : java.lang.Double.valueOf(s); }
function toInteger(v) { var s = blankToNull(v); return s == null ? null : java.lang.Integer.valueOf(s); }
gbfs_station_id = blankToNull(gbfs_station_id);
short_name = blankToNull(short_name);
if (short_name == null) short_name = gbfs_station_id;
station_name = blankToNull(station_name);
latitude = toNumber(latitude);
longitude = toNumber(longitude);
capacity = toInteger(capacity);
station_type = blankToNull(station_type);
region_id = blankToNull(region_id);</jsScript_script></jsScript></jsScripts>
    <fields><field><name>source_city_code</name><rename>source_city_code</rename><type>String</type><length>10</length><precision>-1</precision><replace>N</replace></field><field><name>gbfs_station_id</name><rename>gbfs_station_id</rename><type>String</type><length>-1</length><precision>-1</precision><replace>Y</replace></field><field><name>short_name</name><rename>short_name</rename><type>String</type><length>-1</length><precision>-1</precision><replace>Y</replace></field><field><name>station_name</name><rename>station_name</rename><type>String</type><length>500</length><precision>-1</precision><replace>Y</replace></field><field><name>latitude</name><rename>latitude</rename><type>Number</type><length>12</length><precision>8</precision><replace>Y</replace></field><field><name>longitude</name><rename>longitude</rename><type>Number</type><length>12</length><precision>8</precision><replace>Y</replace></field><field><name>capacity</name><rename>capacity</rename><type>Integer</type><length>-1</length><precision>0</precision><replace>Y</replace></field><field><name>station_type</name><rename>station_type</rename><type>String</type><length>50</length><precision>-1</precision><replace>Y</replace></field><field><name>region_id</name><rename>region_id</rename><type>String</type><length>20</length><precision>-1</precision><replace>Y</replace></field><field><name>station_status</name><rename>station_status</rename><type>String</type><length>30</length><precision>-1</precision><replace>N</replace></field><field><name>operation</name><rename>operation</rename><type>String</type><length>10</length><precision>-1</precision><replace>N</replace></field><field><name>loaded_at</name><rename>loaded_at</rename><type>Timestamp</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields>
    <optimizationLevel>9</optimizationLevel><GUI><xloc>608</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>InsertUpdate</type><name>Upsert staging.stg_gbfs_station</name><lookup><key><name>source_city_code</name><field>source_city_code</field><condition>=</condition><name2/></key><key><name>short_name</name><field>short_name</field><condition>=</condition><name2/></key><value><name>source_city_code</name><rename>source_city_code</rename><update>Y</update></value><value><name>gbfs_station_id</name><rename>gbfs_station_id</rename><update>Y</update></value><value><name>short_name</name><rename>short_name</rename><update>Y</update></value><value><name>station_name</name><rename>station_name</rename><update>Y</update></value><value><name>latitude</name><rename>latitude</rename><update>Y</update></value><value><name>longitude</name><rename>longitude</rename><update>Y</update></value><value><name>capacity</name><rename>capacity</rename><update>Y</update></value><value><name>station_type</name><rename>station_type</rename><update>Y</update></value><value><name>region_id</name><rename>region_id</rename><update>Y</update></value><value><name>station_status</name><rename>station_status</rename><update>Y</update></value><value><name>operation</name><rename>operation</rename><update>Y</update></value><value><name>loaded_at</name><rename>loaded_at</rename><update>Y</update></value><schema>staging</schema><table>stg_gbfs_station</table></lookup><commit>1000</commit><update_bypassed>N</update_bypassed><connection>dw-staging</connection><GUI><xloc>864</xloc><yloc>80</yloc></GUI>
  </transform>
  <order><hop><from>Read GBFS station_information JSON files</from><to>Parse GBFS stations</to><enabled>Y</enabled></hop><hop><from>Parse GBFS stations</from><to>Clean GBFS station fields</to><enabled>Y</enabled></hop><hop><from>Clean GBFS station fields</from><to>Upsert staging.stg_gbfs_station</to><enabled>Y</enabled></hop></order>
  <notepads/><attributes/><transform_error_handling/>
</pipeline>
