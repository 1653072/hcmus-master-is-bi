<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><pipeline_type>Normal</pipeline_type><pipeline_status>-1</pipeline_status><parameters/><name>04_load_gbfs_station_to_staging</name><name_sync_with_filename>Y</name_sync_with_filename><description>Flow 1: parse GBFS station JSON, keep all fields as STRING (no numeric cast), truncate-and-load into staging.raw_gbfs_station.</description></info>
  <transform>
    <type>TextFileInput2</type><name>Read GBFS station_information JSON files</name><file_type>CSV</file_type><compression>None</compression><separator>$[01]</separator><header>N</header><noempty>Y</noempty><include>Y</include><include_field>source_file</include_field><format>UNIX</format><encoding>UTF-8</encoding><limit>0</limit><date_format_lenient>Y</date_format_lenient><date_format_locale>en_US</date_format_locale>
    <files><file><name>${GBFS_STATION_DIR}/</name><filemask>.*station_information\.json</filemask><exclude_filemask/><file_required>Y</file_required><include_subfolders>N</include_subfolders></file></files>
    <fields><field><name>json_line</name><type>String</type><position>-1</position><length>2000000</length><precision>-1</precision><trim_type>none</trim_type><repeat>N</repeat></field></fields><GUI><xloc>96</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>JsonInput</type><name>Parse GBFS stations</name><valueField>json_line</valueField><IsInFields>Y</IsInFields><IsAFile>N</IsAFile><removeSourceField>Y</removeSourceField><ignoreMissingPath>Y</ignoreMissingPath>
    <fields>
      <field><name>gbfs_station_id</name><path>$.data.stations[*].station_id</path><type>2</type></field>
      <field><name>station_name</name><path>$.data.stations[*].name</path><type>2</type></field>
      <field><name>short_name</name><path>$.data.stations[*].short_name</path><type>2</type></field>
      <field><name>longitude</name><path>$.data.stations[*].lon</path><type>2</type></field>
      <field><name>latitude</name><path>$.data.stations[*].lat</path><type>2</type></field>
      <field><name>capacity</name><path>$.data.stations[*].capacity</path><type>2</type></field>
      <field><name>station_type</name><path>$.data.stations[*].station_type</path><type>2</type></field>
      <field><name>region_id</name><path>$.data.stations[*].region_id</path><type>2</type></field>
    </fields><GUI><xloc>352</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>ScriptValueMod</type><name>Prepare GBFS raw fields</name>
    <jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>process</jsScript_name><jsScript_script>var source_city_code = String(source_file).indexOf("divvy") &gt;= 0 ? "CHI" : "NYC";
var load_run_id = "bootstrap_202601_202605";
var raw_loaded_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());
function blankToNull(v) { if (v == null) return null; var s = String(v).trim(); return s.length == 0 ? null : s; }
gbfs_station_id = blankToNull(gbfs_station_id);
station_name = blankToNull(station_name);
short_name = blankToNull(short_name);
longitude = blankToNull(longitude);
latitude = blankToNull(latitude);
capacity = blankToNull(capacity);
station_type = blankToNull(station_type);
region_id = blankToNull(region_id);</jsScript_script></jsScript></jsScripts>
    <fields>
      <field><name>source_city_code</name><rename>source_city_code</rename><type>String</type><length>10</length><precision>-1</precision><replace>N</replace></field>
      <field><name>load_run_id</name><rename>load_run_id</rename><type>String</type><length>80</length><precision>-1</precision><replace>N</replace></field>
      <field><name>raw_loaded_at</name><rename>raw_loaded_at</rename><type>Timestamp</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>gbfs_station_id</name><rename>gbfs_station_id</rename><type>String</type><length>-1</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>station_name</name><rename>station_name</rename><type>String</type><length>500</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>short_name</name><rename>short_name</rename><type>String</type><length>-1</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>longitude</name><rename>longitude</rename><type>String</type><length>50</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>latitude</name><rename>latitude</rename><type>String</type><length>50</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>capacity</name><rename>capacity</rename><type>String</type><length>20</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>station_type</name><rename>station_type</rename><type>String</type><length>50</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>region_id</name><rename>region_id</rename><type>String</type><length>20</length><precision>-1</precision><replace>Y</replace></field>
    </fields>
    <optimizationLevel>9</optimizationLevel><GUI><xloc>608</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>RowNumber</type><name>Add source_row_number</name>
    <fieldName>source_row_number</fieldName><resultType>Integer</resultType><starting_value>1</starting_value><increment>1</increment>
    <GUI><xloc>864</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>TableOutput</type><name>Load to raw_gbfs_station</name><connection>dw-staging</connection><schema>staging</schema><table>raw_gbfs_station</table><commit>1000</commit><truncate>Y</truncate><only_when_have_rows>N</only_when_have_rows><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields>
    <fields>
      <field><stream_name>load_run_id</stream_name><column_name>load_run_id</column_name></field>
      <field><stream_name>source_file</stream_name><column_name>source_file</column_name></field>
      <field><stream_name>source_row_number</stream_name><column_name>source_row_number</column_name></field>
      <field><stream_name>gbfs_station_id</stream_name><column_name>gbfs_station_id</column_name></field>
      <field><stream_name>station_name</stream_name><column_name>station_name</column_name></field>
      <field><stream_name>short_name</stream_name><column_name>short_name</column_name></field>
      <field><stream_name>longitude</stream_name><column_name>longitude</column_name></field>
      <field><stream_name>latitude</stream_name><column_name>latitude</column_name></field>
      <field><stream_name>capacity</stream_name><column_name>capacity</column_name></field>
      <field><stream_name>station_type</stream_name><column_name>station_type</column_name></field>
      <field><stream_name>region_id</stream_name><column_name>region_id</column_name></field>
      <field><stream_name>source_city_code</stream_name><column_name>source_city_code</column_name></field>
      <field><stream_name>raw_loaded_at</stream_name><column_name>raw_loaded_at</column_name></field>
    </fields>
    <GUI><xloc>1120</xloc><yloc>80</yloc></GUI>
  </transform>
  <order>
    <hop><from>Read GBFS station_information JSON files</from><to>Parse GBFS stations</to><enabled>Y</enabled></hop>
    <hop><from>Parse GBFS stations</from><to>Prepare GBFS raw fields</to><enabled>Y</enabled></hop>
    <hop><from>Prepare GBFS raw fields</from><to>Add source_row_number</to><enabled>Y</enabled></hop>
    <hop><from>Add source_row_number</from><to>Load to raw_gbfs_station</to><enabled>Y</enabled></hop>
  </order>
  <notepads><notepad><note>Flow 1 — all JSON fields kept as STRING. DQ validation and transformation to stg_gbfs_station happen in 04_validate_gbfs_raw_to_staging.hpl.</note><xloc>96</xloc><yloc>200</yloc><width>760</width><heigth>60</heigth></notepad></notepads>
  <attributes/><transform_error_handling/>
</pipeline>
