<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><pipeline_type>Normal</pipeline_type><pipeline_status>-1</pipeline_status><parameters/><name>03_load_noaa_weather_to_staging</name><name_sync_with_filename>Y</name_sync_with_filename><description>Flow 1: read NOAA LCD CSV as all-TEXT (no cast, no FM filter), truncate-and-load into staging.raw_noaa_weather. FM-type filtering happens in 03_validate_noaa_raw_to_staging.hpl.</description></info>
  <transform>
    <type>TextFileInput2</type><name>Read NOAA LCD v2 CSV files</name><file_type>CSV</file_type><compression>None</compression><separator>,</separator><enclosure>"</enclosure><header>Y</header><nr_headerlines>1</nr_headerlines><noempty>Y</noempty><include>Y</include><include_field>source_file</include_field><format>DOS</format><encoding>UTF-8</encoding><limit>0</limit><date_format_lenient>Y</date_format_lenient><date_format_locale>en_US</date_format_locale>
    <files>
      <file><name>${NOAA_LCD_CHICAGO}</name><filemask/><exclude_filemask/><file_required>Y</file_required><include_subfolders>N</include_subfolders></file>
      <file><name>${NOAA_LCD_NYC}</name><filemask/><exclude_filemask/><file_required>Y</file_required><include_subfolders>N</include_subfolders></file>
    </files>
    <fields>
      <field><name>noaa_station_id</name><type>String</type><position>-1</position><length>20</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>observation_ts</name><type>String</type><position>-1</position><length>40</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>latitude_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>longitude_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>elevation_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>station_name_raw</name><type>String</type><position>-1</position><length>200</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>report_type</name><type>String</type><position>-1</position><length>20</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>source_raw</name><type>String</type><position>-1</position><length>20</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>hourly_altimeter_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>hourly_dewpoint_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>hourly_dry_bulb_temperature</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>hourly_precipitation</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>hourly_present_weather_type</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>hourly_pressure_change_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>hourly_pressure_tendency_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>hourly_relative_humidity_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>hourly_sky_conditions_raw</name><type>String</type><position>-1</position><length>200</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>hourly_sea_level_pressure_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>hourly_station_pressure_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>hourly_visibility_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>hourly_wet_bulb_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>hourly_wind_direction_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>hourly_wind_gust_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>hourly_wind_speed</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
    </fields>
    <GUI><xloc>96</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>ScriptValueMod</type><name>Prepare NOAA raw fields</name>
    <jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>process</jsScript_name><jsScript_script>var source_city_code = String(noaa_station_id) == "USW00014819" ? "CHI" : "NYC";
var load_run_id = "bootstrap_202601_202605";
var raw_loaded_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());
function blankToNull(v) { if (v == null) return null; var s = String(v).trim(); return s.length == 0 ? null : s; }
noaa_station_id = blankToNull(noaa_station_id);
observation_ts = blankToNull(observation_ts);
report_type = blankToNull(report_type);
hourly_dry_bulb_temperature = blankToNull(hourly_dry_bulb_temperature);
hourly_precipitation = blankToNull(hourly_precipitation);
hourly_present_weather_type = blankToNull(hourly_present_weather_type);
hourly_wind_speed = blankToNull(hourly_wind_speed);</jsScript_script></jsScript></jsScripts>
    <fields>
      <field><name>source_city_code</name><rename>source_city_code</rename><type>String</type><length>10</length><precision>-1</precision><replace>N</replace></field>
      <field><name>load_run_id</name><rename>load_run_id</rename><type>String</type><length>80</length><precision>-1</precision><replace>N</replace></field>
      <field><name>raw_loaded_at</name><rename>raw_loaded_at</rename><type>Timestamp</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>noaa_station_id</name><rename>noaa_station_id</rename><type>String</type><length>20</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>observation_ts</name><rename>observation_ts</rename><type>String</type><length>40</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>report_type</name><rename>report_type</rename><type>String</type><length>20</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>hourly_dry_bulb_temperature</name><rename>hourly_dry_bulb_temperature</rename><type>String</type><length>50</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>hourly_precipitation</name><rename>hourly_precipitation</rename><type>String</type><length>50</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>hourly_present_weather_type</name><rename>hourly_present_weather_type</rename><type>String</type><length>50</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>hourly_wind_speed</name><rename>hourly_wind_speed</rename><type>String</type><length>50</length><precision>-1</precision><replace>Y</replace></field>
    </fields>
    <optimizationLevel>9</optimizationLevel><GUI><xloc>352</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>TableOutput</type><name>Load to raw_noaa_weather</name><connection>dw-staging</connection><schema>staging</schema><table>raw_noaa_weather</table><commit>1000</commit><truncate>Y</truncate><only_when_have_rows>N</only_when_have_rows><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields>
    <fields>
      <field><stream_name>load_run_id</stream_name><column_name>load_run_id</column_name></field>
      <field><stream_name>source_file</stream_name><column_name>source_file</column_name></field>
      <field><stream_name>noaa_station_id</stream_name><column_name>noaa_station_id</column_name></field>
      <field><stream_name>observation_ts</stream_name><column_name>observation_ts</column_name></field>
      <field><stream_name>report_type</stream_name><column_name>report_type</column_name></field>
      <field><stream_name>hourly_dry_bulb_temperature</stream_name><column_name>hourly_dry_bulb_temperature</column_name></field>
      <field><stream_name>hourly_precipitation</stream_name><column_name>hourly_precipitation</column_name></field>
      <field><stream_name>hourly_wind_speed</stream_name><column_name>hourly_wind_speed</column_name></field>
      <field><stream_name>hourly_present_weather_type</stream_name><column_name>hourly_present_weather_type</column_name></field>
      <field><stream_name>source_city_code</stream_name><column_name>source_city_code</column_name></field>
      <field><stream_name>raw_loaded_at</stream_name><column_name>raw_loaded_at</column_name></field>
    </fields>
    <GUI><xloc>864</xloc><yloc>80</yloc></GUI>
  </transform>
  <order>
    <hop><from>Read NOAA LCD v2 CSV files</from><to>Prepare NOAA raw fields</to><enabled>Y</enabled></hop>
    <hop><from>Prepare NOAA raw fields</from><to>Load to raw_noaa_weather</to><enabled>Y</enabled></hop>
  </order>
  <notepads><notepad><note>Flow 1 — no type casting, no FM filter. DQ validation and transformation to stg_weather happen in 03_validate_noaa_raw_to_staging.hpl.</note><xloc>96</xloc><yloc>200</yloc><width>760</width><heigth>60</heigth></notepad></notepads>
  <attributes/><transform_error_handling/>
</pipeline>
