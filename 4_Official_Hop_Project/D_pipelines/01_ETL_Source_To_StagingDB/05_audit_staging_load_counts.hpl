    </lookup>
    <commit>1000</commit>
    <update_bypassed>N</update_bypassed>
    <connection>dw-control</connection>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>608</xloc>
      <yloc>48</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
