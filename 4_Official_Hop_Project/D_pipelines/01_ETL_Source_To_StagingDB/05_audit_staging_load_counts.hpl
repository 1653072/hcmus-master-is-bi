    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>608</xloc>
      <yloc>176</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Read staging.raw_* row counts</from>
      <to>Add audit fields</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Add audit fields</from>
