<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>05_audit_staging_load_counts</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Audits staging load results: joins raw_* (total rows) vs stg_* (accepted rows), updates etl_extraction_control, and inserts per-source rows into etl_job_log with job_name=etl_source_to_stagingdb_stg_result.</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/09 01:15:09.982</created_date>
    <modified_date>2026/07/09 01:15:09.982</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read staging.raw_* row counts</name>
    <sql>SELECT
    s.source_name,
    s.table_name,
    r.raw_count              AS total_rows_count,
    s.stg_count              AS success_rows_count,
    (r.raw_count - s.stg_count) AS failed_rows_count,
    r.max_raw_loaded_at      AS cet_value
FROM (
    SELECT 'divvy_trips'   AS source_name, 'stg_divvy_trips'   AS table_name, COUNT(*)::INTEGER AS stg_count FROM staging.stg_divvy_trips
    UNION ALL
    SELECT 'citibike_trips', 'stg_citibike_trips', COUNT(*)::INTEGER FROM staging.stg_citibike_trips
    UNION ALL
    SELECT 'noaa_lcd',       'stg_weather',         COUNT(*)::INTEGER FROM staging.stg_weather
    UNION ALL
    SELECT 'gbfs_station',   'stg_gbfs_station',    COUNT(*)::INTEGER FROM staging.stg_gbfs_station
) s
JOIN (
    SELECT 'divvy_trips'   AS source_name, COUNT(*)::INTEGER AS raw_count, MAX(raw_loaded_at) AS max_raw_loaded_at FROM staging.raw_divvy_trips
    UNION ALL
    SELECT 'citibike_trips', COUNT(*)::INTEGER, MAX(raw_loaded_at) FROM staging.raw_citibike_trips
    UNION ALL
    SELECT 'noaa_lcd',       COUNT(*)::INTEGER, MAX(raw_loaded_at) FROM staging.raw_noaa_weather
    UNION ALL
    SELECT 'gbfs_station',   COUNT(*)::INTEGER, MAX(raw_loaded_at) FROM staging.raw_gbfs_station
) r ON s.source_name = r.source_name</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>dw-staging</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>Add audit fields</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var job_name = "etl_source_to_stagingdb_stg_result";
var status = (total_rows_count > 0 &amp;&amp; success_rows_count == 0) ? "FAILED" : "SUCCESS";
var finished_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());
var started_at;
try {
  started_at = Packages.java.sql.Timestamp.valueOf(getVariable("ETL_STARTED_AT", "2026-01-01 00:00:00.0"));
} catch(e) {
  started_at = finished_at;
}
var error_message = null;

// LSET/CET watermark update:
// lset_value = old CET (read at start by 00_start_etl_source_to_staging and stored as JVM variable)
// cet_value  = MAX(raw_loaded_at) from SQL above
// Convention: variable name = "CET_" + source_name.toUpperCase()
var _srcUpper = String(source_name).toUpperCase();
var _lsetStr = getVariable("CET_" + _srcUpper, null);
var lset_value = null;
if (_lsetStr != null &amp;&amp; String(_lsetStr).length > 0) {
  try { lset_value = Packages.java.sql.Timestamp.valueOf(String(_lsetStr)); } catch(e2) {}
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>job_name</name>
        <rename>job_name</rename>
        <type>String</type>
        <length>100</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>status</name>
        <rename>status</rename>
        <type>String</type>
        <length>20</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>finished_at</name>
        <rename>finished_at</rename>
        <type>Timestamp</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>started_at</name>
        <rename>started_at</rename>
        <type>Timestamp</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>error_message</name>
        <rename>error_message</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>lset_value</name>
        <rename>lset_value</rename>
        <type>Timestamp</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>352</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>Update control.etl_extraction_control</name>
    <lookup>
      <key>
        <name>source_name</name>
        <field>source_name</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>table_name</name>
        <field>table_name</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>source_name</name>
        <rename>source_name</rename>
        <update>N</update>
      </value>
      <value>
        <name>table_name</name>
        <rename>table_name</rename>
        <update>N</update>
      </value>
      <value>
        <name>rows_extracted</name>
        <rename>success_rows_count</rename>
        <update>Y</update>
      </value>
      <value>
        <name>last_run_status</name>
        <rename>status</rename>
        <update>Y</update>
      </value>
      <value>
        <name>lset</name>
        <rename>lset_value</rename>
        <update>Y</update>
      </value>
      <value>
        <name>cet</name>
        <rename>cet_value</rename>
        <update>Y</update>
      </value>
      <value>
        <name>updated_at</name>
        <rename>finished_at</rename>
        <update>Y</update>
      </value>
      <schema>control</schema>
      <table>etl_extraction_control</table>
    </lookup>
    <commit>10</commit>
    <update_bypassed>N</update_bypassed>
    <connection>dw-control</connection>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>608</xloc>
      <yloc>48</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Insert control.etl_job_log rows</name>
    <connection>dw-control</connection>
    <schema>control</schema>
    <table>etl_job_log</table>
    <commit>10</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>N</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>N</tablename_in_table>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field>
        <stream_name>job_name</stream_name>
        <column_name>job_name</column_name>
      </field>
      <field>
        <stream_name>source_name</stream_name>
        <column_name>source_name</column_name>
      </field>
      <field>
        <stream_name>started_at</stream_name>
