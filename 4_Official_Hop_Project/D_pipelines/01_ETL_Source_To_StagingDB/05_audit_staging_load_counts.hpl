<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>05_audit_staging_load_counts</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Audits staging load results: joins raw_* (total rows) vs stg_* (accepted rows), updates etl_extraction_control, and inserts per-source rows into etl_job_log with job_name=etl_source_to_stagingdb_stg_result.</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/09 01:15:09.982</created_date>
    <modified_date>2026/07/09 01:15:09.982</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read staging.raw_* row counts</name>
    <sql>WITH counts AS (
  SELECT
    'divvy_trips' AS source_name,
    'stg_divvy_trips' AS table_name,
    (
      SELECT COUNT(*)::INTEGER
      FROM staging.raw_divvy_trips
      WHERE started_at ~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'
        AND split_part(BTRIM(started_at), '.', 1)::TIMESTAMP
              &gt;= ('${LSET_DIVVY_TRIPS}'::TIMESTAMP - (COALESCE(NULLIF('${LOOKBACK_DAYS_DIVVY_TRIPS}', ''), '3') || ' days')::INTERVAL)
        AND split_part(BTRIM(started_at), '.', 1)::TIMESTAMP
              &lt;= '${CET_DIVVY_TRIPS}'::TIMESTAMP
    ) AS raw_count,
    (
      SELECT COUNT(*)::INTEGER
      FROM staging.stg_divvy_trips
      WHERE loaded_at &gt;= '${ETL_STARTED_AT}'::TIMESTAMP
        AND loaded_at &lt;= '${CET_DIVVY_TRIPS}'::TIMESTAMP
    ) AS stg_count

  UNION ALL
  SELECT
    'citibike_trips',
    'stg_citibike_trips',
    (
      SELECT COUNT(*)::INTEGER
      FROM staging.raw_citibike_trips
      WHERE started_at ~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'
        AND split_part(BTRIM(started_at), '.', 1)::TIMESTAMP
              &gt;= ('${LSET_CITIBIKE_TRIPS}'::TIMESTAMP - (COALESCE(NULLIF('${LOOKBACK_DAYS_CITIBIKE_TRIPS}', ''), '3') || ' days')::INTERVAL)
        AND split_part(BTRIM(started_at), '.', 1)::TIMESTAMP
              &lt;= '${CET_CITIBIKE_TRIPS}'::TIMESTAMP
    ),
    (
      SELECT COUNT(*)::INTEGER
      FROM staging.stg_citibike_trips
      WHERE loaded_at &gt;= '${ETL_STARTED_AT}'::TIMESTAMP
        AND loaded_at &lt;= '${CET_CITIBIKE_TRIPS}'::TIMESTAMP
    )

  UNION ALL
  SELECT
    'noaa_lcd',
    'stg_weather',
    (
      SELECT COUNT(*)::INTEGER
      FROM staging.raw_noaa_weather
      WHERE NULLIF(BTRIM(observation_ts), '') IS NOT NULL
        AND replace(BTRIM(observation_ts), 'T', ' ')::TIMESTAMP
              &gt;= ('${LSET_NOAA_LCD}'::TIMESTAMP - (COALESCE(NULLIF('${LOOKBACK_DAYS_NOAA}', ''), '3') || ' days')::INTERVAL)
        AND replace(BTRIM(observation_ts), 'T', ' ')::TIMESTAMP
              &lt;= '${CET_NOAA_LCD}'::TIMESTAMP
    ),
    (
      SELECT COUNT(*)::INTEGER
      FROM staging.stg_weather
      WHERE loaded_at &gt;= '${ETL_STARTED_AT}'::TIMESTAMP
        AND loaded_at &lt;= '${CET_NOAA_LCD}'::TIMESTAMP
    )

  UNION ALL
  SELECT
    'gbfs_station',
    'stg_gbfs_station',
    (SELECT COUNT(*)::INTEGER FROM staging.raw_gbfs_station),
    (
      SELECT COUNT(*)::INTEGER
      FROM staging.stg_gbfs_station
      WHERE loaded_at &gt;= '${ETL_STARTED_AT}'::TIMESTAMP
        AND loaded_at &lt;= '${CET_GBFS_STATION}'::TIMESTAMP
    )
)
SELECT
  source_name,
  table_name,
  raw_count AS total_rows_count,
  stg_count AS success_rows_count,
  GREATEST(raw_count - stg_count, 0)::INTEGER AS failed_rows_count,
  '${CET_DIVVY_TRIPS}'::TIMESTAMP AS cet_value
FROM counts</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>dw-staging</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>Add audit fields</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var job_name = "etl_source_to_stagingdb_stg_result";
var status = (total_rows_count > 0 &amp;&amp; failed_rows_count > 0 &amp;&amp; success_rows_count == 0) ? "FAILED" : "SUCCESS";
var finished_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());
var started_at;
try {
  started_at = Packages.java.sql.Timestamp.valueOf(getVariable("ETL_STARTED_AT", "2026-01-01 00:00:00.0"));
} catch(e) {
  started_at = finished_at;
}
var error_message = null;

// LSET/CET watermark update after successful extract window:
// This run used LSET_* (from control.lset) and CET_* (= CLOCK_TIMESTAMP at 00_start).
// Advance both control.lset and control.cet to this run's CET so the next run starts after it.
var _srcUpper = String(source_name).toUpperCase();
var _cetStr = getVariable("CET_" + _srcUpper, null);
var lset_value = null;
if (_cetStr != null &amp;&amp; String(_cetStr).length > 0) {
  try {
    cet_value = Packages.java.sql.Timestamp.valueOf(String(_cetStr));
    lset_value = cet_value;
  } catch(e2) {}
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
