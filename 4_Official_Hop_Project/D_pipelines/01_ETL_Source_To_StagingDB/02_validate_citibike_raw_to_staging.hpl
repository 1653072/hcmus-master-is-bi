  <transform>
    <type>TableInput</type>
    <name>Read valid typed Citi Bike trips</name>
    <connection>dw-staging</connection>
    <sql><![CDATA[WITH filtered_raw AS (
    SELECT
        r.*,
        NULLIF(BTRIM(r.ride_id), '')            AS ride_id_norm,
        NULLIF(BTRIM(r.source_city_code), '')   AS source_city_code_norm,
        NULLIF(BTRIM(r.started_at), '')         AS started_at_norm,
        NULLIF(BTRIM(r.ended_at), '')           AS ended_at_norm,
        NULLIF(BTRIM(r.rideable_type), '')      AS rideable_type_norm,
        NULLIF(BTRIM(r.start_station_name), '') AS start_station_name_norm,
        NULLIF(BTRIM(r.start_station_id), '')   AS start_station_id_norm,
        NULLIF(BTRIM(r.end_station_name), '')   AS end_station_name_norm,
        NULLIF(BTRIM(r.end_station_id), '')     AS end_station_id_norm,
        NULLIF(BTRIM(r.start_lat), '')          AS start_lat_norm,
        NULLIF(BTRIM(r.start_lng), '')          AS start_lng_norm,
        NULLIF(BTRIM(r.end_lat), '')            AS end_lat_norm,
        NULLIF(BTRIM(r.end_lng), '')            AS end_lng_norm,
        NULLIF(BTRIM(r.member_casual), '')      AS member_casual_norm,
        NULLIF(BTRIM(r.trip_month), '')         AS trip_month_norm,
        NULLIF(BTRIM(r.source_file), '')        AS source_file_norm
    FROM staging.raw_citibike_trips AS r
    WHERE COALESCE(NULLIF('${CITIBIKE_VALIDATE_MONTH}', ''), 'ALL') = 'ALL'
       OR r.trip_month = '${CITIBIKE_VALIDATE_MONTH}'
),

accepted AS (
    SELECT DISTINCT ON (source_city_code_norm, ride_id_norm)
        *
    FROM filtered_raw
    WHERE ride_id_norm IS NOT NULL
      AND started_at_norm IS NOT NULL
      AND source_city_code_norm IS NOT NULL
      AND started_at ~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'
      AND trip_month IS NOT NULL
      AND trip_month ~ '^[0-9]{6}$'
    ORDER BY
        source_city_code_norm,
        ride_id_norm,
        source_file,
        source_row_number
),

typed AS (
    SELECT
        ride_id_norm::VARCHAR(64) AS ride_id,
        rideable_type_norm::VARCHAR(50) AS rideable_type,
        split_part(started_at_norm, '.', 1)::TIMESTAMP AS started_at,
        CASE
            WHEN ended_at_norm IS NULL THEN NULL
            ELSE split_part(ended_at_norm, '.', 1)::TIMESTAMP
        END AS ended_at,
        start_station_name_norm::VARCHAR(500) AS start_station_name,
        start_station_id_norm AS start_station_id,
        end_station_name_norm::VARCHAR(500) AS end_station_name,
        end_station_id_norm AS end_station_id,
        start_lat_norm::NUMERIC(12, 8) AS start_lat,
        start_lng_norm::NUMERIC(12, 8) AS start_lng,
        end_lat_norm::NUMERIC(12, 8) AS end_lat,
        end_lng_norm::NUMERIC(12, 8) AS end_lng,
        member_casual_norm::VARCHAR(20) AS member_casual,
        source_city_code_norm::VARCHAR(10) AS source_city_code,
        trip_month_norm::CHAR(6) AS trip_month,
        source_file_norm::VARCHAR(500) AS source_file
    FROM accepted
)

SELECT
    ride_id,
    rideable_type,
    started_at,
    ended_at,
    start_station_name,
    start_station_id,
    end_station_name,
    end_station_id,
    start_lat,
    start_lng,
    end_lat,
    end_lng,
    member_casual,
    source_city_code,
    trip_month,
    source_file,
    statement_timestamp() AS loaded_at
FROM typed;]]></sql>
