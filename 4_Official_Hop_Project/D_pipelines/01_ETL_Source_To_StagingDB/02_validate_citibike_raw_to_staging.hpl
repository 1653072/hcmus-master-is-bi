<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>02_validate_citibike_raw_to_staging</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Flow 2 — DQ gate for Citi Bike: 3 parallel streams from raw_citibike_trips. Stream A: row-level reject/warning details to etl_dq_rule_result_details. Stream B: aggregate counts to etl_dq_rule_result_analysis. Stream C: clean rows cast and upserted into stg_citibike_trips.</description>
  </info>

  <!-- ===== STREAM A: row-level details ===== -->
  <transform>
    <type>TableInput</type>
    <name>Read Citi Bike reject+warning row details</name>
    <connection>dw-staging</connection>
    <sql><![CDATA[SELECT load_run_id, 'citibike_trips' AS source_name, 'raw_citibike_trips' AS source_table,
       source_file, source_row_number,
       COALESCE(NULLIF(BTRIM(ride_id),''), '(null)') AS business_key,
       'CITI_NULL_REQUIRED' AS rule_code, 'null' AS rule_type, 'reject' AS dq_verdict,
       'Required field(s) null or blank: ride_id/started_at/source_city_code' AS reason,
       NULL::JSONB AS raw_payload
FROM staging.raw_citibike_trips
WHERE NULLIF(BTRIM(ride_id),'') IS NULL
   OR NULLIF(BTRIM(started_at),'') IS NULL
   OR NULLIF(BTRIM(source_city_code),'') IS NULL

UNION ALL

SELECT r.load_run_id, 'citibike_trips', 'raw_citibike_trips',
       r.source_file, r.source_row_number,
       COALESCE(NULLIF(BTRIM(r.ride_id),''), '(null)'),
       'CITI_DUPLICATE_RIDE', 'duplicate', 'reject',
       'Duplicate (source_city_code, ride_id) in this load run', NULL::JSONB
FROM staging.raw_citibike_trips r
JOIN (SELECT source_city_code, ride_id FROM staging.raw_citibike_trips
      GROUP BY source_city_code, ride_id HAVING COUNT(*) > 1) d
  ON r.source_city_code = d.source_city_code AND r.ride_id = d.ride_id

UNION ALL

SELECT load_run_id, 'citibike_trips', 'raw_citibike_trips',
       source_file, source_row_number,
       COALESCE(NULLIF(BTRIM(ride_id),''), '(null)'),
       'CITI_DATATYPE_TIMESTAMP', 'datatype', 'reject',
       'started_at not parseable as yyyy-MM-dd HH:mm:ss', NULL::JSONB
FROM staging.raw_citibike_trips
WHERE NULLIF(BTRIM(ride_id),'') IS NOT NULL
  AND NULLIF(BTRIM(started_at),'') IS NOT NULL
  AND started_at !~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'

UNION ALL

SELECT load_run_id, 'citibike_trips', 'raw_citibike_trips',
       source_file, source_row_number,
       COALESCE(NULLIF(BTRIM(ride_id),''), '(null)'),
       'CITI_FORMAT_TRIP_MONTH', 'format', 'reject',
       'trip_month null or not YYYYMM', NULL::JSONB
FROM staging.raw_citibike_trips
WHERE NULLIF(BTRIM(ride_id),'') IS NOT NULL
  AND (trip_month IS NULL OR trip_month !~ '^[0-9]{6}$')

UNION ALL

SELECT r.load_run_id, 'citibike_trips', 'raw_citibike_trips',
       r.source_file, r.source_row_number,
       COALESCE(NULLIF(BTRIM(r.ride_id),''), '(null)'),
       'CITI_WARN_STATION_ID', 'null', 'warning',
       'Missing start_station_id or end_station_id', NULL::JSONB
FROM staging.raw_citibike_trips r
WHERE NULLIF(BTRIM(r.ride_id),'') IS NOT NULL
  AND NULLIF(BTRIM(r.started_at),'') IS NOT NULL
  AND r.started_at ~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'
  AND (r.trip_month IS NOT NULL AND r.trip_month ~ '^[0-9]{6}$')
  AND (NULLIF(BTRIM(r.start_station_id),'') IS NULL
       OR NULLIF(BTRIM(r.end_station_id),'') IS NULL)]]></sql>
    <limit>0</limit><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lookup/><sql_from_file/>
    <GUI><xloc>96</xloc><yloc>32</yloc></GUI>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Write Citi Bike DQ row details</name>
    <connection>dw-control</connection><schema>control</schema><table>etl_dq_rule_result_details</table><commit>100</commit><truncate>N</truncate><only_when_have_rows>N</only_when_have_rows><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields>
    <fields>
      <field><stream_name>load_run_id</stream_name><column_name>load_run_id</column_name></field>
      <field><stream_name>source_name</stream_name><column_name>source_name</column_name></field>
      <field><stream_name>source_table</stream_name><column_name>source_table</column_name></field>
      <field><stream_name>source_file</stream_name><column_name>source_file</column_name></field>
      <field><stream_name>source_row_number</stream_name><column_name>source_row_number</column_name></field>
      <field><stream_name>business_key</stream_name><column_name>business_key</column_name></field>
      <field><stream_name>rule_code</stream_name><column_name>rule_code</column_name></field>
      <field><stream_name>rule_type</stream_name><column_name>rule_type</column_name></field>
      <field><stream_name>dq_verdict</stream_name><column_name>dq_verdict</column_name></field>
      <field><stream_name>reason</stream_name><column_name>reason</column_name></field>
      <field><stream_name>raw_payload</stream_name><column_name>raw_payload</column_name></field>
    </fields>
    <GUI><xloc>448</xloc><yloc>32</yloc></GUI>
  </transform>

  <!-- ===== STREAM B: aggregate counts ===== -->
  <transform>
    <type>TableInput</type>
    <name>Read Citi Bike raw DQ rule counts</name>
    <connection>dw-staging</connection>
    <sql><![CDATA[WITH src AS (
  SELECT * FROM staging.raw_citibike_trips
),
dup AS (
  SELECT source_city_code, ride_id, COUNT(*) AS duplicate_count
  FROM src GROUP BY source_city_code, ride_id HAVING COUNT(*) > 1
),
rules AS (
  SELECT 'CITI_NULL_REQUIRED' AS rule_code, 'null' AS rule_type, 'reject' AS severity,
         COUNT(*) FILTER (WHERE NULLIF(BTRIM(ride_id),'') IS NULL
                           OR NULLIF(BTRIM(started_at),'') IS NULL
                           OR NULLIF(BTRIM(source_city_code),'') IS NULL) AS failed_count,
         0::BIGINT AS warning_count, COUNT(*) AS total_count
  FROM src
  UNION ALL
  SELECT 'CITI_DUPLICATE_RIDE', 'duplicate', 'reject',
         COALESCE(SUM(duplicate_count), 0), 0::BIGINT, (SELECT COUNT(*) FROM src)
  FROM dup
  UNION ALL
  SELECT 'CITI_DATATYPE_TIMESTAMP', 'datatype', 'reject',
         COUNT(*) FILTER (WHERE NULLIF(BTRIM(ride_id),'') IS NOT NULL
                           AND NULLIF(BTRIM(started_at),'') IS NOT NULL
                           AND started_at !~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'),
         0::BIGINT, COUNT(*)
  FROM src
  UNION ALL
  SELECT 'CITI_FORMAT_TRIP_MONTH', 'format', 'reject',
         COUNT(*) FILTER (WHERE trip_month IS NULL OR trip_month !~ '^[0-9]{6}$'),
         0::BIGINT, COUNT(*)
  FROM src
  UNION ALL
  SELECT 'CITI_WARN_STATION_ID', 'null', 'warning',
         0::BIGINT,
         COUNT(*) FILTER (WHERE NULLIF(BTRIM(ride_id),'') IS NOT NULL
                           AND NULLIF(BTRIM(started_at),'') IS NOT NULL
                           AND started_at ~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'
                           AND (trip_month IS NOT NULL AND trip_month ~ '^[0-9]{6}$')
                           AND (NULLIF(BTRIM(start_station_id),'') IS NULL
                                OR NULLIF(BTRIM(end_station_id),'') IS NULL)),
         COUNT(*)
  FROM src
)
SELECT 'citibike_trips' AS source_name,
       'bootstrap_202601_202605' AS load_run_id,
       rule_code, rule_type, severity,
       GREATEST(total_count - failed_count - warning_count, 0)::INTEGER AS passed_count,
       failed_count::INTEGER AS failed_count,
       warning_count::INTEGER AS warning_count
FROM rules]]></sql>
    <limit>0</limit><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lookup/><sql_from_file/>
    <GUI><xloc>96</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Write Citi Bike DQ rule stream evidence</name>
    <connection>dw-control</connection><schema>control</schema><table>etl_dq_rule_result_analysis</table><commit>100</commit><truncate>N</truncate><only_when_have_rows>N</only_when_have_rows><ignore_errors>N</ignore_errors><use_batch>Y</use_batch><specify_fields>Y</specify_fields>
    <fields>
      <field><stream_name>load_run_id</stream_name><column_name>load_run_id</column_name></field>
      <field><stream_name>source_name</stream_name><column_name>source_name</column_name></field>
      <field><stream_name>rule_code</stream_name><column_name>rule_code</column_name></field>
      <field><stream_name>rule_type</stream_name><column_name>rule_type</column_name></field>
      <field><stream_name>severity</stream_name><column_name>severity</column_name></field>
      <field><stream_name>passed_count</stream_name><column_name>passed_count</column_name></field>
      <field><stream_name>failed_count</stream_name><column_name>failed_count</column_name></field>
      <field><stream_name>warning_count</stream_name><column_name>warning_count</column_name></field>
    </fields>
    <GUI><xloc>448</xloc><yloc>160</yloc></GUI>
  </transform>

  <!-- ===== STREAM C: clean rows → cast → stg_citibike_trips ===== -->
  <transform>
    <type>TableInput</type>
    <name>Read Citi Bike clean rows</name>
    <connection>dw-staging</connection>
    <sql><![CDATA[SELECT DISTINCT ON (source_city_code, ride_id)
       load_run_id, source_file,
       ride_id, rideable_type, started_at, ended_at,
       start_station_name, start_station_id, end_station_name, end_station_id,
       start_lat, start_lng, end_lat, end_lng,
       member_casual, source_city_code, trip_month
FROM staging.raw_citibike_trips
WHERE NULLIF(BTRIM(ride_id),'') IS NOT NULL
  AND NULLIF(BTRIM(started_at),'') IS NOT NULL
  AND NULLIF(BTRIM(source_city_code),'') IS NOT NULL
  AND started_at ~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'
  AND (trip_month IS NOT NULL AND trip_month ~ '^[0-9]{6}$')
ORDER BY source_city_code, ride_id]]></sql>
    <limit>0</limit><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lookup/><sql_from_file/>
    <GUI><xloc>96</xloc><yloc>320</yloc></GUI>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>Cast Citi Bike clean rows</name>
    <jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>process</jsScript_name><jsScript_script>function blankToNull(v) { if (v == null) return null; var s = String(v).trim(); return s.length == 0 ? null : s; }
function toTimestamp(v) {
  var s = blankToNull(v); if (s == null) return null;
  var p = s.split("."); var fmt = new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss");
  return new Packages.java.sql.Timestamp(fmt.parse(p[0]).getTime());
}
function toNumber(v) { var s = blankToNull(v); return s == null ? null : java.lang.Double.valueOf(s); }
started_at = toTimestamp(started_at); ended_at = toTimestamp(ended_at);
start_lat = toNumber(start_lat); start_lng = toNumber(start_lng);
end_lat = toNumber(end_lat); end_lng = toNumber(end_lng);
start_station_name = blankToNull(start_station_name); start_station_id = blankToNull(start_station_id);
end_station_name = blankToNull(end_station_name); end_station_id = blankToNull(end_station_id);
member_casual = blankToNull(member_casual);
var loaded_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());</jsScript_script></jsScript></jsScripts>
    <fields>
      <field><name>started_at</name><rename>started_at</rename><type>Timestamp</type><length>-1</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>ended_at</name><rename>ended_at</rename><type>Timestamp</type><length>-1</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>start_lat</name><rename>start_lat</rename><type>Number</type><length>12</length><precision>8</precision><replace>Y</replace></field>
      <field><name>start_lng</name><rename>start_lng</rename><type>Number</type><length>12</length><precision>8</precision><replace>Y</replace></field>
      <field><name>end_lat</name><rename>end_lat</rename><type>Number</type><length>12</length><precision>8</precision><replace>Y</replace></field>
      <field><name>end_lng</name><rename>end_lng</rename><type>Number</type><length>12</length><precision>8</precision><replace>Y</replace></field>
      <field><name>start_station_name</name><rename>start_station_name</rename><type>String</type><length>500</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>start_station_id</name><rename>start_station_id</rename><type>String</type><length>100</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>end_station_name</name><rename>end_station_name</rename><type>String</type><length>500</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>end_station_id</name><rename>end_station_id</rename><type>String</type><length>100</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>member_casual</name><rename>member_casual</rename><type>String</type><length>20</length><precision>-1</precision><replace>Y</replace></field>
      <field><name>loaded_at</name><rename>loaded_at</rename><type>Timestamp</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <optimizationLevel>9</optimizationLevel><GUI><xloc>384</xloc><yloc>320</yloc></GUI>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>Upsert staging.stg_citibike_trips</name>
    <lookup>
      <key><name>source_city_code</name><field>source_city_code</field><condition>=</condition><name2/></key>
      <key><name>ride_id</name><field>ride_id</field><condition>=</condition><name2/></key>
      <value><name>ride_id</name><rename>ride_id</rename><update>Y</update></value>
      <value><name>rideable_type</name><rename>rideable_type</rename><update>Y</update></value>
      <value><name>started_at</name><rename>started_at</rename><update>Y</update></value>
      <value><name>ended_at</name><rename>ended_at</rename><update>Y</update></value>
      <value><name>start_station_name</name><rename>start_station_name</rename><update>Y</update></value>
      <value><name>start_station_id</name><rename>start_station_id</rename><update>Y</update></value>
      <value><name>end_station_name</name><rename>end_station_name</rename><update>Y</update></value>
      <value><name>end_station_id</name><rename>end_station_id</rename><update>Y</update></value>
      <value><name>start_lat</name><rename>start_lat</rename><update>Y</update></value>
      <value><name>start_lng</name><rename>start_lng</rename><update>Y</update></value>
      <value><name>end_lat</name><rename>end_lat</rename><update>Y</update></value>
      <value><name>end_lng</name><rename>end_lng</rename><update>Y</update></value>
      <value><name>member_casual</name><rename>member_casual</rename><update>Y</update></value>
      <value><name>source_city_code</name><rename>source_city_code</rename><update>Y</update></value>
      <value><name>trip_month</name><rename>trip_month</rename><update>Y</update></value>
      <value><name>source_file</name><rename>source_file</rename><update>Y</update></value>
      <value><name>loaded_at</name><rename>loaded_at</rename><update>Y</update></value>
      <schema>staging</schema><table>stg_citibike_trips</table>
    </lookup>
    <commit>1000</commit><update_bypassed>N</update_bypassed><connection>dw-staging</connection>
    <GUI><xloc>720</xloc><yloc>320</yloc></GUI>
  </transform>

  <order>
    <hop><from>Read Citi Bike reject+warning row details</from><to>Write Citi Bike DQ row details</to><enabled>Y</enabled></hop>
    <hop><from>Read Citi Bike raw DQ rule counts</from><to>Write Citi Bike DQ rule stream evidence</to><enabled>Y</enabled></hop>
    <hop><from>Read Citi Bike clean rows</from><to>Cast Citi Bike clean rows</to><enabled>Y</enabled></hop>
    <hop><from>Cast Citi Bike clean rows</from><to>Upsert staging.stg_citibike_trips</to><enabled>Y</enabled></hop>
  </order>
  <notepads>
    <notepad><note>Stream A → etl_dq_rule_result_details (row-level rejects + warnings)
Stream B → etl_dq_rule_result_analysis (aggregate counts per rule)
Stream C → stg_citibike_trips (clean rows, cast, deduplicated)</note><xloc>96</xloc><yloc>440</yloc><width>760</width><heigth>80</heigth></notepad>
  </notepads>
  <attributes/><transform_error_handling/>
</pipeline>
