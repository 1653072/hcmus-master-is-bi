<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters>
      <parameter>
        <name>CITIBIKE_VALIDATE_MONTH</name>
        <default_value>ALL</default_value>
        <description>Use ALL for full raw validation, or YYYYMM for a representative sample month.</description>
      </parameter>
      <parameter>
        <name>CITIBIKE_RESULT_LOAD_RUN_ID</name>
        <default_value>bootstrap_202601_202605</default_value>
        <description>Control-table load_run_id for Citi Bike DQ result rows.</description>
      </parameter>
    </parameters>
    <name>02_validate_citibike_raw_to_staging</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Flow 2 — DQ gate for Citi Bike: 3 parallel streams from raw_citibike_trips. Stream A: row-level reject/warning details to etl_dq_rule_result_details. Stream B: aggregate counts to etl_dq_rule_result_analysis. Stream C: TableInput filters, deduplicates, and casts accepted rows before Hop InsertUpdate writes stg_citibike_trips.</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/09 19:58:23.064</created_date>
    <modified_date>2026/07/13 00:00:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read Citi Bike reject+warning row details</name>
    <sql>WITH filtered_raw AS (
    SELECT *
    FROM staging.raw_citibike_trips AS r
    WHERE COALESCE(NULLIF('${CITIBIKE_VALIDATE_MONTH}', ''), 'ALL') = 'ALL'
       OR r.trip_month = '${CITIBIKE_VALIDATE_MONTH}'
),

src AS (
    SELECT
        COALESCE(NULLIF('${CITIBIKE_RESULT_LOAD_RUN_ID}', ''), 'bootstrap_202601_202605') AS load_run_id,
        r.source_file,
        r.source_row_number,
        r.ride_id,
        r.started_at,
        r.trip_month,
        r.source_city_code,
        COALESCE(NULLIF(BTRIM(r.ride_id), ''), '(null)') AS business_key,
        NULLIF(BTRIM(r.ride_id), '')                     AS ride_id_norm,
        NULLIF(BTRIM(r.started_at), '')                  AS started_at_norm,
        NULLIF(BTRIM(r.source_city_code), '')            AS source_city_code_norm,
        NULLIF(BTRIM(r.start_station_id), '')            AS start_station_id_norm,
        NULLIF(BTRIM(r.end_station_id), '')              AS end_station_id_norm,
        jsonb_build_object(
            'ride_id',            r.ride_id,
            'rideable_type',      r.rideable_type,
            'started_at',         r.started_at,
            'ended_at',           r.ended_at,
            'start_station_name', r.start_station_name,
            'start_station_id',   r.start_station_id,
            'end_station_name',   r.end_station_name,
            'end_station_id',     r.end_station_id,
            'start_lat',          r.start_lat,
            'start_lng',          r.start_lng,
            'end_lat',            r.end_lat,
            'end_lng',            r.end_lng,
            'member_casual',      r.member_casual,
            'source_city_code',   r.source_city_code,
            'trip_month',         r.trip_month
        ) AS raw_payload
    FROM filtered_raw AS r
),

dup_keys AS (
    SELECT
        source_city_code,
        ride_id
    FROM filtered_raw
    GROUP BY
        source_city_code,
        ride_id
    HAVING COUNT(*) &gt; 1
)

-- Rule 1: required fields
SELECT
    load_run_id,
    'citibike_trips'     AS source_name,
    'raw_citibike_trips' AS source_table,
    source_file,
    source_row_number,
    business_key,
    'CITI_NULL_REQUIRED' AS rule_code,
    'null'               AS rule_type,
    'reject'             AS dq_verdict,
    'Required field(s) null or blank: ride_id/started_at/source_city_code' AS reason,
    raw_payload
FROM src
WHERE ride_id_norm IS NULL
   OR started_at_norm IS NULL
   OR source_city_code_norm IS NULL

UNION ALL

-- Rule 2: duplicate (source_city_code, ride_id)
SELECT
    s.load_run_id,
    'citibike_trips',
    'raw_citibike_trips',
    s.source_file,
    s.source_row_number,
    s.business_key,
    'CITI_DUPLICATE_RIDE',
    'duplicate',
    'reject',
    'Duplicate (source_city_code, ride_id) in this load run',
    s.raw_payload
FROM src AS s
INNER JOIN dup_keys AS d
    ON  s.source_city_code = d.source_city_code
    AND s.ride_id          = d.ride_id

UNION ALL

-- Rule 3: started_at timestamp format
SELECT
    load_run_id,
    'citibike_trips',
    'raw_citibike_trips',
    source_file,
    source_row_number,
    business_key,
    'CITI_DATATYPE_TIMESTAMP',
    'datatype',
    'reject',
    'started_at not parseable as yyyy-MM-dd HH:mm:ss',
    raw_payload
FROM src
WHERE ride_id_norm IS NOT NULL
  AND started_at_norm IS NOT NULL
  AND started_at !~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'

UNION ALL

-- Rule 4: trip_month YYYYMM
SELECT
    load_run_id,
    'citibike_trips',
    'raw_citibike_trips',
    source_file,
    source_row_number,
    business_key,
    'CITI_FORMAT_TRIP_MONTH',
    'format',
    'reject',
    'trip_month null or not YYYYMM',
    raw_payload
FROM src
WHERE ride_id_norm IS NOT NULL
  AND (trip_month IS NULL OR trip_month !~ '^[0-9]{6}$')

UNION ALL

-- Rule 5: missing station ids (warning)
SELECT
    load_run_id,
    'citibike_trips',
    'raw_citibike_trips',
    source_file,
    source_row_number,
    business_key,
    'CITI_WARN_STATION_ID',
    'null',
    'warning',
    'Missing start_station_id or end_station_id',
    raw_payload
FROM src
WHERE ride_id_norm IS NOT NULL
  AND started_at_norm IS NOT NULL
  AND started_at ~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'
  AND trip_month IS NOT NULL
  AND trip_month ~ '^[0-9]{6}$'
  AND (
        start_station_id_norm IS NULL
     OR end_station_id_norm IS NULL
      );</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>dw-staging</connection>
