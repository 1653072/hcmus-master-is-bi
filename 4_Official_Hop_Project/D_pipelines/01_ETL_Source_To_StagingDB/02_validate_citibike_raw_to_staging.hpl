  <order>
    <hop>
      <from>Read Citi Bike reject+warning row details</from>
      <to>Write Citi Bike DQ row details</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read Citi Bike raw DQ rule counts</from>
      <to>Write Citi Bike DQ rule stream evidence</to>
