  <transform>
    <type>TableInput</type>
    <name>Read Citi Bike raw DQ rule counts</name>
    <sql>WITH filtered_raw AS (
    SELECT *
    FROM staging.raw_citibike_trips AS r
    WHERE COALESCE(NULLIF('${CITIBIKE_VALIDATE_MONTH}', ''), 'ALL') = 'ALL'
       OR r.trip_month = '${CITIBIKE_VALIDATE_MONTH}'
),

src AS (
    SELECT
        r.*,
        NULLIF(BTRIM(r.ride_id), '')          AS ride_id_norm,
        NULLIF(BTRIM(r.started_at), '')       AS started_at_norm,
        NULLIF(BTRIM(r.source_city_code), '') AS source_city_code_norm,
        NULLIF(BTRIM(r.start_station_id), '') AS start_station_id_norm,
        NULLIF(BTRIM(r.end_station_id), '')   AS end_station_id_norm
    FROM filtered_raw AS r
),

enriched AS (
    SELECT
        s.*,
        COUNT(*) OVER (
            PARTITION BY s.source_city_code, s.ride_id
        ) AS ride_key_count
    FROM src AS s
),

metrics AS (
    SELECT
        COUNT(*)::BIGINT AS total_count,

        COUNT(*) FILTER (
            WHERE ride_id_norm IS NULL
               OR started_at_norm IS NULL
               OR source_city_code_norm IS NULL
        )::BIGINT AS null_required_count,

        COUNT(*) FILTER (
            WHERE ride_key_count &gt; 1
        )::BIGINT AS duplicate_ride_count,

        COUNT(*) FILTER (
            WHERE ride_id_norm IS NOT NULL
              AND started_at_norm IS NOT NULL
              AND started_at !~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'
        )::BIGINT AS bad_timestamp_count,

        COUNT(*) FILTER (
            WHERE trip_month IS NULL
               OR trip_month !~ '^[0-9]{6}$'
        )::BIGINT AS bad_trip_month_count,

        COUNT(*) FILTER (
            WHERE ride_id_norm IS NOT NULL
              AND started_at_norm IS NOT NULL
              AND started_at ~ '^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}'
              AND trip_month IS NOT NULL
              AND trip_month ~ '^[0-9]{6}$'
              AND (
                    start_station_id_norm IS NULL
                 OR end_station_id_norm IS NULL
              )
        )::BIGINT AS missing_station_id_count
    FROM enriched
),

rules AS (
    SELECT
        rule_code,
        rule_type,
        severity,
        failed_count,
        warning_count,
        m.total_count
    FROM metrics AS m
    CROSS JOIN LATERAL (
        VALUES
            ('CITI_NULL_REQUIRED',      'null',      'reject',  m.null_required_count,      0::BIGINT),
            ('CITI_DUPLICATE_RIDE',     'duplicate', 'reject',  m.duplicate_ride_count,     0::BIGINT),
            ('CITI_DATATYPE_TIMESTAMP', 'datatype',  'reject',  m.bad_timestamp_count,      0::BIGINT),
            ('CITI_FORMAT_TRIP_MONTH',  'format',    'reject',  m.bad_trip_month_count,     0::BIGINT),
            ('CITI_WARN_STATION_ID',    'null',      'warning', 0::BIGINT,                  m.missing_station_id_count)
    ) AS rule_def (
        rule_code,
        rule_type,
        severity,
        failed_count,
        warning_count
    )
)

SELECT
    'citibike_trips' AS source_name,
    COALESCE(NULLIF('${CITIBIKE_RESULT_LOAD_RUN_ID}', ''), 'bootstrap_202601_202605') AS load_run_id,
    rule_code,
    rule_type,
    severity,
    GREATEST(total_count - failed_count - warning_count, 0)::INTEGER AS passed_count,
    failed_count::INTEGER,
    warning_count::INTEGER
FROM rules;</sql>
