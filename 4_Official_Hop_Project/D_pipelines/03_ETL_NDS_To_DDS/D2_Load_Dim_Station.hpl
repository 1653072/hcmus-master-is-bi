<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>D2_Load_Dim_Station</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>NDS→DDS Dim_Station: DimensionLookup for active stations; soft-close DDS current row when NDS has no active version (DELETE only).</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/06 12:00:00.000</created_date>
    <modified_date>2026/07/12 21:00:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read active nds.station</name>
    <sql>SELECT
    city_sk,
    source_station_id,
    station_name,
    latitude,
    longitude,
    capacity,
    station_status,
    effective_from,
    row_status
FROM nds.station
WHERE is_current = TRUE AND row_status = 'active'</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>dw-nds</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>144</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DimensionLookup</type>
    <name>SCD Type 2 dim_station</name>
    <schema>dds</schema>
    <table>dim_station</table>
    <connection>dw-dds</connection>
    <update>Y</update>
    <fields>
      <key>
        <name>city_sk</name>
        <lookup>city_sk</lookup>
      </key>
      <key>
        <name>source_station_id</name>
        <lookup>source_station_id</lookup>
      </key>
      <date>
        <name>effective_from</name>
        <from>effective_from</from>
        <to>effective_to</to>
      </date>
      <field>
        <name>station_name</name>
        <lookup>station_name</lookup>
        <update>Update</update>
      </field>
      <field>
        <name>latitude</name>
        <lookup>latitude</lookup>
        <update>Update</update>
      </field>
      <field>
        <name>longitude</name>
        <lookup>longitude</lookup>
        <update>Update</update>
      </field>
      <field>
        <name>capacity</name>
        <lookup>capacity</lookup>
        <update>Update</update>
      </field>
      <field>
        <name>station_status</name>
        <lookup>station_status</lookup>
        <update>Update</update>
      </field>
      <return>
        <name>station_sk</name>
        <rename/>
        <creation_method>autoinc</creation_method>
        <version>version</version>
      </return>
    </fields>
    <commit>100</commit>
    <useBatch>N</useBatch>
    <min_year>0</min_year>
    <max_year>0</max_year>
    <cache_size>0</cache_size>
    <use_start_date_alternative>N</use_start_date_alternative>
    <preload_cache>N</preload_cache>
    <unknown_row_check_disabled>Y</unknown_row_check_disabled>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>400</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableInput</type>
    <name>Read deleted nds.station</name>
    <sql>SELECT DISTINCT
    d.city_sk,
    d.source_station_id,
    d.effective_to,
    d.row_status
FROM nds.station d
WHERE d.row_status = 'deleted'
  AND d.is_current = FALSE
  AND d.effective_to IS NOT NULL
  AND NOT EXISTS (
    SELECT 1
    FROM nds.station a
    WHERE a.city_sk = d.city_sk
      AND a.source_station_id = d.source_station_id
      AND a.is_current = TRUE
      AND a.row_status = 'active'
  )</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>dw-nds</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>144</xloc>
      <yloc>368</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Constant</type>
    <name>Add DDS current lookup flag</name>
    <fields>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <nullif>Y</nullif>
        <name>lookup_is_current</name>
        <type>Boolean</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <currency/>
        <decimal/>
        <group/>
        <nullif>N</nullif>
        <name>is_current_out</name>
        <type>Boolean</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>144</xloc>
      <yloc>496</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Lookup current dds.dim_station</name>
    <connection>dw-dds</connection>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <cache_load_all>N</cache_load_all>
    <lookup>
      <schema>dds</schema>
      <table>dim_station</table>
      <key>
        <name>city_sk</name>
        <name2/>
        <condition>=</condition>
        <field>city_sk</field>
      </key>
      <key>
        <name>source_station_id</name>
        <name2/>
        <condition>=</condition>
        <field>source_station_id</field>
      </key>
      <key>
        <name>lookup_is_current</name>
        <name2/>
        <condition>=</condition>
        <field>is_current</field>
      </key>
      <value>
        <name>station_sk</name>
        <rename>dds_station_sk</rename>
        <default/>
        <type>Integer</type>
        <trim_type>none</trim_type>
      </value>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>144</xloc>
      <yloc>656</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>DDS current row exists</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <function>=</function>
        <conditions>
          <condition>
            <negated>N</negated>
            <operator>-</operator>
            <leftvalue>dds_station_sk</leftvalue>
            <function>IS NOT NULL</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>String</type>
              <text/>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>Y</isnull>
              <mask/>
            </value>
            <conditions/>
          </condition>
        </conditions>
      </condition>
    </compare>
    <send_true_to>Soft-close dds.dim_station</send_true_to>
    <send_false_to>Skip DDS soft-close</send_false_to>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>144</xloc>
      <yloc>800</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Skip DDS soft-close</name>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>384</xloc>
      <yloc>912</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>Soft-close dds.dim_station</name>
    <lookup>
      <key>
        <name>city_sk</name>
        <field>city_sk</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>source_station_id</name>
        <field>source_station_id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>lookup_is_current</name>
        <field>is_current</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>city_sk</name>
        <rename>city_sk</rename>
        <update>N</update>
      </value>
      <value>
        <name>source_station_id</name>
        <rename>source_station_id</rename>
        <update>N</update>
      </value>
      <value>
        <name>row_status</name>
        <rename>row_status</rename>
        <update>Y</update>
      </value>
      <value>
        <name>is_current</name>
        <rename>is_current_out</rename>
        <update>Y</update>
      </value>
      <value>
        <name>effective_to</name>
        <rename>effective_to</rename>
        <update>Y</update>
      </value>
      <schema>dds</schema>
      <table>dim_station</table>
    </lookup>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <connection>dw-dds</connection>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>384</xloc>
      <yloc>800</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Read active nds.station</from>
      <to>SCD Type 2 dim_station</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read deleted nds.station</from>
      <to>Add DDS current lookup flag</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Add DDS current lookup flag</from>
      <to>Lookup current dds.dim_station</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup current dds.dim_station</from>
      <to>DDS current row exists</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>DDS current row exists</from>
      <to>Soft-close dds.dim_station</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>DDS current row exists</from>
      <to>Skip DDS soft-close</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads>
    <notepad>
      <note>How NDS station maps to dds.dim_station:

1) Active NDS row (is_current=true, row_status=active) - DimensionLookup updates the current DDS row in place (name, lat/lon, capacity, station_status).

2) NDS has only deleted history for that station (no active row left) - Soft-close the current DDS row: row_status=deleted, is_current=false, effective_to=now. Skip if DDS has no current row yet.

3) NDS has old deleted rows AND a new active row (reactivated) - Soft-close is skipped. Only the active branch runs and syncs the latest active version to DDS.</note>
      <fontname>.AppleSystemUIFont</fontname>
      <fontsize>13</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>32</xloc>
      <yloc>48</yloc>
      <width>1328</width>
      <height>32</height>
    </notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
