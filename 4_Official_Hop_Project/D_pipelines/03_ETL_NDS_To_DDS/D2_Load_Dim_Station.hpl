<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>D2_Load_Dim_Station</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>NDS→DDS Dim_Station: DimensionLookup for active stations; soft-close DDS current row when NDS has no active version (DELETE only).</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/07/06 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/07/12 21:00:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read active nds.station</name>
    <sql>SELECT
    city_sk,
    source_station_id,
    station_name,
    latitude,
    longitude,
    capacity,
    station_status,
    effective_from,
    row_status
FROM nds.station
WHERE is_current = TRUE AND row_status = 'active'</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>dw-nds</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>96</xloc><yloc>96</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DimensionLookup</type>
    <name>SCD Type 2 dim_station</name>
    <connection>dw-dds</connection>
    <schema>dds</schema>
    <table>dim_station</table>
    <commit>100</commit>
    <update>Y</update>
    <fields>
      <key>
        <name>city_sk</name>
        <lookup>city_sk</lookup>
      </key>
      <key>
        <name>source_station_id</name>
        <lookup>source_station_id</lookup>
      </key>
      <date>
        <name>effective_from</name>
        <from>effective_from</from>
        <to>effective_to</to>
      </date>
      <field>
        <name>station_name</name>
        <lookup>station_name</lookup>
        <update>Update</update>
      </field>
      <field>
        <name>latitude</name>
        <lookup>latitude</lookup>
        <update>Update</update>
      </field>
      <field>
        <name>longitude</name>
        <lookup>longitude</lookup>
        <update>Update</update>
      </field>
      <field>
        <name>capacity</name>
        <lookup>capacity</lookup>
        <update>Update</update>
      </field>
      <field>
        <name>station_status</name>
        <lookup>station_status</lookup>
        <update>Update</update>
      </field>
      <return>
        <name>station_sk</name>
        <rename/>
        <creation_method>autoinc</creation_method>
        <use_autoinc>Y</use_autoinc>
        <version>version</version>
      </return>
    </fields>
    <use_relation_connection>N</use_relation_connection>
    <use_active_flag>Y</use_active_flag>
    <active_flag_field>is_current</active_flag_field>
    <unknown_row_check_disabled>Y</unknown_row_check_disabled>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>352</xloc><yloc>96</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableInput</type>
    <name>Read deleted nds.station</name>
    <sql><![CDATA[SELECT DISTINCT
    d.city_sk,
    d.source_station_id,
    d.effective_to,
    d.row_status
FROM nds.station d
WHERE d.row_status = 'deleted'
  AND d.is_current = FALSE
  AND d.effective_to IS NOT NULL
  AND NOT EXISTS (
    SELECT 1
    FROM nds.station a
    WHERE a.city_sk = d.city_sk
      AND a.source_station_id = d.source_station_id
      AND a.is_current = TRUE
      AND a.row_status = 'active'
  )]]></sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>dw-nds</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>96</xloc><yloc>288</yloc></GUI>
    <partitioning><method>none</method><schema_name/></partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Constant</type>
    <name>Add DDS current lookup flag</name>
    <fields>
      <field>
        <currency/><decimal/><group/><nullif>Y</nullif>
        <name>lookup_is_current</name>
        <type>Boolean</type>
        <format/><length>-1</length><precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <currency/><decimal/><group/><nullif>N</nullif>
        <name>is_current_out</name>
        <type>Boolean</type>
        <format/><length>-1</length><precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <GUI><xloc>288</xloc><yloc>288</yloc></GUI>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Lookup current dds.dim_station</name>
    <connection>dw-dds</connection>
    <cache>N</cache>
    <lookup>
      <schema>dds</schema>
      <table>dim_station</table>
      <key><name>city_sk</name><field>city_sk</field><condition>=</condition><name2/></key>
      <key><name>source_station_id</name><field>source_station_id</field><condition>=</condition><name2/></key>
      <key><name>lookup_is_current</name><field>is_current</field><condition>=</condition><name2/></key>
      <value><name>station_sk</name><rename>dds_station_sk</rename><default/><type>Integer</type></value>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <GUI><xloc>448</xloc><yloc>288</yloc></GUI>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>DDS current row exists</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <conditions>
          <condition>
            <negated>N</negated>
            <leftvalue>dds_station_sk</leftvalue>
            <function>IS NOT NULL</function>
            <rightvalue/>
            <value><name>constant</name><type>String</type><text/><length>-1</length><precision>-1</precision><isnull>Y</isnull><mask/></value>
            <conditions/>
          </condition>
        </conditions>
      </condition>
    </compare>
    <send_true_to>Soft-close dds.dim_station</send_true_to>
    <send_false_to>Skip DDS soft-close</send_false_to>
    <GUI><xloc>608</xloc><yloc>288</yloc></GUI>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Skip DDS soft-close</name>
    <GUI><xloc>768</xloc><yloc>400</yloc></GUI>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>Soft-close dds.dim_station</name>
    <connection>dw-dds</connection>
    <lookup>
      <key><name>city_sk</name><field>city_sk</field><condition>=</condition><name2/></key>
      <key><name>source_station_id</name><field>source_station_id</field><condition>=</condition><name2/></key>
      <key><name>lookup_is_current</name><field>is_current</field><condition>=</condition><name2/></key>
      <value><name>city_sk</name><rename>city_sk</rename><update>N</update></value>
      <value><name>source_station_id</name><rename>source_station_id</rename><update>N</update></value>
      <value><name>row_status</name><rename>row_status</rename><update>Y</update></value>
      <value><name>is_current</name><rename>is_current_out</rename><update>Y</update></value>
      <value><name>effective_to</name><rename>effective_to</rename><update>Y</update></value>
      <schema>dds</schema>
      <table>dim_station</table>
    </lookup>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <GUI><xloc>768</xloc><yloc>288</yloc></GUI>
  </transform>
  <order>
    <hop><from>Read active nds.station</from><to>SCD Type 2 dim_station</to><enabled>Y</enabled></hop>
    <hop><from>Read deleted nds.station</from><to>Add DDS current lookup flag</to><enabled>Y</enabled></hop>
    <hop><from>Add DDS current lookup flag</from><to>Lookup current dds.dim_station</to><enabled>Y</enabled></hop>
    <hop><from>Lookup current dds.dim_station</from><to>DDS current row exists</to><enabled>Y</enabled></hop>
    <hop><from>DDS current row exists</from><to>Soft-close dds.dim_station</to><enabled>Y</enabled></hop>
    <hop><from>DDS current row exists</from><to>Skip DDS soft-close</to><enabled>Y</enabled></hop>
  </order>
  <notepads>
    <notepad><note>Active: DimensionLookup Update-in-place. Soft-close only when NDS has no active version for the key (NOT EXISTS) and a current DDS row exists (DBLookup filter) — avoids stub inserts and avoids closing reactivated DDS rows.</note><xloc>96</xloc><yloc>480</yloc><width>860</width><heigth>90</heigth></notepad>
  </notepads>
  <attributes/>
</pipeline>
