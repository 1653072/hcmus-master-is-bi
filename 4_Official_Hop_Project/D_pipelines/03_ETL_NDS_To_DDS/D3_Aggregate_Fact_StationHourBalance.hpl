    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>D3_Aggregate_Fact_StationHourBalance</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/06 12:00:00.000</created_date>
    <modified_date>2026/07/06 12:00:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read and aggregate NDS</name>
    <sql>WITH affected_grains AS (
    SELECT DISTINCT
        city_sk,
        start_station_id AS source_station_id,
        DATE_TRUNC('hour', started_at) AS date_hour
    FROM nds.trip
    WHERE start_station_sk IS NOT NULL
      AND loaded_at > '${LSET_NDS_TO_DDS}'::TIMESTAMP AND loaded_at &lt;= '${CET_NDS_TO_DDS}'::TIMESTAMP
    UNION
    SELECT DISTINCT
        city_sk,
        end_station_id AS source_station_id,
        DATE_TRUNC('hour', ended_at) AS date_hour
    FROM nds.trip
    WHERE end_station_sk IS NOT NULL AND ended_at IS NOT NULL
      AND loaded_at > '${LSET_NDS_TO_DDS}'::TIMESTAMP AND loaded_at &lt;= '${CET_NDS_TO_DDS}'::TIMESTAMP
),
starts AS (
    SELECT 
        ts.city_sk,
        ts.start_station_id AS source_station_id,
        DATE_TRUNC('hour', ts.started_at) AS date_hour,
        COUNT(*) AS trips_started,
        COUNT(*) FILTER (WHERE ts.member_casual = 'member') AS member_trip_started_count,
        COUNT(*) FILTER (WHERE ts.member_casual = 'casual') AS casual_trip_started_count,
        COUNT(*) FILTER (WHERE ts.rideable_type = 'electric_bike') AS electric_trip_started_count,
        COUNT(*) FILTER (WHERE ts.rideable_type = 'classic_bike') AS classic_trip_started_count,
        SUM(ts.duration_minutes) FILTER (WHERE ts.member_casual = 'member') AS sum_duration_member,
        SUM(ts.duration_minutes) FILTER (WHERE ts.member_casual = 'casual') AS sum_duration_casual
    FROM nds.trip ts
    INNER JOIN affected_grains g
        ON ts.city_sk = g.city_sk
        AND ts.start_station_id = g.source_station_id
        AND DATE_TRUNC('hour', ts.started_at) = g.date_hour
    WHERE ts.start_station_sk IS NOT NULL
    GROUP BY ts.city_sk, ts.start_station_id, DATE_TRUNC('hour', ts.started_at)
),
ends AS (
    SELECT 
        te.city_sk,
        te.end_station_id AS source_station_id,
        DATE_TRUNC('hour', te.ended_at) AS date_hour,
        COUNT(*) AS trips_ended
    FROM nds.trip te
    INNER JOIN affected_grains g
        ON te.city_sk = g.city_sk
        AND te.end_station_id = g.source_station_id
        AND DATE_TRUNC('hour', te.ended_at) = g.date_hour
    WHERE te.end_station_sk IS NOT NULL AND te.ended_at IS NOT NULL
    GROUP BY te.city_sk, te.end_station_id, DATE_TRUNC('hour', te.ended_at)
),
combined AS (
    SELECT 
        g.city_sk,
        g.source_station_id,
        g.date_hour,
        COALESCE(s.trips_started, 0) AS trips_started,
        COALESCE(e.trips_ended, 0) AS trips_ended,
        (COALESCE(e.trips_ended, 0) - COALESCE(s.trips_started, 0)) AS net_flow,
        ABS(COALESCE(e.trips_ended, 0) - COALESCE(s.trips_started, 0)) AS abs_imbalance,
        COALESCE(s.member_trip_started_count, 0) AS member_trip_count,
        COALESCE(s.casual_trip_started_count, 0) AS casual_trip_count,
        COALESCE(s.electric_trip_started_count, 0) AS electric_trip_count,
        COALESCE(s.classic_trip_started_count, 0) AS classic_trip_count,
        CASE 
            WHEN COALESCE(s.member_trip_started_count, 0) > 0 
            THEN ROUND((s.sum_duration_member / s.member_trip_started_count)::numeric, 2)
            ELSE NULL 
        END AS avg_duration_member_minutes,
        CASE 
            WHEN COALESCE(s.casual_trip_started_count, 0) > 0 
            THEN ROUND((s.sum_duration_casual / s.casual_trip_started_count)::numeric, 2)
            ELSE NULL 
        END AS avg_duration_casual_minutes
    FROM affected_grains g
    LEFT JOIN starts s
        ON g.city_sk = s.city_sk 
        AND g.source_station_id = s.source_station_id 
        AND g.date_hour = s.date_hour
    LEFT JOIN ends e 
        ON g.city_sk = e.city_sk 
        AND g.source_station_id = e.source_station_id 
        AND g.date_hour = e.date_hour
)
SELECT 
    c.city_sk,
    c.source_station_id,
    c.date_hour,
    EXTRACT(HOUR FROM c.date_hour)::SMALLINT AS hour_val,
    c.date_hour::DATE AS date_val,
    c.trips_started,
    c.trips_ended,
    c.net_flow,
    c.abs_imbalance,
    c.member_trip_count,
    c.casual_trip_count,
    c.electric_trip_count,
    c.classic_trip_count,
    c.avg_duration_member_minutes,
    c.avg_duration_casual_minutes,
    COALESCE(w.temperature_c, 0.00) AS temperature,
    COALESCE(w.precipitation_mm, 0.00) AS precipitation,
    COALESCE(w.wind_speed_ms, 0.00) AS wind_speed,
    COALESCE(w.weather_category, 'Clear') AS weather_category,
    TRUE AS is_current_const
FROM combined c
LEFT JOIN nds.weather w 
    ON c.city_sk = w.city_sk 
    AND c.date_hour = w.observation_hour
ORDER BY c.city_sk, c.source_station_id, c.date_hour</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>dw-nds</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
