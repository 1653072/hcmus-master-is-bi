<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>D3_Aggregate_Fact_StationHourBalance</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description/>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/07/06 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/07/06 12:00:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read and aggregate NDS</name>
    <sql>WITH starts AS (
    SELECT 
        city_sk,
        start_station_id AS source_station_id,
        DATE_TRUNC('hour', started_at) AS date_hour,
        COUNT(*) AS trips_started,
        COUNT(*) FILTER (WHERE member_casual = 'member') AS member_trip_started_count,
        COUNT(*) FILTER (WHERE member_casual = 'casual') AS casual_trip_started_count,
        COUNT(*) FILTER (WHERE rideable_type = 'electric_bike') AS electric_trip_started_count,
        COUNT(*) FILTER (WHERE rideable_type = 'classic_bike') AS classic_trip_started_count,
        SUM(duration_minutes) FILTER (WHERE member_casual = 'member') AS sum_duration_member,
        SUM(duration_minutes) FILTER (WHERE member_casual = 'casual') AS sum_duration_casual
    FROM nds.trip
    WHERE start_station_sk IS NOT NULL
      AND loaded_at &gt; '${LSET_NDS_TO_DDS}'::TIMESTAMP AND loaded_at &lt;= '${CET_NDS_TO_DDS}'::TIMESTAMP
    GROUP BY city_sk, start_station_id, DATE_TRUNC('hour', started_at)
),
ends AS (
    SELECT 
        city_sk,
        end_station_id AS source_station_id,
        DATE_TRUNC('hour', ended_at) AS date_hour,
        COUNT(*) AS trips_ended
    FROM nds.trip
    WHERE end_station_sk IS NOT NULL AND ended_at IS NOT NULL
      AND loaded_at &gt; '${LSET_NDS_TO_DDS}'::TIMESTAMP AND loaded_at &lt;= '${CET_NDS_TO_DDS}'::TIMESTAMP
    GROUP BY city_sk, end_station_id, DATE_TRUNC('hour', ended_at)
),
combined AS (
    SELECT 
        COALESCE(s.city_sk, e.city_sk) AS city_sk,
        COALESCE(s.source_station_id, e.source_station_id) AS source_station_id,
        COALESCE(s.date_hour, e.date_hour) AS date_hour,
        COALESCE(s.trips_started, 0) AS trips_started,
        COALESCE(e.trips_ended, 0) AS trips_ended,
        (COALESCE(e.trips_ended, 0) - COALESCE(s.trips_started, 0)) AS net_flow,
        ABS(COALESCE(e.trips_ended, 0) - COALESCE(s.trips_started, 0)) AS abs_imbalance,
        COALESCE(s.member_trip_started_count, 0) AS member_trip_count,
        COALESCE(s.casual_trip_started_count, 0) AS casual_trip_count,
        COALESCE(s.electric_trip_started_count, 0) AS electric_trip_count,
        COALESCE(s.classic_trip_started_count, 0) AS classic_trip_count,
        CASE 
            WHEN COALESCE(s.member_trip_started_count, 0) &gt; 0 
            THEN ROUND((s.sum_duration_member / s.member_trip_started_count)::numeric, 2)
            ELSE NULL 
        END AS avg_duration_member_minutes,
        CASE 
            WHEN COALESCE(s.casual_trip_started_count, 0) &gt; 0 
            THEN ROUND((s.sum_duration_casual / s.casual_trip_started_count)::numeric, 2)
            ELSE NULL 
        END AS avg_duration_casual_minutes
    FROM starts s
    FULL OUTER JOIN ends e 
        ON s.city_sk = e.city_sk 
        AND s.source_station_id = e.source_station_id 
        AND s.date_hour = e.date_hour
)
SELECT 
    c.city_sk,
    c.source_station_id,
    c.date_hour,
    EXTRACT(HOUR FROM c.date_hour)::SMALLINT AS hour_val,
    c.date_hour::DATE AS date_val,
    c.trips_started,
    c.trips_ended,
    c.net_flow,
    c.abs_imbalance,
    c.member_trip_count,
    c.casual_trip_count,
    c.electric_trip_count,
    c.classic_trip_count,
    c.avg_duration_member_minutes,
    c.avg_duration_casual_minutes,
    COALESCE(w.temperature_c, 0.00) AS temperature,
    COALESCE(w.precipitation_mm, 0.00) AS precipitation,
    COALESCE(w.wind_speed_ms, 0.00) AS wind_speed,
    COALESCE(w.weather_category, 'Clear') AS weather_category,
    TRUE AS is_current_const
FROM combined c
LEFT JOIN nds.weather w 
    ON c.city_sk = w.city_sk 
    AND c.date_hour = w.observation_hour
ORDER BY c.city_sk, c.source_station_id, c.date_hour</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>dw-nds</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
