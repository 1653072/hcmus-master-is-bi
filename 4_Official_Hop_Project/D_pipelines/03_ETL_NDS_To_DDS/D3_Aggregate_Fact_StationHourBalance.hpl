      </value>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>460</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DimensionLookup</type>
    <name>Lookup station_sk</name>
    <schema>dds</schema>
    <table>dim_station</table>
    <connection>dw-dds</connection>
    <update>N</update>
    <fields>
      <key>
        <name>city_sk</name>
        <lookup>city_sk</lookup>
      </key>
      <key>
        <name>source_station_id</name>
        <lookup>source_station_id</lookup>
      </key>
      <date>
        <name>date_hour</name>
        <from>effective_from</from>
        <to>effective_to</to>
      </date>
      <return>
        <name>station_sk</name>
        <rename>station_sk</rename>
        <creation_method>autoinc</creation_method>
        <version>version</version>
      </return>
    </fields>
    <commit>100</commit>
    <useBatch>N</useBatch>
    <min_year>1900</min_year>
    <max_year>2199</max_year>
    <cache_size>0</cache_size>
    <use_start_date_alternative>N</use_start_date_alternative>
    <preload_cache>Y</preload_cache>
    <unknown_row_check_disabled>Y</unknown_row_check_disabled>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>640</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Load fact_station_hour_balance</name>
    <connection>dw-dds</connection>
    <schema>dds</schema>
    <table>fact_station_hour_balance</table>
    <commit>5000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>N</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>N</tablename_in_table>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
