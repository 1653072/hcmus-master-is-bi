    <GUI>
      <xloc>640</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>Upsert fact_station_hour_balance</name>
    <connection>dw-dds</connection>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema>dds</schema>
      <table>fact_station_hour_balance</table>
      <key>
        <name>city_sk</name>
        <field>city_sk</field>
        <condition>=</condition>
