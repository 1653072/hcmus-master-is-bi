    <connection>dw-dds</connection>
    <cache>Y</cache>
    <cache_size>0</cache_size>
    <cache_load_all>Y</cache_load_all>
    <lookup>
      <schema>dds</schema>
      <table>dim_datetime</table>
      <key>
        <name>date_val</name>
        <name2/>
        <condition>=</condition>
        <field>date</field>
      </key>
      <key>
        <name>hour_val</name>
        <name2/>
        <condition>=</condition>
        <field>hour</field>
      </key>
      <value>
        <name>datetime_sk</name>
        <rename>datetime_sk</rename>
        <default/>
        <type>Integer</type>
      </value>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>280</xloc>
      <yloc>100</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Lookup weather_condition_sk</name>
    <connection>dw-dds</connection>
    <cache>Y</cache>
    <cache_size>0</cache_size>
    <cache_load_all>Y</cache_load_all>
    <lookup>
      <schema>dds</schema>
      <table>dim_weather_condition</table>
      <key>
        <name>weather_category</name>
        <name2/>
        <condition>=</condition>
