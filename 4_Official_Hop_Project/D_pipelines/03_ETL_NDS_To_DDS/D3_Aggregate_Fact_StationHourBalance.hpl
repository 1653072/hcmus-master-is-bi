  </transform>
  <transform>
    <type>DimensionLookup</type>
    <name>Lookup station_sk</name>
    <schema>dds</schema>
    <table>dim_station</table>
    <connection>dw-dds</connection>
    <update>N</update>
    <fields>
      <key>
        <name>city_sk</name>
        <lookup>city_sk</lookup>
      </key>
      <key>
