        <column_name>total_rows_count</column_name>
      </field>
      <field>
        <stream_name>rows_extracted</stream_name>
        <column_name>success_rows_count</column_name>
      </field>
      <field>
        <stream_name>failed_rows_count</stream_name>
        <column_name>failed_rows_count</column_name>
      </field>
      <field>
        <stream_name>error_message</stream_name>
        <column_name>error_message</column_name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>896</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Get rows loaded</from>
      <to>Compute audit values</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Compute audit values</from>
      <to>Update control.etl_extraction_control</to>
