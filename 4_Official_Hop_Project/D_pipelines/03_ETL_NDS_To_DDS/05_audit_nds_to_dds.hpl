<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>05_audit_nds_to_dds</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Audits NDS to DDS job: updates control.etl_extraction_control and inserts log into control.etl_job_log.</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/17 15:30:25.502</created_date>
    <modified_date>2026/07/17 15:30:25.502</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Get rows loaded</name>
    <sql>SELECT
  'nds_to_dds' AS source_name,
  'fact_station_hour_balance' AS table_name,
  COUNT(*)::INTEGER AS rows_extracted
FROM dds.fact_station_hour_balance
WHERE loaded_at >= TO_TIMESTAMP('${ETL_NDS_TO_DDS_STARTED_AT}', 'YYYY-MM-DD HH24:MI:SS.MS')</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>dw-dds</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>144</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>Compute audit values</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var job_name = "nds_to_dds_job";
var status = "SUCCESS";
var finished_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());

var started_at_str = getVariable("ETL_NDS_TO_DDS_STARTED_AT", null);
var started_at = null;
if (started_at_str != null &amp;&amp; started_at_str.length > 0) {
  try {
    started_at = Packages.java.sql.Timestamp.valueOf(started_at_str);
  } catch(e) {
    started_at = finished_at;
  }
} else {
  started_at = finished_at;
}

var lset_str = getVariable("LSET_NDS_TO_DDS", "2026-01-01 00:00:00.0");
var cet_str = getVariable("CET_NDS_TO_DDS", started_at_str);

var lset_value = Packages.java.sql.Timestamp.valueOf(lset_str);
var cet_value = Packages.java.sql.Timestamp.valueOf(cet_str);

var failed_rows_count = 0;
var error_message = "";
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>job_name</name>
        <rename>job_name</rename>
        <type>String</type>
        <length>100</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>status</name>
        <rename>status</rename>
        <type>String</type>
        <length>20</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>started_at</name>
        <rename>started_at</rename>
        <type>Timestamp</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>finished_at</name>
        <rename>finished_at</rename>
        <type>Timestamp</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>lset_value</name>
        <rename>lset_value</rename>
        <type>Timestamp</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>cet_value</name>
        <rename>cet_value</rename>
        <type>Timestamp</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>failed_rows_count</name>
        <rename>failed_rows_count</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>error_message</name>
        <rename>error_message</rename>
        <type>String</type>
        <length>500</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>384</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>Update control.etl_extraction_control</name>
    <lookup>
      <key>
        <name>source_name</name>
        <field>source_name</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>table_name</name>
        <field>table_name</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>lset</name>
        <rename>lset_value</rename>
        <update>Y</update>
      </value>
      <value>
        <name>cet</name>
        <rename>cet_value</rename>
        <update>Y</update>
      </value>
      <value>
        <name>last_run_status</name>
        <rename>status</rename>
        <update>Y</update>
      </value>
      <value>
        <name>rows_extracted</name>
        <rename>rows_extracted</rename>
        <update>Y</update>
      </value>
      <value>
        <name>updated_at</name>
        <rename>finished_at</rename>
        <update>Y</update>
      </value>
      <schema>control</schema>
      <table>etl_extraction_control</table>
    </lookup>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <connection>dw-control</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>640</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Log to control.etl_job_log</name>
    <connection>dw-control</connection>
    <schema>control</schema>
    <table>etl_job_log</table>
    <commit>5000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>N</partitioning_monthly>
