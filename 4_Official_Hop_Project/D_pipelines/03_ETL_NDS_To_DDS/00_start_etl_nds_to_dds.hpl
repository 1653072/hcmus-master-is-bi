<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>00_start_etl_nds_to_dds</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Reads NDS to DDS watermarks (LSET/CET) from control database and sets JVM variables.</description>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read nds_to_dds watermarks</name>
    <sql>SELECT
  TO_CHAR(COALESCE(cet, TIMESTAMP '2026-01-01 00:00:00'), 'YYYY-MM-DD HH24:MI:SS.MS') AS lset_value,
  TO_CHAR(CURRENT_TIMESTAMP, 'YYYY-MM-DD HH24:MI:SS.MS') AS cet_value
FROM control.etl_extraction_control
WHERE source_name = 'nds_to_dds' AND table_name = 'fact_station_hour_balance'</sql>
    <limit>1</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>dw-control</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>144</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Set JVM variables</name>
    <fields>
      <field>
        <field_name>lset_value</field_name>
        <variable_name>LSET_NDS_TO_DDS</variable_name>
        <variable_type>JVM</variable_type>
        <default_value>2026-01-01 00:00:00.000</default_value>
      </field>
      <field>
        <field_name>cet_value</field_name>
        <variable_name>CET_NDS_TO_DDS</variable_name>
        <variable_type>JVM</variable_type>
        <default_value>2026-01-01 00:00:00.000</default_value>
      </field>
      <field>
        <field_name>cet_value</field_name>
        <variable_name>ETL_NDS_TO_DDS_STARTED_AT</variable_name>
        <variable_type>JVM</variable_type>
        <default_value>2026-01-01 00:00:00.000</default_value>
      </field>
    </fields>
    <use_formatting>N</use_formatting>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>384</xloc>
      <yloc>112</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Read nds_to_dds watermarks</from>
      <to>Set JVM variables</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
