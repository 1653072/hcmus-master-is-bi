<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>04_data_leakage_check</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Performs automated data leakage checks for NDS to DDS integration.</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/17 00:00:00.000</created_date>
    <modified_date>2026/07/17 00:00:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read NDS Trip Counts</name>
    <sql>SELECT 
    COUNT(*) FILTER (WHERE start_station_sk IS NOT NULL) AS nds_trips_started,
    COUNT(*) FILTER (WHERE end_station_sk IS NOT NULL AND ended_at IS NOT NULL) AS nds_trips_ended
FROM nds.trip
WHERE loaded_at > '${LSET_NDS_TO_DDS}'::TIMESTAMP AND loaded_at &lt;= '${CET_NDS_TO_DDS}'::TIMESTAMP</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>dw-nds</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>160</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableInput</type>
    <name>Read DDS Fact Counts</name>
    <sql>SELECT 
    COALESCE(SUM(trips_started), 0) AS dds_trips_started,
    COALESCE(SUM(trips_ended), 0) AS dds_trips_ended
FROM dds.fact_station_hour_balance
WHERE loaded_at >= TO_TIMESTAMP('${ETL_NDS_TO_DDS_STARTED_AT}', 'YYYY-MM-DD HH24:MI:SS.MS')</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>dw-dds</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>160</xloc>
      <yloc>208</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>JoinRows</type>
    <name>Join Counts</name>
    <directory>%%java.io.tmpdir%%</directory>
    <prefix>out</prefix>
    <cache_size>500</cache_size>
    <main/>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue/>
        <function>=</function>
        <rightvalue/>
        <conditions/>
      </condition>
    </compare>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>336</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>Calculate Diff</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>script</jsScript_name>
        <jsScript_script>var diff_started = Math.abs(nds_trips_started - dds_trips_started);
var diff_ended = Math.abs(nds_trips_ended - dds_trips_ended);
var status_started = diff_started == 0 ? "OK" : "LEAK";
var status_ended = diff_ended == 0 ? "OK" : "LEAK";
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>diff_started</name>
        <rename>diff_started</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>diff_ended</name>
        <rename>diff_ended</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>status_started</name>
        <rename>status_started</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>status_ended</name>
        <rename>status_ended</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>480</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Filter discrepancies</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <function>=</function>
        <conditions>
          <condition>
            <negated>N</negated>
            <operator>-</operator>
            <leftvalue>diff_started</leftvalue>
            <function>&gt;</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>0</text>
              <length>-1</length>
              <precision>0</precision>
              <isnull>N</isnull>
            </value>
            <conditions/>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>OR</operator>
            <leftvalue>diff_ended</leftvalue>
            <function>&gt;</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>Integer</type>
              <text>0</text>
              <length>-1</length>
              <precision>0</precision>
              <isnull>N</isnull>
            </value>
            <conditions/>
          </condition>
        </conditions>
      </condition>
    </compare>
    <send_true_to>Log discrepancies</send_true_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>640</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Log discrepancies</name>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>WARNING: DATA LEAKAGE DETECTED in Fact Aggregation!
Trip counts do not match between NDS and DDS.</logmessage>
    <fields>
      <field>
        <name>nds_trips_started</name>
      </field>
      <field>
        <name>dds_trips_started</name>
      </field>
      <field>
        <name>diff_started</name>
      </field>
      <field>
        <name>nds_trips_ended</name>
      </field>
      <field>
        <name>dds_trips_ended</name>
      </field>
      <field>
        <name>diff_ended</name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>800</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableInput</type>
    <name>Read NDS Active Station-Hours</name>
    <sql>SELECT DISTINCT
    city_sk,
    source_station_id,
    date_hour,
    date_hour::DATE AS date_val,
    EXTRACT(HOUR FROM date_hour)::INTEGER AS hour_val
FROM (
    SELECT 
        city_sk,
        start_station_id AS source_station_id,
        DATE_TRUNC('hour', started_at) AS date_hour
    FROM nds.trip
    WHERE start_station_sk IS NOT NULL
      AND loaded_at > '${LSET_NDS_TO_DDS}'::TIMESTAMP AND loaded_at &lt;= '${CET_NDS_TO_DDS}'::TIMESTAMP
    UNION
    SELECT 
        city_sk,
        end_station_id AS source_station_id,
        DATE_TRUNC('hour', ended_at) AS date_hour
    FROM nds.trip
    WHERE end_station_sk IS NOT NULL AND ended_at IS NOT NULL
      AND loaded_at > '${LSET_NDS_TO_DDS}'::TIMESTAMP AND loaded_at &lt;= '${CET_NDS_TO_DDS}'::TIMESTAMP
) q</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <connection>dw-nds</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>144</xloc>
      <yloc>352</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DimensionLookup</type>
    <name>Lookup station_sk</name>
    <schema>dds</schema>
    <table>dim_station</table>
    <connection>dw-dds</connection>
    <update>N</update>
    <fields>
      <key>
        <name>city_sk</name>
        <lookup>city_sk</lookup>
      </key>
      <key>
        <name>source_station_id</name>
        <lookup>source_station_id</lookup>
      </key>
      <date>
        <name>date_hour</name>
        <from>effective_from</from>
        <to>effective_to</to>
      </date>
      <return>
        <name>station_sk</name>
        <rename>station_sk</rename>
        <creation_method>autoinc</creation_method>
        <version>version</version>
      </return>
    </fields>
    <commit>100</commit>
    <useBatch>N</useBatch>
    <min_year>1900</min_year>
    <max_year>2199</max_year>
    <cache_size>0</cache_size>
    <use_start_date_alternative>N</use_start_date_alternative>
    <preload_cache>Y</preload_cache>
    <unknown_row_check_disabled>Y</unknown_row_check_disabled>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>336</xloc>
      <yloc>352</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Lookup datetime_sk</name>
    <connection>dw-dds</connection>
    <cache>Y</cache>
    <cache_size>0</cache_size>
    <cache_load_all>Y</cache_load_all>
    <lookup>
      <schema>dds</schema>
      <table>dim_datetime</table>
      <key>
        <name>date_val</name>
        <name2/>
        <condition>=</condition>
        <field>date</field>
      </key>
      <key>
        <name>hour_val</name>
        <name2/>
        <condition>=</condition>
        <field>hour</field>
      </key>
      <value>
        <name>datetime_sk</name>
        <rename>datetime_sk</rename>
        <default/>
        <type>Integer</type>
      </value>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>496</xloc>
      <yloc>352</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Check fact table existence</name>
    <connection>dw-dds</connection>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <cache_load_all>N</cache_load_all>
    <lookup>
      <schema>dds</schema>
      <table>fact_station_hour_balance</table>
      <key>
        <name>station_sk</name>
        <name2/>
        <condition>=</condition>
        <field>station_sk</field>
      </key>
      <key>
        <name>datetime_sk</name>
        <name2/>
        <condition>=</condition>
        <field>datetime_sk</field>
      </key>
      <value>
        <name>station_hour_balance_sk</name>
        <rename>fact_sk</rename>
        <default/>
        <type>Integer</type>
      </value>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>688</xloc>
      <yloc>352</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Filter missing rows</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>fact_sk</leftvalue>
        <function>IS NULL</function>
        <rightvalue/>
        <conditions/>
      </condition>
    </compare>
    <send_true_to>Log missing rows</send_true_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>864</xloc>
      <yloc>352</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>WriteToLog</type>
    <name>Log missing rows</name>
    <displayHeader>Y</displayHeader>
    <limitRows>N</limitRows>
    <limitRowsNumber>0</limitRowsNumber>
    <logmessage>ERROR: DROPPED FACT RECORD DETECTED!
Station-Hour combination exists in NDS trips but was not written to fact_station_hour_balance.</logmessage>
    <loglevel>Error</loglevel>
    <fields>
      <field>
        <name>city_sk</name>
      </field>
      <field>
        <name>source_station_id</name>
      </field>
      <field>
        <name>date_hour</name>
      </field>
      <field>
        <name>station_sk</name>
      </field>
      <field>
        <name>datetime_sk</name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1040</xloc>
      <yloc>352</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Read NDS Trip Counts</from>
      <to>Join Counts</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read DDS Fact Counts</from>
      <to>Join Counts</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Join Counts</from>
      <to>Calculate Diff</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Calculate Diff</from>
      <to>Filter discrepancies</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Filter discrepancies</from>
      <to>Log discrepancies</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read NDS Active Station-Hours</from>
      <to>Lookup station_sk</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup station_sk</from>
      <to>Lookup datetime_sk</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup datetime_sk</from>
      <to>Check fact table existence</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check fact table existence</from>
      <to>Filter missing rows</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Filter missing rows</from>
      <to>Log missing rows</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
