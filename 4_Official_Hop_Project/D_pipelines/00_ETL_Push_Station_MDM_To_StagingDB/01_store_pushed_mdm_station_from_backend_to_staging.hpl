  <transform>
    <type>ScriptValueMod</type>
    <name>Validate reconcile and build response</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var http_status = 200;
var response_json = "";
var operation = be_operation;
var loaded_at = null;
var allowedOps = getVariable("HOP_MDM_ALLOWED_OPERATIONS", "INSERT,UPDATE,DELETE");

function hasOp(op) {
  return allowedOps.indexOf(op) >= 0;
}

function blank(v) {
  return v == null || String(v).trim().length == 0;
}

if (!be_operation || !hasOp(String(be_operation))) {
  http_status = 400;
  response_json = JSON.stringify({ status: "ERROR", message: "Invalid operation" });
} else if (blank(source_city_code) || (String(source_city_code) != "CHI" &amp;&amp; String(source_city_code) != "NYC")) {
  http_status = 400;
  response_json = JSON.stringify({ status: "ERROR", message: "Invalid source_city_code" });
} else if (blank(short_name)) {
  http_status = 400;
  response_json = JSON.stringify({ status: "ERROR", message: "Invalid station's short_name" });
} else if (city_sk == null || String(city_sk).length == 0) {
  http_status = 400;
  response_json = JSON.stringify({ status: "ERROR", message: "Unknown source_city_code in NDS city" });
}

if (http_status == 200 &amp;&amp; blank(station_status)) {
  station_status = "open";
}

var exists_in_nds = (nds_station_sk != null &amp;&amp; nds_station_sk != undefined &amp;&amp; String(nds_station_sk).length > 0);

if (http_status == 200) {
  if (be_operation == "INSERT" || be_operation == "UPDATE") {
    operation = exists_in_nds ? "UPDATE" : "INSERT";
  } else if (be_operation == "DELETE") {
    if (!exists_in_nds) {
      http_status = 404;
      response_json = JSON.stringify({ status: "ERROR", message: "Station not found in NDS" });
    } else {
      operation = "DELETE";
    }
  }
}

var Timestamp = Packages.java.sql.Timestamp;
var Instant = Packages.java.time.Instant;

if (http_status == 200) {
  loaded_at = Timestamp.from(Instant.now());
  response_json = JSON.stringify({
    status: "ACCEPTED",
    source_city_code: String(source_city_code),
    short_name: String(short_name),
    operation: String(operation)
  });
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>operation</name>
        <rename>operation</rename>
        <type>String</type>
        <length>10</length>
        <precision>-1</precision>
        <replace>N</replace>
