<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><pipeline_type>Normal</pipeline_type><pipeline_status>-1</pipeline_status><parameters/><name>03_load_noaa_weather_to_staging</name><name_sync_with_filename>Y</name_sync_with_filename></info>
  <transform>
    <type>TextFileInput2</type><name>Read NOAA LCD v2 filtered CSV files</name><file_type>CSV</file_type><compression>None</compression><separator>,</separator><enclosure>"</enclosure><header>Y</header><nr_headerlines>1</nr_headerlines><noempty>Y</noempty><include>Y</include><include_field>source_file</include_field><format>DOS</format><encoding>UTF-8</encoding><limit>0</limit><date_format_lenient>Y</date_format_lenient><date_format_locale>en_US</date_format_locale>
    <files><file><name>${NOAA_LCD_CHICAGO}</name><filemask/><exclude_filemask/><file_required>Y</file_required><include_subfolders>N</include_subfolders></file><file><name>${NOAA_LCD_NYC}</name><filemask/><exclude_filemask/><file_required>Y</file_required><include_subfolders>N</include_subfolders></file></files>
    <fields><field><name>noaa_station_id</name><type>String</type><position>-1</position><length>20</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>date_raw</name><type>String</type><position>-1</position><length>40</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>latitude_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>longitude_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>elevation_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>station_name_raw</name><type>String</type><position>-1</position><length>200</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>report_type</name><type>String</type><position>-1</position><length>20</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>source_raw</name><type>String</type><position>-1</position><length>20</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>hourly_altimeter_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>hourly_dewpoint_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>hourly_dry_bulb_temperature_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>hourly_precipitation_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>hourly_present_weather_type</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>hourly_pressure_change_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>hourly_pressure_tendency_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>hourly_relative_humidity_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>hourly_sky_conditions_raw</name><type>String</type><position>-1</position><length>200</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>hourly_sea_level_pressure_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>hourly_station_pressure_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>hourly_visibility_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>hourly_wet_bulb_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>hourly_wind_direction_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>hourly_wind_gust_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field><field><name>hourly_wind_speed_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field></fields>
    <GUI><xloc>96</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>ScriptValueMod</type><name>Clean NOAA hourly weather fields</name>
    <jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>process</jsScript_name><jsScript_script>var source_city_code = String(noaa_station_id) == "USW00014819" ? "CHI" : "NYC";
var loaded_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());
function blankToNull(v) { if (v == null) return null; var s = String(v).trim(); return s.length == 0 ? null : s; }
function toNumber(v) { var s = blankToNull(v); if (s == null || s == "T") return null; s = s.replace(/[^0-9\.\-]/g, ""); return s.length == 0 ? null : java.lang.Double.valueOf(s); }
function toTimestamp(v) { var s = blankToNull(v); if (s == null) return null; var fmt = new java.text.SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss"); return new Packages.java.sql.Timestamp(fmt.parse(s).getTime()); }
var is_hourly = String(report_type).indexOf("FM-") == 0;
observation_ts = is_hourly ? toTimestamp(date_raw) : null;
hourly_dry_bulb_temperature = toNumber(hourly_dry_bulb_temperature_raw);
hourly_precipitation = toNumber(hourly_precipitation_raw);
hourly_wind_speed = toNumber(hourly_wind_speed_raw);
hourly_present_weather_type = blankToNull(hourly_present_weather_type);</jsScript_script></jsScript></jsScripts>
    <fields><field><name>source_city_code</name><rename>source_city_code</rename><type>String</type><length>10</length><precision>-1</precision><replace>N</replace></field><field><name>observation_ts</name><rename>observation_ts</rename><type>Timestamp</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>hourly_dry_bulb_temperature</name><rename>hourly_dry_bulb_temperature</rename><type>Number</type><length>8</length><precision>2</precision><replace>N</replace></field><field><name>hourly_precipitation</name><rename>hourly_precipitation</rename><type>Number</type><length>10</length><precision>2</precision><replace>N</replace></field><field><name>hourly_wind_speed</name><rename>hourly_wind_speed</rename><type>Number</type><length>8</length><precision>2</precision><replace>N</replace></field><field><name>loaded_at</name><rename>loaded_at</rename><type>Timestamp</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields>
    <optimizationLevel>9</optimizationLevel><GUI><xloc>352</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>FilterRows</type><name>Keep REPORT_TYPE FM-15/FM-16/FM-12 hourly rows</name><compare><condition><negated>N</negated><operator>-</operator><leftvalue>observation_ts</leftvalue><function>IS NOT NULL</function><rightvalue/><conditions/></condition></compare><send_true_to>Upsert staging.stg_weather</send_true_to><send_false_to/><GUI><xloc>608</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>InsertUpdate</type><name>Upsert staging.stg_weather</name><lookup><key><name>source_city_code</name><field>source_city_code</field><condition>=</condition><name2/></key><key><name>observation_ts</name><field>observation_ts</field><condition>=</condition><name2/></key><value><name>source_city_code</name><rename>source_city_code</rename><update>Y</update></value><value><name>noaa_station_id</name><rename>noaa_station_id</rename><update>Y</update></value><value><name>observation_ts</name><rename>observation_ts</rename><update>Y</update></value><value><name>report_type</name><rename>report_type</rename><update>Y</update></value><value><name>hourly_dry_bulb_temperature</name><rename>hourly_dry_bulb_temperature</rename><update>Y</update></value><value><name>hourly_precipitation</name><rename>hourly_precipitation</rename><update>Y</update></value><value><name>hourly_wind_speed</name><rename>hourly_wind_speed</rename><update>Y</update></value><value><name>hourly_present_weather_type</name><rename>hourly_present_weather_type</rename><update>Y</update></value><value><name>loaded_at</name><rename>loaded_at</rename><update>Y</update></value><schema>staging</schema><table>stg_weather</table></lookup><commit>1000</commit><update_bypassed>N</update_bypassed><connection>dw-staging</connection><GUI><xloc>864</xloc><yloc>80</yloc></GUI>
  </transform>
  <order><hop><from>Read NOAA LCD v2 filtered CSV files</from><to>Clean NOAA hourly weather fields</to><enabled>Y</enabled></hop><hop><from>Clean NOAA hourly weather fields</from><to>Keep REPORT_TYPE FM-15/FM-16/FM-12 hourly rows</to><enabled>Y</enabled></hop><hop><from>Keep REPORT_TYPE FM-15/FM-16/FM-12 hourly rows</from><to>Upsert staging.stg_weather</to><enabled>Y</enabled></hop></order>
  <notepads/><attributes/><transform_error_handling/>
</pipeline>
