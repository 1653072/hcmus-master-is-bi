<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><pipeline_type>Normal</pipeline_type><pipeline_status>-1</pipeline_status><parameters/><name>02_load_citibike_trips_to_staging</name><name_sync_with_filename>Y</name_sync_with_filename></info>
  <transform>
    <type>TextFileInput2</type><name>Read Citi Bike trip CSV files</name><file_type>CSV</file_type><compression>None</compression><separator>,</separator><enclosure>"</enclosure><header>Y</header><nr_headerlines>1</nr_headerlines><noempty>Y</noempty><include>Y</include><include_field>source_file</include_field><format>UNIX</format><encoding>UTF-8</encoding><limit>0</limit><date_format_lenient>Y</date_format_lenient><date_format_locale>en_US</date_format_locale>
    <files><file><name>${CITIBIKE_TRIPS_DIR}/</name><filemask>[0-9]{6}.*\.csv</filemask><exclude_filemask/><file_required>Y</file_required><include_subfolders>Y</include_subfolders></file></files>
    <fields>
      <field><name>ride_id</name><type>String</type><position>-1</position><length>64</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>rideable_type</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>started_at_raw</name><type>String</type><position>-1</position><length>40</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>ended_at_raw</name><type>String</type><position>-1</position><length>40</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>start_station_name</name><type>String</type><position>-1</position><length>500</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>start_station_id</name><type>String</type><position>-1</position><length>100</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>end_station_name</name><type>String</type><position>-1</position><length>500</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>end_station_id</name><type>String</type><position>-1</position><length>100</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>start_lat_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>start_lng_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>end_lat_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>end_lng_raw</name><type>String</type><position>-1</position><length>50</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
      <field><name>member_casual</name><type>String</type><position>-1</position><length>20</length><precision>-1</precision><trim_type>both</trim_type><repeat>N</repeat></field>
    </fields><GUI><xloc>96</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>ScriptValueMod</type><name>Clean Citi Bike staging fields</name>
    <jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>process</jsScript_name><jsScript_script>var source_city_code = "NYC";
var trip_month = null;
var loaded_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());
function blankToNull(v) { if (v == null) return null; var s = String(v).trim(); return s.length == 0 ? null : s; }
function toTimestamp(v) { var s = blankToNull(v); if (s == null) return null; var p = s.split("."); var fmt = new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss"); return new Packages.java.sql.Timestamp(fmt.parse(p[0]).getTime()); }
function toNumber(v) { var s = blankToNull(v); return s == null ? null : java.lang.Double.valueOf(s); }
ride_id = blankToNull(ride_id); rideable_type = blankToNull(rideable_type); started_at = toTimestamp(started_at_raw); ended_at = toTimestamp(ended_at_raw);
start_station_name = blankToNull(start_station_name); start_station_id = blankToNull(start_station_id); end_station_name = blankToNull(end_station_name); end_station_id = blankToNull(end_station_id);
start_lat = toNumber(start_lat_raw); start_lng = toNumber(start_lng_raw); end_lat = toNumber(end_lat_raw); end_lng = toNumber(end_lng_raw); member_casual = blankToNull(member_casual);
var m = String(source_file).match(/(20[0-9]{4})/); trip_month = m == null ? null : m[1];</jsScript_script></jsScript></jsScripts>
    <fields><field><name>source_city_code</name><rename>source_city_code</rename><type>String</type><length>10</length><precision>-1</precision><replace>N</replace></field><field><name>started_at</name><rename>started_at</rename><type>Timestamp</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>ended_at</name><rename>ended_at</rename><type>Timestamp</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>start_lat</name><rename>start_lat</rename><type>Number</type><length>12</length><precision>8</precision><replace>N</replace></field><field><name>start_lng</name><rename>start_lng</rename><type>Number</type><length>12</length><precision>8</precision><replace>N</replace></field><field><name>end_lat</name><rename>end_lat</rename><type>Number</type><length>12</length><precision>8</precision><replace>N</replace></field><field><name>end_lng</name><rename>end_lng</rename><type>Number</type><length>12</length><precision>8</precision><replace>N</replace></field><field><name>trip_month</name><rename>trip_month</rename><type>String</type><length>6</length><precision>-1</precision><replace>N</replace></field><field><name>loaded_at</name><rename>loaded_at</rename><type>Timestamp</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields>
    <optimizationLevel>9</optimizationLevel><GUI><xloc>352</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>InsertUpdate</type><name>Upsert staging.stg_citibike_trips</name><lookup>
      <key><name>source_city_code</name><field>source_city_code</field><condition>=</condition><name2/></key><key><name>ride_id</name><field>ride_id</field><condition>=</condition><name2/></key>
      <value><name>ride_id</name><rename>ride_id</rename><update>Y</update></value><value><name>rideable_type</name><rename>rideable_type</rename><update>Y</update></value><value><name>started_at</name><rename>started_at</rename><update>Y</update></value><value><name>ended_at</name><rename>ended_at</rename><update>Y</update></value><value><name>start_station_name</name><rename>start_station_name</rename><update>Y</update></value><value><name>start_station_id</name><rename>start_station_id</rename><update>Y</update></value><value><name>end_station_name</name><rename>end_station_name</rename><update>Y</update></value><value><name>end_station_id</name><rename>end_station_id</rename><update>Y</update></value><value><name>start_lat</name><rename>start_lat</rename><update>Y</update></value><value><name>start_lng</name><rename>start_lng</rename><update>Y</update></value><value><name>end_lat</name><rename>end_lat</rename><update>Y</update></value><value><name>end_lng</name><rename>end_lng</rename><update>Y</update></value><value><name>member_casual</name><rename>member_casual</rename><update>Y</update></value><value><name>source_city_code</name><rename>source_city_code</rename><update>Y</update></value><value><name>trip_month</name><rename>trip_month</rename><update>Y</update></value><value><name>source_file</name><rename>source_file</rename><update>Y</update></value><value><name>loaded_at</name><rename>loaded_at</rename><update>Y</update></value>
      <schema>staging</schema><table>stg_citibike_trips</table></lookup><commit>1000</commit><update_bypassed>N</update_bypassed><connection>dw-staging</connection><GUI><xloc>624</xloc><yloc>80</yloc></GUI>
  </transform>
  <order><hop><from>Read Citi Bike trip CSV files</from><to>Clean Citi Bike staging fields</to><enabled>Y</enabled></hop><hop><from>Clean Citi Bike staging fields</from><to>Upsert staging.stg_citibike_trips</to><enabled>Y</enabled></hop></order>
  <notepads/><attributes/><transform_error_handling/>
</pipeline>
