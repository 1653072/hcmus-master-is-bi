    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>03_load_weather_to_nds</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Visible Hop load from staging.stg_weather into nds.weather with weather_category and city/hour dedupe.</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/12 21:52:02.772</created_date>
    <modified_date>2026/07/12 21:52:02.772</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read staging.stg_weather deduped</name>
    <sql>WITH weather_ranked AS (
  SELECT
    source_city_code,
    date_trunc('hour', observation_ts) AS observation_hour,
    report_type,
    hourly_dry_bulb_temperature AS temperature_c,
    hourly_precipitation AS precipitation_mm,
    hourly_wind_speed AS wind_speed_ms,
    hourly_present_weather_type AS present_weather,
    CASE
      WHEN UPPER(COALESCE(hourly_present_weather_type, '')) LIKE '%SN%'
        OR UPPER(COALESCE(hourly_present_weather_type, '')) LIKE '%SG%'
        OR UPPER(COALESCE(hourly_present_weather_type, '')) LIKE '%PL%'
        THEN 'Snow'
      WHEN UPPER(COALESCE(hourly_present_weather_type, '')) LIKE '%FG%'
        OR UPPER(COALESCE(hourly_present_weather_type, '')) LIKE '%BR%'
        OR UPPER(COALESCE(hourly_present_weather_type, '')) LIKE '%HZ%'
        THEN 'Fog'
      WHEN UPPER(COALESCE(hourly_present_weather_type, '')) LIKE '%RA%'
        OR UPPER(COALESCE(hourly_present_weather_type, '')) LIKE '%DZ%'
        OR UPPER(COALESCE(hourly_present_weather_type, '')) LIKE '%TS%'
        OR UPPER(COALESCE(hourly_present_weather_type, '')) LIKE '%GR%'
        OR COALESCE(hourly_precipitation, 0) > 0
        THEN 'Rain'
      ELSE 'Clear'
    END AS weather_category,
    ROW_NUMBER() OVER (
      PARTITION BY source_city_code, date_trunc('hour', observation_ts)
      ORDER BY CASE report_type WHEN 'FM-15' THEN 1 WHEN 'FM-16' THEN 2 WHEN 'FM-12' THEN 3 ELSE 4 END,
               observation_ts
    ) AS rn
  FROM staging.stg_weather
  WHERE observation_ts IS NOT NULL
)
SELECT source_city_code, observation_hour, report_type, temperature_c,
       precipitation_mm, wind_speed_ms, present_weather, weather_category
FROM weather_ranked
WHERE rn = 1</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>dw-staging</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>160</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Lookup nds.city by source_city_code</name>
    <connection>dw-nds</connection>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <cache_load_all>N</cache_load_all>
    <lookup>
      <schema>nds</schema>
      <table>city</table>
      <key>
        <name>source_city_code</name>
        <name2/>
        <condition>=</condition>
        <field>city_code</field>
      </key>
      <value>
        <name>city_sk</name>
        <rename>city_sk</rename>
        <default/>
