    </lookup>
    <commit>1000</commit>
    <update_bypassed>N</update_bypassed>
    <connection>dw-nds</connection>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>160</xloc>
      <yloc>528</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Read staging.stg_weather deduped</from>
      <to>Lookup nds.city by source_city_code</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup nds.city by source_city_code</from>
