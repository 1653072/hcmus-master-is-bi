      </value>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>160</xloc>
      <yloc>240</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>Set loaded_at NOW</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var loaded_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>loaded_at</name>
        <rename>loaded_at</rename>
        <type>Timestamp</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>160</xloc>
      <yloc>384</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>Upsert nds.weather</name>
    <lookup>
      <key>
        <name>city_sk</name>
        <field>city_sk</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>observation_hour</name>
        <field>observation_hour</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>city_sk</name>
        <rename>city_sk</rename>
        <update>N</update>
      </value>
      <value>
        <name>observation_hour</name>
        <rename>observation_hour</rename>
        <update>N</update>
      </value>
      <value>
        <name>report_type</name>
        <rename>report_type</rename>
        <update>Y</update>
      </value>
      <value>
        <name>temperature_c</name>
        <rename>temperature_c</rename>
        <update>Y</update>
      </value>
      <value>
        <name>precipitation_mm</name>
        <rename>precipitation_mm</rename>
