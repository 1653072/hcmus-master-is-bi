  <transform>
    <type>ScriptValueMod</type>
    <name>Mark pending master trips</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>// Pending only when station_id is present but no station_sk exists (including historical SCD rows).
var startId = start_station_id == null ? "" : String(start_station_id).trim();
var endId = end_station_id == null ? "" : String(end_station_id).trim();
var startPending = startId.length > 0 &amp;&amp; (start_station_sk == null || String(start_station_sk).length == 0);
var endPending = endId.length > 0 &amp;&amp; (end_station_sk == null || String(end_station_sk).length == 0);
var is_pending_master = (startPending || endPending) ? 1 : 0;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>is_pending_master</name>
        <rename>is_pending_master</rename>
        <type>Integer</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>176</xloc>
      <yloc>848</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Is resolvable trips?</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>is_pending_master</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>Integer</type>
          <text>0</text>
          <length>-1</length>
          <precision>0</precision>
          <isnull>N</isnull>
          <mask>#</mask>
        </value>
        <conditions/>
      </condition>
    </compare>
    <send_true_to>Upsert nds.trip</send_true_to>
    <send_false_to>Keep pending trips in staging due to empty master start/end_station_sk</send_false_to>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>176</xloc>
      <yloc>992</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Keep pending trips in staging due to empty master start/end_station_sk</name>
    <distribute>N</distribute>
