<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><pipeline_type>Normal</pipeline_type><pipeline_status>-1</pipeline_status><parameters/><name>04_load_trips_to_nds</name><name_sync_with_filename>Y</name_sync_with_filename><description>Hop-native trip load: staging input, city/station lookups scoped by city, then InsertUpdate into nds.trip.</description></info>
  <transform>
    <type>TableInput</type><name>Read deduplicated staging trips</name><connection>dw-staging</connection>
    <sql><![CDATA[WITH source_rows AS (
  SELECT source_city_code, ride_id, rideable_type, started_at, ended_at, start_station_id, end_station_id, start_lat, start_lng, end_lat, end_lng, member_casual, trip_month, source_file FROM staging.stg_divvy_trips WHERE ride_id IS NOT NULL AND started_at IS NOT NULL
  UNION ALL
  SELECT source_city_code, ride_id, rideable_type, started_at, ended_at, start_station_id, end_station_id, start_lat, start_lng, end_lat, end_lng, member_casual, trip_month, source_file FROM staging.stg_citibike_trips WHERE ride_id IS NOT NULL AND started_at IS NOT NULL
), deduplicated AS (
  SELECT DISTINCT ON (source_city_code, ride_id) * FROM source_rows WHERE source_city_code IS NOT NULL ORDER BY source_city_code, ride_id, source_file
)
SELECT *, TRUE AS is_current,
 CASE WHEN ended_at IS NOT NULL AND ended_at >= started_at THEN ROUND((EXTRACT(EPOCH FROM ended_at-started_at)/60.0)::NUMERIC,2) ELSE NULL END AS duration_minutes
FROM deduplicated]]></sql><limit>0</limit><execute_each_row>N</execute_each_row><variables_active>N</variables_active><lookup/><sql_from_file/><GUI><xloc>96</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform><type>DBLookup</type><name>Lookup city_sk</name><connection>dw-nds</connection><cache>N</cache><lookup><schema>nds</schema><table>city</table><key><name>source_city_code</name><field>city_code</field><condition>=</condition><name2/></key><value><name>city_sk</name><rename>city_sk</rename><default/><type>Integer</type></value></lookup><GUI><xloc>320</xloc><yloc>96</yloc></GUI></transform>
  <transform><type>FilterRows</type><name>Keep mapped cities</name><send_true_to/><send_false_to/><compare><condition><negated>N</negated><leftvalue>city_sk</leftvalue><function>IS NOT NULL</function><rightvalue/></condition></compare><GUI><xloc>512</xloc><yloc>96</yloc></GUI></transform>
  <transform><type>DBLookup</type><name>Lookup start_station_sk</name><connection>dw-nds</connection><cache>N</cache><lookup><schema>nds</schema><table>station</table><key><name>city_sk</name><field>city_sk</field><condition>=</condition><name2/></key><key><name>start_station_id</name><field>source_station_id</field><condition>=</condition><name2/></key><key><name>is_current</name><field>is_current</field><condition>=</condition><name2/></key><value><name>station_sk</name><rename>start_station_sk</rename><default/><type>Integer</type></value></lookup><GUI><xloc>704</xloc><yloc>96</yloc></GUI></transform>
  <transform><type>DBLookup</type><name>Lookup end_station_sk</name><connection>dw-nds</connection><cache>N</cache><lookup><schema>nds</schema><table>station</table><key><name>city_sk</name><field>city_sk</field><condition>=</condition><name2/></key><key><name>end_station_id</name><field>source_station_id</field><condition>=</condition><name2/></key><key><name>is_current</name><field>is_current</field><condition>=</condition><name2/></key><value><name>station_sk</name><rename>end_station_sk</rename><default/><type>Integer</type></value></lookup><GUI><xloc>896</xloc><yloc>96</yloc></GUI></transform>
  <transform><type>InsertUpdate</type><name>Upsert nds.trip</name><connection>dw-nds</connection><lookup><key><name>city_sk</name><field>city_sk</field><condition>=</condition><name2/></key><key><name>ride_id</name><field>ride_id</field><condition>=</condition><name2/></key><value><name>city_sk</name><rename>city_sk</rename><update>N</update></value><value><name>ride_id</name><rename>ride_id</rename><update>N</update></value><value><name>rideable_type</name><rename>rideable_type</rename><update>Y</update></value><value><name>started_at</name><rename>started_at</rename><update>Y</update></value><value><name>ended_at</name><rename>ended_at</rename><update>Y</update></value><value><name>start_station_id</name><rename>start_station_id</rename><update>Y</update></value><value><name>end_station_id</name><rename>end_station_id</rename><update>Y</update></value><value><name>start_station_sk</name><rename>start_station_sk</rename><update>Y</update></value><value><name>end_station_sk</name><rename>end_station_sk</rename><update>Y</update></value><value><name>start_lat</name><rename>start_lat</rename><update>Y</update></value><value><name>start_lng</name><rename>start_lng</rename><update>Y</update></value><value><name>end_lat</name><rename>end_lat</rename><update>Y</update></value><value><name>end_lng</name><rename>end_lng</rename><update>Y</update></value><value><name>member_casual</name><rename>member_casual</rename><update>Y</update></value><value><name>duration_minutes</name><rename>duration_minutes</rename><update>Y</update></value><value><name>trip_month</name><rename>trip_month</rename><update>Y</update></value><schema>nds</schema><table>trip</table></lookup><commit>10000</commit><update_bypassed>N</update_bypassed><GUI><xloc>1088</xloc><yloc>96</yloc></GUI></transform>
  <order><hop><from>Read deduplicated staging trips</from><to>Lookup city_sk</to><enabled>Y</enabled></hop><hop><from>Lookup city_sk</from><to>Keep mapped cities</to><enabled>Y</enabled></hop><hop><from>Keep mapped cities</from><to>Lookup start_station_sk</to><enabled>Y</enabled></hop><hop><from>Lookup start_station_sk</from><to>Lookup end_station_sk</to><enabled>Y</enabled></hop><hop><from>Lookup end_station_sk</from><to>Upsert nds.trip</to><enabled>Y</enabled></hop></order>
  <attributes/><transform_error_handling/>
</pipeline>
