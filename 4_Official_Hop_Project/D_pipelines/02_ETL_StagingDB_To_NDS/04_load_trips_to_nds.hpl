      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Keep mapped cities</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>city_sk</leftvalue>
        <function>IS NOT NULL</function>
        <rightvalue/>
        <conditions/>
      </condition>
    </compare>
    <send_true_to>Lookup start_station_sk</send_true_to>
    <send_false_to/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>176</xloc>
      <yloc>400</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBJoin</type>
    <name>Lookup start_station_sk</name>
    <connection>dw-nds</connection>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <sql>SELECT station_sk AS start_station_sk
FROM nds.station
WHERE city_sk = ?
  AND source_station_id = ?
ORDER BY is_current DESC, effective_from DESC
LIMIT 1</sql>
    <rowlimit>1</rowlimit>
    <outer_join>Y</outer_join>
    <parameter>
      <field>
        <name>city_sk</name>
        <type>Integer</type>
      </field>
      <field>
        <name>start_station_id</name>
        <type>String</type>
      </field>
    </parameter>
    <replace_vars>N</replace_vars>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>176</xloc>
      <yloc>560</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
