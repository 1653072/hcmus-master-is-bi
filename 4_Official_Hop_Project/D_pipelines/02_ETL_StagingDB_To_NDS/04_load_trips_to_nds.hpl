        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>city_sk</leftvalue>
        <function>IS NOT NULL</function>
        <rightvalue/>
        <conditions/>
      </condition>
    </compare>
    <send_true_to/>
    <send_false_to/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>176</xloc>
      <yloc>400</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
