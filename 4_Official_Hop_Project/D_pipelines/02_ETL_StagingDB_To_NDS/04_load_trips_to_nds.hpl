    <name>Lookup end_station_sk</name>
    <connection>dw-nds</connection>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <sql>SELECT station_sk AS end_station_sk
FROM nds.station
WHERE city_sk = ?
  AND source_station_id = ?
ORDER BY is_current DESC, effective_from DESC
LIMIT 1</sql>
    <rowlimit>1</rowlimit>
    <outer_join>Y</outer_join>
    <parameter>
      <field>
        <name>city_sk</name>
        <type>Integer</type>
      </field>
      <field>
        <name>end_station_id</name>
        <type>String</type>
      </field>
    </parameter>
    <replace_vars>N</replace_vars>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>176</xloc>
