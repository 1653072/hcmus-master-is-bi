    <parameters/>
    <name>04_load_trips_to_nds</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Hop-native trip load: staging input, city/station lookups scoped by city, then InsertUpdate into nds.trip.</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/16 22:58:43.538</created_date>
    <modified_date>2026/07/16 22:58:43.538</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read deduplicated staging trips</name>
    <sql>WITH source_rows AS (
  	SELECT source_city_code, ride_id, rideable_type, started_at, ended_at, start_station_id, end_station_id, start_lat, start_lng, end_lat, end_lng, member_casual, trip_month, source_file 
	FROM staging.stg_divvy_trips 
	WHERE ride_id IS NOT NULL AND started_at IS NOT NULL
  	
	UNION ALL
  
	SELECT source_city_code, ride_id, rideable_type, started_at, ended_at, start_station_id, end_station_id, start_lat, start_lng, end_lat, end_lng, member_casual, trip_month, source_file 
	FROM staging.stg_citibike_trips 
	WHERE ride_id IS NOT NULL AND started_at IS NOT NULL
), deduplicated AS (
  	SELECT DISTINCT ON (source_city_code, ride_id) * 
	FROM source_rows 
	WHERE source_city_code IS NOT NULL 
	ORDER BY source_city_code, ride_id, source_file
)
SELECT 
	*, 
	TRUE AS is_current,
 	CASE 
		WHEN ended_at IS NOT NULL AND ended_at >= started_at 
		THEN ROUND((EXTRACT(EPOCH FROM ended_at-started_at)/60.0)::NUMERIC,2) 
		ELSE NULL 
	END AS duration_minutes
FROM deduplicated</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>dw-staging</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>176</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
