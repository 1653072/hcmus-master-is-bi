  </transform>
  <transform>
    <type>TableInput</type>
    <name>Read staging trips for pending check</name>
    <sql>SELECT source_city_code, ride_id, start_station_id, end_station_id
FROM staging.stg_divvy_trips
WHERE ride_id IS NOT NULL AND started_at IS NOT NULL
UNION ALL
SELECT source_city_code, ride_id, start_station_id, end_station_id
FROM staging.stg_citibike_trips
WHERE ride_id IS NOT NULL AND started_at IS NOT NULL</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
