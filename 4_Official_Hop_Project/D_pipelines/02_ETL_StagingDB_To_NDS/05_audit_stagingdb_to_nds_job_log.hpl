  <transform>
    <type>ScriptValueMod</type>
    <name>Compute success, total, and failed counts</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var failed = (failed_rows_count == null || String(failed_rows_count).length == 0) ? 0 : Number(failed_rows_count);
var candidates = (candidate_rows_count == null || String(candidate_rows_count).length == 0) ? 0 : Number(candidate_rows_count);
if (failed &lt; 0) failed = 0;
if (failed > candidates) failed = candidates;
var failed_rows_count = Packages.java.lang.Long.valueOf(Math.round(failed));
var success_rows_count = Packages.java.lang.Long.valueOf(Math.round(candidates - failed));
var total_rows_count = Packages.java.lang.Long.valueOf(Math.round(candidates));</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
