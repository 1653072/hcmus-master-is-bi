  <transform>
    <type>ScriptValueMod</type>
    <name>Mark pending master flag</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var startId = start_station_id == null ? "" : String(start_station_id).trim();
var endId = end_station_id == null ? "" : String(end_station_id).trim();
var startPending = startId.length > 0 &amp;&amp; (start_station_found_sk == null || String(start_station_found_sk).length == 0);
var endPending = endId.length > 0 &amp;&amp; (end_station_found_sk == null || String(end_station_found_sk).length == 0);
var is_pending_master = (startPending || endPending) ? 1 : 0;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>is_pending_master</name>
        <rename>is_pending_master</rename>
