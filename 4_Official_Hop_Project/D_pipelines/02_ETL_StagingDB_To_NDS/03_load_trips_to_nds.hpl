<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>03_load_trips_to_nds</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Visible Hop load from staging.stg_divvy_trips and staging.stg_citibike_trips into nds.trip with duration_minutes and station surrogate lookups.</description>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read accepted staging trips</name>
    <connection>dw-staging</connection>
    <sql><![CDATA[SELECT source_city_code, ride_id, rideable_type, started_at, ended_at,
       start_station_id, end_station_id, start_lat, start_lng, end_lat, end_lng,
       member_casual,
       CASE
         WHEN started_at IS NOT NULL AND ended_at IS NOT NULL AND ended_at >= started_at
         THEN ROUND((EXTRACT(EPOCH FROM (ended_at - started_at)) / 60.0)::NUMERIC, 2)
         ELSE NULL
       END AS duration_minutes,
       trip_month
FROM staging.stg_divvy_trips
WHERE ride_id IS NOT NULL AND started_at IS NOT NULL
UNION ALL
SELECT source_city_code, ride_id, rideable_type, started_at, ended_at,
       start_station_id, end_station_id, start_lat, start_lng, end_lat, end_lng,
       member_casual,
       CASE
         WHEN started_at IS NOT NULL AND ended_at IS NOT NULL AND ended_at >= started_at
         THEN ROUND((EXTRACT(EPOCH FROM (ended_at - started_at)) / 60.0)::NUMERIC, 2)
         ELSE NULL
       END AS duration_minutes,
       trip_month
FROM staging.stg_citibike_trips
WHERE ride_id IS NOT NULL AND started_at IS NOT NULL]]></sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <GUI><xloc>96</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <type>DatabaseLookup</type>
    <name>Lookup nds.city</name>
    <connection>dw-nds</connection>
    <schema>nds</schema>
    <table>city</table>
    <cache>N</cache>
    <lookup>
      <key><name>city_code</name><field>source_city_code</field><condition>=</condition><name2/></key>
      <value><name>city_sk</name><rename>city_sk</rename><default/><type>Integer</type></value>
    </lookup>
    <GUI><xloc>336</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>Add current station lookup flag</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var is_current = true;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>is_current</name><rename>is_current</rename><type>Boolean</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <GUI><xloc>456</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <type>DatabaseLookup</type>
    <name>Lookup start station_sk</name>
    <connection>dw-nds</connection>
    <schema>nds</schema>
    <table>station</table>
    <cache>N</cache>
    <lookup>
      <key><name>city_sk</name><field>city_sk</field><condition>=</condition><name2/></key>
      <key><name>source_station_id</name><field>start_station_id</field><condition>=</condition><name2/></key>
      <key><name>is_current</name><field>is_current</field><condition>=</condition><name2/></key>
      <value><name>station_sk</name><rename>start_station_sk</rename><default/><type>Integer</type></value>
    </lookup>
    <GUI><xloc>576</xloc><yloc>48</yloc></GUI>
  </transform>
  <transform>
    <type>DatabaseLookup</type>
    <name>Lookup end station_sk</name>
    <connection>dw-nds</connection>
    <schema>nds</schema>
    <table>station</table>
    <cache>N</cache>
    <lookup>
      <key><name>city_sk</name><field>city_sk</field><condition>=</condition><name2/></key>
      <key><name>source_station_id</name><field>end_station_id</field><condition>=</condition><name2/></key>
      <key><name>is_current</name><field>is_current</field><condition>=</condition><name2/></key>
      <value><name>station_sk</name><rename>end_station_sk</rename><default/><type>Integer</type></value>
    </lookup>
    <GUI><xloc>576</xloc><yloc>160</yloc></GUI>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>Upsert nds.trip</name>
    <connection>dw-nds</connection>
    <lookup>
      <key><name>city_sk</name><field>city_sk</field><condition>=</condition><name2/></key>
      <key><name>ride_id</name><field>ride_id</field><condition>=</condition><name2/></key>
      <value><name>city_sk</name><rename>city_sk</rename><update>N</update></value>
      <value><name>ride_id</name><rename>ride_id</rename><update>N</update></value>
      <value><name>rideable_type</name><rename>rideable_type</rename><update>Y</update></value>
      <value><name>started_at</name><rename>started_at</rename><update>Y</update></value>
      <value><name>ended_at</name><rename>ended_at</rename><update>Y</update></value>
      <value><name>start_station_id</name><rename>start_station_id</rename><update>Y</update></value>
      <value><name>end_station_id</name><rename>end_station_id</rename><update>Y</update></value>
      <value><name>start_station_sk</name><rename>start_station_sk</rename><update>Y</update></value>
      <value><name>end_station_sk</name><rename>end_station_sk</rename><update>Y</update></value>
      <value><name>start_lat</name><rename>start_lat</rename><update>Y</update></value>
      <value><name>start_lng</name><rename>start_lng</rename><update>Y</update></value>
      <value><name>end_lat</name><rename>end_lat</rename><update>Y</update></value>
      <value><name>end_lng</name><rename>end_lng</rename><update>Y</update></value>
      <value><name>member_casual</name><rename>member_casual</rename><update>Y</update></value>
      <value><name>duration_minutes</name><rename>duration_minutes</rename><update>Y</update></value>
      <value><name>trip_month</name><rename>trip_month</rename><update>Y</update></value>
      <schema>nds</schema>
      <table>trip</table>
    </lookup>
    <commit>1000</commit>
    <update_bypassed>N</update_bypassed>
    <GUI><xloc>864</xloc><yloc>96</yloc></GUI>
  </transform>
  <order>
    <hop><from>Read accepted staging trips</from><to>Lookup nds.city</to><enabled>Y</enabled></hop>
    <hop><from>Lookup nds.city</from><to>Add current station lookup flag</to><enabled>Y</enabled></hop>
    <hop><from>Add current station lookup flag</from><to>Lookup start station_sk</to><enabled>Y</enabled></hop>
    <hop><from>Lookup start station_sk</from><to>Lookup end station_sk</to><enabled>Y</enabled></hop>
    <hop><from>Lookup end station_sk</from><to>Upsert nds.trip</to><enabled>Y</enabled></hop>
  </order>
  <notepads>
    <notepad><note>Target: nds.trip. Idempotent key: city_sk + ride_id. duration_minutes is derived from started_at and ended_at; station surrogate keys are looked up by city_sk + source station id.</note><xloc>96</xloc><yloc>256</yloc><width>840</width><heigth>80</heigth></notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
