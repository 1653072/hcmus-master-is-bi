<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>03_load_trips_to_nds</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Bulk copies valid staging trip rows into the transient NDS import.stg_trip buffer.</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/08 22:53:39.604</created_date>
    <modified_date>2026/07/11 00:00:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read accepted staging trips</name>
    <sql><![CDATA[SELECT source_city_code, ride_id, rideable_type, started_at, ended_at,
       start_station_id, end_station_id, start_lat, start_lng, end_lat, end_lng,
       member_casual, trip_month
FROM staging.stg_divvy_trips
WHERE ride_id IS NOT NULL AND started_at IS NOT NULL
UNION ALL
SELECT source_city_code, ride_id, rideable_type, started_at, ended_at,
       start_station_id, end_station_id, start_lat, start_lng, end_lat, end_lng,
       member_casual, trip_month
FROM staging.stg_citibike_trips
WHERE ride_id IS NOT NULL AND started_at IS NOT NULL]]></sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>dw-staging</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Bulk write import.stg_trip</name>
    <connection>dw-nds</connection>
    <schema>import</schema>
    <table>stg_trip</table>
    <commit>10000</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <fields>
      <field><stream_name>source_city_code</stream_name><column_name>source_city_code</column_name></field>
      <field><stream_name>ride_id</stream_name><column_name>ride_id</column_name></field>
      <field><stream_name>rideable_type</stream_name><column_name>rideable_type</column_name></field>
      <field><stream_name>started_at</stream_name><column_name>started_at</column_name></field>
      <field><stream_name>ended_at</stream_name><column_name>ended_at</column_name></field>
      <field><stream_name>start_station_id</stream_name><column_name>start_station_id</column_name></field>
      <field><stream_name>end_station_id</stream_name><column_name>end_station_id</column_name></field>
      <field><stream_name>start_lat</stream_name><column_name>start_lat</column_name></field>
      <field><stream_name>start_lng</stream_name><column_name>start_lng</column_name></field>
      <field><stream_name>end_lat</stream_name><column_name>end_lat</column_name></field>
      <field><stream_name>end_lng</stream_name><column_name>end_lng</column_name></field>
      <field><stream_name>member_casual</stream_name><column_name>member_casual</column_name></field>
      <field><stream_name>trip_month</stream_name><column_name>trip_month</column_name></field>
    </fields>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>384</xloc>
      <yloc>96</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Read accepted staging trips</from>
      <to>Bulk write import.stg_trip</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads>
    <notepad>
      <note>Target buffer: import.stg_trip. This pipeline only bulk-copies valid staging rows; city/station lookup, duration_minutes, and nds.trip upsert run in 03_merge_trip_buffer_to_nds.hpl.</note>
      <fontsize>-1</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>96</xloc>
      <yloc>224</yloc>
      <width>840</width>
      <height>-1</height>
    </notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
