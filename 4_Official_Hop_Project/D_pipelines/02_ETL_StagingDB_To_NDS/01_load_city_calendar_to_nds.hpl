<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>01_load_city_calendar_to_nds</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Visible Hop load for NDS reference entities: observed staging city codes into nds.city and staged date bounds into nds.calendar_day.</description>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read observed staging city codes</name>
    <connection>dw-staging</connection>
    <sql><![CDATA[WITH observed_city AS (
  SELECT source_city_code FROM staging.stg_gbfs_station
  UNION
  SELECT source_city_code FROM staging.stg_weather
  UNION
  SELECT source_city_code FROM staging.stg_divvy_trips
  UNION
  SELECT source_city_code FROM staging.stg_citibike_trips
)
SELECT DISTINCT
  source_city_code AS city_code,
  CASE source_city_code
    WHEN 'CHI' THEN 'Chicago'
    WHEN 'NYC' THEN 'New York City'
  END AS city_name,
  CASE source_city_code
    WHEN 'CHI' THEN 'America/Chicago'
    WHEN 'NYC' THEN 'America/New_York'
  END AS timezone,
  CASE source_city_code
    WHEN 'CHI' THEN 'USW00014819'
    WHEN 'NYC' THEN 'USW00094728'
  END AS noaa_station_id,
  CASE source_city_code
    WHEN 'CHI' THEN 'divvy'
    WHEN 'NYC' THEN 'citibike'
  END AS gbfs_system_id
FROM observed_city
WHERE source_city_code IN ('CHI', 'NYC')]]></sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <GUI><xloc>96</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>Upsert nds.city</name>
    <connection>dw-nds</connection>
    <lookup>
      <key><name>city_code</name><field>city_code</field><condition>=</condition><name2/></key>
      <value><name>city_code</name><rename>city_code</rename><update>N</update></value>
      <value><name>city_name</name><rename>city_name</rename><update>Y</update></value>
      <value><name>timezone</name><rename>timezone</rename><update>Y</update></value>
      <value><name>noaa_station_id</name><rename>noaa_station_id</rename><update>Y</update></value>
      <value><name>gbfs_system_id</name><rename>gbfs_system_id</rename><update>Y</update></value>
      <schema>nds</schema>
      <table>city</table>
    </lookup>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <GUI><xloc>432</xloc><yloc>80</yloc></GUI>
  </transform>
  <transform>
    <type>TableInput</type>
    <name>Generate staging calendar days</name>
    <connection>dw-staging</connection>
    <sql><![CDATA[WITH date_candidates AS (
  SELECT started_at::DATE AS calendar_date
  FROM staging.stg_divvy_trips
  WHERE started_at IS NOT NULL
  UNION ALL
  SELECT ended_at::DATE
  FROM staging.stg_divvy_trips
  WHERE ended_at IS NOT NULL
  UNION ALL
  SELECT started_at::DATE
  FROM staging.stg_citibike_trips
  WHERE started_at IS NOT NULL
  UNION ALL
  SELECT ended_at::DATE
  FROM staging.stg_citibike_trips
  WHERE ended_at IS NOT NULL
  UNION ALL
  SELECT observation_ts::DATE
  FROM staging.stg_weather
  WHERE observation_ts IS NOT NULL
),
bounds AS (
  SELECT
    MIN(calendar_date) AS start_date,
    MAX(calendar_date) AS end_date
  FROM date_candidates
  HAVING COUNT(calendar_date) > 0
)
SELECT
  d::DATE AS calendar_date,
  EXTRACT(ISODOW FROM d)::SMALLINT AS day_of_week,
  (EXTRACT(ISODOW FROM d) IN (6, 7)) AS is_weekend,
  EXTRACT(MONTH FROM d)::SMALLINT AS month,
  CASE
    WHEN EXTRACT(MONTH FROM d) IN (12, 1, 2) THEN 'winter'
    WHEN EXTRACT(MONTH FROM d) IN (3, 4, 5) THEN 'spring'
    WHEN EXTRACT(MONTH FROM d) IN (6, 7, 8) THEN 'summer'
    ELSE 'fall'
  END AS season
FROM bounds
CROSS JOIN LATERAL generate_series(start_date, end_date, INTERVAL '1 day') AS d
WHERE start_date IS NOT NULL
  AND end_date IS NOT NULL
  AND start_date <= end_date]]></sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <GUI><xloc>96</xloc><yloc>224</yloc></GUI>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>Upsert nds.calendar_day</name>
    <connection>dw-nds</connection>
    <lookup>
      <key><name>calendar_date</name><field>calendar_date</field><condition>=</condition><name2/></key>
      <value><name>calendar_date</name><rename>calendar_date</rename><update>N</update></value>
      <value><name>day_of_week</name><rename>day_of_week</rename><update>Y</update></value>
      <value><name>is_weekend</name><rename>is_weekend</rename><update>Y</update></value>
      <value><name>month</name><rename>month</rename><update>Y</update></value>
      <value><name>season</name><rename>season</rename><update>Y</update></value>
      <schema>nds</schema>
      <table>calendar_day</table>
    </lookup>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <GUI><xloc>432</xloc><yloc>224</yloc></GUI>
  </transform>
  <order>
    <hop><from>Read observed staging city codes</from><to>Upsert nds.city</to><enabled>Y</enabled></hop>
    <hop><from>Generate staging calendar days</from><to>Upsert nds.calendar_day</to><enabled>Y</enabled></hop>
  </order>
  <notepads>
    <notepad><note>Target: nds.city and nds.calendar_day. These reference/calendar entities are generated before station/weather/trip because downstream NDS loads lookup city_sk and DDS/calendar analysis expects calendar_day to be present.</note><xloc>96</xloc><yloc>352</yloc><width>760</width><heigth>80</heigth></notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
