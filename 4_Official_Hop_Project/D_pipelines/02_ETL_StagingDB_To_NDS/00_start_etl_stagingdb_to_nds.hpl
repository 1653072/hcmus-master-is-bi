<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>00_start_etl_stagingdb_to_nds</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Captures ETL start time and sets workflow variable ETL_STAGINGDB_TO_NDS_STARTED_AT for downstream NDS audit logging.</description>
  </info>
  <transform>
    <type>RowGenerator</type>
    <name>Generate single start row</name>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <row_time_field>now</row_time_field>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <limit>1</limit>
    <fields>
</fields>
    <GUI><xloc>96</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>Compute ETL_STAGINGDB_TO_NDS_STARTED_AT</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var etl_stagingdb_to_nds_started_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now()).toString();</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>etl_stagingdb_to_nds_started_at</name><rename>etl_stagingdb_to_nds_started_at</rename><type>String</type><length>32</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <GUI><xloc>384</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <type>SetVariable</type>
    <name>Set ETL_STAGINGDB_TO_NDS_STARTED_AT</name>
    <fields>
      <field>
        <field_name>etl_stagingdb_to_nds_started_at</field_name>
        <variable_name>ETL_STAGINGDB_TO_NDS_STARTED_AT</variable_name>
        <variable_type>JVM</variable_type>
        <default_value>2026-01-01 00:00:00.0</default_value>
      </field>
    </fields>
    <use_formatting>Y</use_formatting>
    <GUI><xloc>672</xloc><yloc>96</yloc></GUI>
  </transform>
  <order>
    <hop><from>Generate single start row</from><to>Compute ETL_STAGINGDB_TO_NDS_STARTED_AT</to><enabled>Y</enabled></hop>
    <hop><from>Compute ETL_STAGINGDB_TO_NDS_STARTED_AT</from><to>Set ETL_STAGINGDB_TO_NDS_STARTED_AT</to><enabled>Y</enabled></hop>
  </order>
  <notepads>
    <notepad><note>Sets ETL_STAGINGDB_TO_NDS_STARTED_AT before the NDS load chain.
05_audit_stagingdb_to_nds_job_log reads it with GetVariable and writes it to control.etl_job_log.started_at.</note><xloc>96</xloc><yloc>224</yloc><width>840</width><heigth>80</heigth></notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
