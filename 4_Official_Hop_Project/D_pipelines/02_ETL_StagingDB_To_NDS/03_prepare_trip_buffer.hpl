<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>03_prepare_trip_buffer</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Truncates the transient NDS trip buffer before each bulk copy from StagingDB.</description>
  </info>
  <transform>
    <type>ExecSql</type>
    <name>Prepare import.stg_trip</name>
    <connection>dw-nds</connection>
    <sql>TRUNCATE TABLE import.stg_trip;</sql>
    <execute_each_row>N</execute_each_row>
    <update_field/>
    <insert_field/>
    <delete_field/>
    <read_field/>
    <single_statement>Y</single_statement>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <set_params>N</set_params>
    <arguments/>
    <GUI><xloc>96</xloc><yloc>96</yloc></GUI>
  </transform>
  <order/>
  <notepads>
    <notepad><note>Runs before the bulk buffer copy. Reruns are safe because StagingDB remains the recovery source.</note><xloc>96</xloc><yloc>224</yloc><width>760</width><height>-1</height></notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
