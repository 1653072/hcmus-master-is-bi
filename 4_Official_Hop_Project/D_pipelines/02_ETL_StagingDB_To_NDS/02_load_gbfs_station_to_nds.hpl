<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>02_load_gbfs_station_to_nds</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Visible Hop load from staging.stg_gbfs_station into nds.station using city_sk and short_name/source_station_id as the business key.</description>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read staging.stg_gbfs_station</name>
    <connection>dw-staging</connection>
    <sql><![CDATA[SELECT
  source_city_code,
  short_name AS source_station_id,
  station_name,
  latitude,
  longitude,
  capacity,
  COALESCE(station_status, 'open') AS station_status
FROM staging.stg_gbfs_station
WHERE short_name IS NOT NULL]]></sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <GUI><xloc>96</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Lookup nds.city by source_city_code</name>
    <connection>dw-nds</connection>
    <cache>N</cache>
    <lookup>
      <schema>nds</schema>
      <table>city</table>
      <key><name>source_city_code</name><field>city_code</field><condition>=</condition><name2/></key>
      <value><name>city_sk</name><rename>city_sk</rename><default/><type>Integer</type></value>
    </lookup>
    <GUI><xloc>384</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>Upsert nds.station</name>
    <connection>dw-nds</connection>
    <lookup>
      <key><name>city_sk</name><field>city_sk</field><condition>=</condition><name2/></key>
      <key><name>source_station_id</name><field>source_station_id</field><condition>=</condition><name2/></key>
      <value><name>city_sk</name><rename>city_sk</rename><update>N</update></value>
      <value><name>source_station_id</name><rename>source_station_id</rename><update>N</update></value>
      <value><name>station_name</name><rename>station_name</rename><update>Y</update></value>
      <value><name>latitude</name><rename>latitude</rename><update>Y</update></value>
      <value><name>longitude</name><rename>longitude</rename><update>Y</update></value>
      <value><name>capacity</name><rename>capacity</rename><update>Y</update></value>
      <value><name>station_status</name><rename>station_status</rename><update>Y</update></value>
      <schema>nds</schema>
      <table>station</table>
    </lookup>
    <commit>1000</commit>
    <update_bypassed>N</update_bypassed>
    <GUI><xloc>672</xloc><yloc>96</yloc></GUI>
  </transform>
  <order>
    <hop><from>Read staging.stg_gbfs_station</from><to>Lookup nds.city by source_city_code</to><enabled>Y</enabled></hop>
    <hop><from>Lookup nds.city by source_city_code</from><to>Upsert nds.station</to><enabled>Y</enabled></hop>
  </order>
  <notepads>
    <notepad><note>Target: nds.station. Business key: city_sk + source_station_id. Source station id is GBFS short_name.</note><xloc>96</xloc><yloc>224</yloc><width>760</width><heigth>80</heigth></notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
