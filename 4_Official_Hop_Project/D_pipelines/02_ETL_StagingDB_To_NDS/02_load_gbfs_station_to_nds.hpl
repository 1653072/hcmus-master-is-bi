  <transform>
    <type>ScriptValueMod</type>
    <name>Decide route and timestamps</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var Timestamp = Packages.java.sql.Timestamp;
var Instant = Packages.java.time.Instant;
var nowTs = Timestamp.from(Instant.now());
var loaded_at = nowTs;
var effective_from = nowTs;
var effective_to = nowTs;
var row_status = "active";
var is_current = true;
var route = "SKIP";

var existsActive = (nds_station_sk != null &amp;&amp; nds_station_sk != undefined &amp;&amp; String(nds_station_sk).length > 0);
var op = String(operation == null ? "UPDATE" : operation).toUpperCase();

if (city_sk == null || String(city_sk).length == 0) {
  route = "SKIP";
} else if (op == "DELETE") {
  if (existsActive) {
    route = "DELETE";
    row_status = "deleted";
    is_current = false;
  } else {
    route = "SKIP";
  }
} else {
  // INSERT / UPDATE
  if (existsActive) {
    route = "UPDATE";
  } else {
    route = "INSERT";
  }
  
  row_status = "active";
  is_current = true;
  effective_to = null;
}</jsScript_script>
      </jsScript>
    </jsScripts>
