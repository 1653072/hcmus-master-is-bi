<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>05_cleanup_nds_trip_buffer</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Truncates the transient NDS trip buffer after audit logging succeeds.</description>
  </info>
  <transform>
    <type>ExecSql</type>
    <name>Truncate import.stg_trip</name>
    <connection>dw-nds</connection>
    <sql>TRUNCATE TABLE import.stg_trip;</sql>
    <execute_each_row>N</execute_each_row>
    <update_field/>
    <insert_field/>
    <delete_field/>
    <read_field/>
    <single_statement>Y</single_statement>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <set_params>N</set_params>
    <arguments/>
    <GUI><xloc>96</xloc><yloc>96</yloc></GUI>
  </transform>
  <order/>
  <notepads>
    <notepad><note>Runs after NDS audit success and before Staging cleanup. If audit fails, the buffer is preserved for investigation.</note><xloc>96</xloc><yloc>224</yloc><width>760</width><height>-1</height></notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
