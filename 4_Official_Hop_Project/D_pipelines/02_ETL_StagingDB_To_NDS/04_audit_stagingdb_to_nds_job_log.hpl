<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>04_audit_stagingdb_to_nds_job_log</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Writes one control.etl_job_log row for the successful StagingDB to NDS load before staging cleanup runs.</description>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Read StagingDB to NDS candidate counts</name>
    <connection>dw-staging</connection>
    <sql><![CDATA[WITH
city_rows AS (
  SELECT COUNT(DISTINCT source_city_code)::INTEGER AS row_count
  FROM (
    SELECT source_city_code FROM staging.stg_gbfs_station
    UNION ALL
    SELECT source_city_code FROM staging.stg_weather
    UNION ALL
    SELECT source_city_code FROM staging.stg_divvy_trips
    UNION ALL
    SELECT source_city_code FROM staging.stg_citibike_trips
  ) c
  WHERE source_city_code IN ('CHI', 'NYC')
),
date_candidates AS (
  SELECT started_at::DATE AS calendar_date FROM staging.stg_divvy_trips WHERE started_at IS NOT NULL
  UNION ALL
  SELECT ended_at::DATE FROM staging.stg_divvy_trips WHERE ended_at IS NOT NULL
  UNION ALL
  SELECT started_at::DATE FROM staging.stg_citibike_trips WHERE started_at IS NOT NULL
  UNION ALL
  SELECT ended_at::DATE FROM staging.stg_citibike_trips WHERE ended_at IS NOT NULL
  UNION ALL
  SELECT observation_ts::DATE FROM staging.stg_weather WHERE observation_ts IS NOT NULL
),
calendar_rows AS (
  SELECT
    CASE
      WHEN COUNT(calendar_date) = 0 THEN 0
      ELSE (MAX(calendar_date) - MIN(calendar_date) + 1)::INTEGER
    END AS row_count
  FROM date_candidates
),
station_rows AS (
  SELECT COUNT(*)::INTEGER AS row_count
  FROM staging.stg_gbfs_station
  WHERE short_name IS NOT NULL
),
weather_rows AS (
  SELECT COUNT(*)::INTEGER AS row_count
  FROM (
    SELECT source_city_code, date_trunc('hour', observation_ts) AS observation_hour
    FROM staging.stg_weather
    WHERE observation_ts IS NOT NULL
    GROUP BY source_city_code, date_trunc('hour', observation_ts)
  ) w
),
trip_rows AS (
  SELECT COUNT(DISTINCT (source_city_code, ride_id))::INTEGER AS row_count
  FROM (
    SELECT source_city_code, ride_id
    FROM staging.stg_divvy_trips
    WHERE ride_id IS NOT NULL AND started_at IS NOT NULL
    UNION ALL
    SELECT source_city_code, ride_id
    FROM staging.stg_citibike_trips
    WHERE ride_id IS NOT NULL AND started_at IS NOT NULL
  ) t
)
SELECT
  (city_rows.row_count + calendar_rows.row_count + station_rows.row_count + weather_rows.row_count + trip_rows.row_count)::INTEGER AS total_rows_count,
  (city_rows.row_count + calendar_rows.row_count + station_rows.row_count + weather_rows.row_count + trip_rows.row_count)::INTEGER AS success_rows_count,
  0::INTEGER AS failed_rows_count
FROM city_rows, calendar_rows, station_rows, weather_rows, trip_rows]]></sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lookup/>
    <sql_from_file/>
    <GUI><xloc>96</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <type>GetVariable</type>
    <name>Get ETL_STAGINGDB_TO_NDS_STARTED_AT</name>
    <fields>
      <field>
        <name>etl_stagingdb_to_nds_started_at_raw</name>
        <variable>${ETL_STAGINGDB_TO_NDS_STARTED_AT}</variable>
        <type>String</type>
        <format/>
        <length>32</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI><xloc>384</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>Add NDS audit fields</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>process</jsScript_name>
        <jsScript_script>var job_name = "etl_stagingdb_to_nds";
var source_name = "stagingdb_to_nds";
var status = "SUCCESS";
var finished_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());
var started_at;
try {
  started_at = Packages.java.sql.Timestamp.valueOf(etl_stagingdb_to_nds_started_at_raw);
} catch(e) {
  try {
    started_at = Packages.java.sql.Timestamp.valueOf(getVariable("ETL_STAGINGDB_TO_NDS_STARTED_AT", "2026-01-01 00:00:00.0"));
  } catch(e2) {
    started_at = finished_at;
  }
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>job_name</name><rename>job_name</rename><type>String</type><length>100</length><precision>-1</precision><replace>N</replace></field>
      <field><name>source_name</name><rename>source_name</rename><type>String</type><length>100</length><precision>-1</precision><replace>N</replace></field>
      <field><name>started_at</name><rename>started_at</rename><type>Timestamp</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>finished_at</name><rename>finished_at</rename><type>Timestamp</type><length>-1</length><precision>-1</precision><replace>N</replace></field>
      <field><name>status</name><rename>status</rename><type>String</type><length>20</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <optimizationLevel>9</optimizationLevel>
    <GUI><xloc>672</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Insert control.etl_job_log row</name>
    <connection>dw-control</connection>
    <schema>control</schema>
    <table>etl_job_log</table>
    <commit>10</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <fields>
      <field><stream_name>job_name</stream_name><column_name>job_name</column_name></field>
      <field><stream_name>source_name</stream_name><column_name>source_name</column_name></field>
      <field><stream_name>started_at</stream_name><column_name>started_at</column_name></field>
      <field><stream_name>finished_at</stream_name><column_name>finished_at</column_name></field>
      <field><stream_name>status</stream_name><column_name>status</column_name></field>
      <field><stream_name>total_rows_count</stream_name><column_name>total_rows_count</column_name></field>
      <field><stream_name>success_rows_count</stream_name><column_name>success_rows_count</column_name></field>
      <field><stream_name>failed_rows_count</stream_name><column_name>failed_rows_count</column_name></field>
    </fields>
    <GUI><xloc>960</xloc><yloc>96</yloc></GUI>
  </transform>
  <order>
    <hop><from>Read StagingDB to NDS candidate counts</from><to>Get ETL_STAGINGDB_TO_NDS_STARTED_AT</to><enabled>Y</enabled></hop>
    <hop><from>Get ETL_STAGINGDB_TO_NDS_STARTED_AT</from><to>Add NDS audit fields</to><enabled>Y</enabled></hop>
    <hop><from>Add NDS audit fields</from><to>Insert control.etl_job_log row</to><enabled>Y</enabled></hop>
  </order>
  <notepads>
    <notepad><note>Writes job_name=etl_stagingdb_to_nds before cleanup.
GetVariable appends the workflow timestamp field to the incoming candidate-count row.
Counts are candidate rows read/generated from staging for city, calendar_day, station, deduped weather hours, and valid trip keys.</note><xloc>96</xloc><yloc>232</yloc><width>880</width><heigth>80</heigth></notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
