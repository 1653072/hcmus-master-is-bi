<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>-1</pipeline_status>
    <parameters/>
    <name>06_cleanup_staging_after_nds</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>After StagingDB to NDS: truncate raw + stg_weather + stg_gbfs_station; delete only staging trips that already exist in nds.trip. Keep pending late-master trips on staging.</description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/07/16 23:09:04.009</created_date>
    <modified_date>2026/07/17 01:40:00.000</modified_date>
  </info>
  <transform>
    <type>RowGenerator</type>
    <name>Generate 1 cleanup trigger row</name>
    <never_ending>N</never_ending>
    <interval_in_ms>5000</interval_in_ms>
    <row_time_field/>
    <last_time_field/>
    <limit>1</limit>
    <fields>
      <field>
        <name>cleanup_trigger</name>
        <type>Integer</type>
        <format/>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <nullif>1</nullif>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>352</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ExecSql</type>
    <name>Truncate all temporary rate tables + 2 staging tables (weather &amp; gbfs_station)</name>
    <connection>dw-staging</connection>
    <sql>TRUNCATE TABLE
  staging.raw_divvy_trips,
  staging.raw_citibike_trips,
  staging.raw_noaa_weather,
  staging.raw_gbfs_station,
  staging.stg_weather,
  staging.stg_gbfs_station;</sql>
    <execute_each_row>Y</execute_each_row>
    <update_field/>
    <insert_field/>
    <delete_field/>
    <read_field/>
    <single_statement>N</single_statement>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <set_params>N</set_params>
    <arguments/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>352</xloc>
      <yloc>288</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableInput</type>
    <name>Read staging trip keys</name>
    <sql>SELECT source_city_code, ride_id
FROM staging.stg_divvy_trips
WHERE ride_id IS NOT NULL
UNION ALL
SELECT source_city_code, ride_id
FROM staging.stg_citibike_trips
WHERE ride_id IS NOT NULL</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>dw-staging</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>752</xloc>
      <yloc>160</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Lookup city_sk</name>
    <connection>dw-nds</connection>
    <cache>Y</cache>
    <cache_size>0</cache_size>
    <cache_load_all>Y</cache_load_all>
    <lookup>
      <schema>nds</schema>
      <table>city</table>
      <key>
        <name>source_city_code</name>
        <name2/>
        <condition>=</condition>
        <field>city_code</field>
      </key>
      <value>
        <name>city_sk</name>
        <rename>city_sk</rename>
        <default/>
        <type>Integer</type>
      </value>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>752</xloc>
      <yloc>288</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Lookup nds.trip</name>
    <connection>dw-nds</connection>
    <cache>N</cache>
    <cache_size>0</cache_size>
    <cache_load_all>N</cache_load_all>
    <lookup>
      <schema>nds</schema>
      <table>trip</table>
      <key>
        <name>city_sk</name>
        <name2/>
        <condition>=</condition>
        <field>city_sk</field>
      </key>
      <key>
        <name>ride_id</name>
        <name2/>
        <condition>=</condition>
        <field>ride_id</field>
      </key>
      <value>
        <name>trip_sk</name>
        <rename>trip_sk</rename>
        <default/>
        <type>BigNumber</type>
      </value>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>752</xloc>
      <yloc>416</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>FilterRows</type>
    <name>Is trips loaded to NDS?</name>
    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>trip_sk</leftvalue>
        <function>IS NOT NULL</function>
        <conditions/>
      </condition>
    </compare>
    <send_true_to>Delete resolved stg_divvy_trips</send_true_to>
    <send_false_to>Keep pending trips in staging due to empty master start/end_station_sk</send_false_to>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>752</xloc>
      <yloc>544</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Keep pending trips in staging due to empty master start/end_station_sk</name>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1136</xloc>
      <yloc>544</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Delete</type>
    <name>Delete resolved stg_divvy_trips</name>
    <lookup>
      <key>
        <name>source_city_code</name>
        <field>source_city_code</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>ride_id</name>
        <field>ride_id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <schema>staging</schema>
      <table>stg_divvy_trips</table>
    </lookup>
    <connection>dw-staging</connection>
    <commit>5000</commit>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>752</xloc>
      <yloc>672</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Delete</type>
    <name>Delete resolved stg_citibike_trips</name>
    <lookup>
      <key>
        <name>source_city_code</name>
        <field>source_city_code</field>
        <condition>=</condition>
        <name2/>
      </key>
      <key>
        <name>ride_id</name>
        <field>ride_id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <schema>staging</schema>
      <table>stg_citibike_trips</table>
    </lookup>
    <connection>dw-staging</connection>
    <commit>5000</commit>
    <distribute>N</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>752</xloc>
      <yloc>800</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Generate 1 cleanup trigger row</from>
      <to>Truncate all temporary rate tables + 2 staging tables (weather &amp; gbfs_station)</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read staging trip keys</from>
      <to>Lookup city_sk</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup city_sk</from>
      <to>Lookup nds.trip</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup nds.trip</from>
      <to>Is trips loaded to NDS?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Is trips loaded to NDS?</from>
      <to>Keep pending trips in staging due to empty master start/end_station_sk</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Is trips loaded to NDS?</from>
      <to>Delete resolved stg_divvy_trips</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Delete resolved stg_divvy_trips</from>
      <to>Delete resolved stg_citibike_trips</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads>
    <notepad>
      <note>Two parallel streams:
A) Generate → Truncate raw_* + stg_weather + stg_gbfs_station
B) Read stg_*_trips (execute_each_row=N, independent start) → lookup nds.trip → delete only when trip_sk IS NOT NULL (keep pending late-master)</note>
      <fontsize>-1</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>32</xloc>
      <yloc>64</yloc>
      <width>880</width>
      <height>-1</height>
    </notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
