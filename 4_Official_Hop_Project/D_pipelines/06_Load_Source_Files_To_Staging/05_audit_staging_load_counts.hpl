<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info><pipeline_type>Normal</pipeline_type><pipeline_status>-1</pipeline_status><parameters/><name>05_audit_staging_load_counts</name><name_sync_with_filename>Y</name_sync_with_filename></info>
  <transform>
    <type>TableInput</type>
    <name>Read staging row counts</name>
    <sql>SELECT 'divvy_trips' AS source_name, 'stg_divvy_trips' AS table_name, COUNT(*)::INTEGER AS rows_extracted FROM staging.stg_divvy_trips
UNION ALL SELECT 'citibike_trips', 'stg_citibike_trips', COUNT(*)::INTEGER FROM staging.stg_citibike_trips
UNION ALL SELECT 'noaa_lcd', 'stg_weather', COUNT(*)::INTEGER FROM staging.stg_weather
UNION ALL SELECT 'gbfs_station', 'stg_gbfs_station', COUNT(*)::INTEGER FROM staging.stg_gbfs_station</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>dw-staging</connection>
    <lookup/>
    <sql_from_file/>
    <GUI><xloc>96</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <type>ScriptValueMod</type>
    <name>Add audit fields</name>
    <jsScripts><jsScript><jsScript_type>0</jsScript_type><jsScript_name>process</jsScript_name><jsScript_script>var job_name = "load_source_files_to_staging";
var status = "SUCCESS";
var finished_at = Packages.java.sql.Timestamp.from(Packages.java.time.Instant.now());</jsScript_script></jsScript></jsScripts>
    <fields><field><name>job_name</name><rename>job_name</rename><type>String</type><length>100</length><precision>-1</precision><replace>N</replace></field><field><name>status</name><rename>status</rename><type>String</type><length>20</length><precision>-1</precision><replace>N</replace></field><field><name>finished_at</name><rename>finished_at</rename><type>Timestamp</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields>
    <optimizationLevel>9</optimizationLevel>
    <GUI><xloc>352</xloc><yloc>96</yloc></GUI>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>Update control.etl_extraction_control</name>
    <lookup>
      <key><name>source_name</name><field>source_name</field><condition>=</condition><name2/></key>
      <key><name>table_name</name><field>table_name</field><condition>=</condition><name2/></key>
      <value><name>source_name</name><rename>source_name</rename><update>N</update></value>
      <value><name>table_name</name><rename>table_name</rename><update>N</update></value>
      <value><name>rows_extracted</name><rename>rows_extracted</rename><update>Y</update></value>
      <value><name>last_run_status</name><rename>status</rename><update>Y</update></value>
      <value><name>updated_at</name><rename>finished_at</rename><update>Y</update></value>
      <schema>control</schema><table>etl_extraction_control</table>
    </lookup>
    <commit>10</commit><update_bypassed>N</update_bypassed><connection>dw-control</connection>
    <GUI><xloc>608</xloc><yloc>32</yloc></GUI>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Insert control.etl_job_log rows</name>
    <connection>dw-control</connection>
    <schema>control</schema>
    <table>etl_job_log</table>
    <commit>10</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <fields><field><stream_name>job_name</stream_name><column_name>job_name</column_name></field><field><stream_name>source_name</stream_name><column_name>source_name</column_name></field><field><stream_name>finished_at</stream_name><column_name>finished_at</column_name></field><field><stream_name>status</stream_name><column_name>status</column_name></field><field><stream_name>rows_extracted</stream_name><column_name>rows_processed</column_name></field></fields>
    <GUI><xloc>608</xloc><yloc>176</yloc></GUI>
  </transform>
  <order><hop><from>Read staging row counts</from><to>Add audit fields</to><enabled>Y</enabled></hop><hop><from>Add audit fields</from><to>Update control.etl_extraction_control</to><enabled>Y</enabled></hop><hop><from>Add audit fields</from><to>Insert control.etl_job_log rows</to><enabled>Y</enabled></hop></order>
  <notepads/><attributes/><transform_error_handling/>
</pipeline>
