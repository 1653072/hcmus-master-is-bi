<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>01_load_source_files_to_staging</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <parameters/>
  <actions>
    <action><name>Start</name><type>SPECIAL</type><xloc>48</xloc><yloc>160</yloc><parallel>N</parallel></action>
    <action><connections><connection><name>dw-staging</name><waitfor>0</waitfor><waittime>millisecond</waittime></connection></connections><name>Check dw-staging</name><type>CHECK_DB_CONNECTIONS</type><xloc>224</xloc><yloc>160</yloc><parallel>N</parallel></action>
    <action><filename>${PROJECT_HOME}/D_pipelines/01_Load_Source_Files_To_Staging/01_load_divvy_trips_to_staging.hpl</filename><wait_until_finished>Y</wait_until_finished><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><run_configuration>local</run_configuration><name>01_load_divvy_trips_to_staging.hpl</name><type>PIPELINE</type><xloc>496</xloc><yloc>32</yloc><parallel>N</parallel></action>
    <action><filename>${PROJECT_HOME}/D_pipelines/01_Load_Source_Files_To_Staging/02_load_citibike_trips_to_staging.hpl</filename><wait_until_finished>Y</wait_until_finished><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><run_configuration>local</run_configuration><name>02_load_citibike_trips_to_staging.hpl</name><type>PIPELINE</type><xloc>496</xloc><yloc>128</yloc><parallel>N</parallel></action>
    <action><filename>${PROJECT_HOME}/D_pipelines/01_Load_Source_Files_To_Staging/03_load_noaa_weather_to_staging.hpl</filename><wait_until_finished>Y</wait_until_finished><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><run_configuration>local</run_configuration><name>03_load_noaa_weather_to_staging.hpl</name><type>PIPELINE</type><xloc>496</xloc><yloc>224</yloc><parallel>N</parallel></action>
    <action><filename>${PROJECT_HOME}/D_pipelines/01_Load_Source_Files_To_Staging/04_load_gbfs_station_to_staging.hpl</filename><wait_until_finished>Y</wait_until_finished><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><run_configuration>local</run_configuration><name>04_load_gbfs_station_to_staging.hpl</name><type>PIPELINE</type><xloc>496</xloc><yloc>320</yloc><parallel>N</parallel></action>
    <action><filename>${PROJECT_HOME}/D_pipelines/01_Load_Source_Files_To_Staging/05_audit_staging_load_counts.hpl</filename><wait_until_finished>Y</wait_until_finished><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><run_configuration>local</run_configuration><name>05_audit_staging_load_counts.hpl</name><type>PIPELINE</type><xloc>760</xloc><yloc>320</yloc><parallel>N</parallel></action>
  </actions>
  <hops><hop><from>Start</from><to>Check dw-staging</to><evaluation>Y</evaluation><unconditional>Y</unconditional><enabled>Y</enabled></hop><hop><from>Check dw-staging</from><to>01_load_divvy_trips_to_staging.hpl</to><evaluation>Y</evaluation><unconditional>N</unconditional><enabled>Y</enabled></hop><hop><from>01_load_divvy_trips_to_staging.hpl</from><to>02_load_citibike_trips_to_staging.hpl</to><evaluation>Y</evaluation><unconditional>N</unconditional><enabled>Y</enabled></hop><hop><from>02_load_citibike_trips_to_staging.hpl</from><to>03_load_noaa_weather_to_staging.hpl</to><evaluation>Y</evaluation><unconditional>N</unconditional><enabled>Y</enabled></hop><hop><from>03_load_noaa_weather_to_staging.hpl</from><to>04_load_gbfs_station_to_staging.hpl</to><evaluation>Y</evaluation><unconditional>N</unconditional><enabled>Y</enabled></hop><hop><from>04_load_gbfs_station_to_staging.hpl</from><to>05_audit_staging_load_counts.hpl</to><evaluation>Y</evaluation><unconditional>N</unconditional><enabled>Y</enabled></hop></hops>
  <attributes/>
