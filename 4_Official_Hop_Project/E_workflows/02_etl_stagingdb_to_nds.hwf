<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <info>
    <name>02_etl_stagingdb_to_nds</name>
    <workflow_type>Normal</workflow_type>
    <workflow_status>-1</workflow_status>
    <parameters/>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Orchestrate staging database loads into NDS.</description>
  </info>
  <actions>
    <action><name>Start</name><type>SPECIAL</type><xloc>48</xloc><yloc>160</yloc><parallel>N</parallel></action>
    <action><name>Run scripts/run_staging_to_nds.sh</name><type>SHELL</type><xloc>272</xloc><yloc>160</yloc><parallel>N</parallel></action>
  </actions>
  <hops>
    <hop><from>Start</from><to>Run scripts/run_staging_to_nds.sh</to><evaluation>Y</evaluation><unconditional>Y</unconditional><enabled>Y</enabled></hop>
  </hops>
</workflow>
