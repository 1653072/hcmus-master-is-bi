<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <info>
    <name>01_etl_source_to_stagingdb</name>
    <workflow_type>Normal</workflow_type>
    <workflow_status>-1</workflow_status>
    <parameters/>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Visible ETL workflow: source files to accepted staging, raw 0NF/DQ validation, DQ audit, and staging audit.</description>
  </info>
  <actions>
    <action><name>Start</name><type>SPECIAL</type><xloc>48</xloc><yloc>160</yloc><parallel>N</parallel></action>
    <action><connections><connection><name>dw-staging</name><waitfor>0</waitfor><waittime>millisecond</waittime></connection><connection><name>dw-control</name><waitfor>0</waitfor><waittime>millisecond</waittime></connection></connections><name>Check staging/control DB</name><type>CHECK_DB_CONNECTIONS</type><xloc>224</xloc><yloc>160</yloc><parallel>N</parallel></action>
    <action><filename>${PROJECT_HOME}/D_pipelines/01_ETL_Source_To_StagingDB/00_start_etl_source_to_staging.hpl</filename><wait_until_finished>Y</wait_until_finished><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><run_configuration>local</run_configuration><name>00_start_etl_source_to_staging.hpl</name><type>PIPELINE</type><xloc>352</xloc><yloc>160</yloc><parallel>N</parallel></action>
    <action><filename>${PROJECT_HOME}/D_pipelines/01_ETL_Source_To_StagingDB/01_load_divvy_trips_to_staging.hpl</filename><wait_until_finished>Y</wait_until_finished><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><run_configuration>local</run_configuration><name>01_load_divvy_trips_to_staging.hpl</name><type>PIPELINE</type><xloc>560</xloc><yloc>40</yloc><parallel>N</parallel></action>
    <action><filename>${PROJECT_HOME}/D_pipelines/01_ETL_Source_To_StagingDB/02_load_citibike_trips_to_staging.hpl</filename><wait_until_finished>Y</wait_until_finished><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><run_configuration>local</run_configuration><name>02_load_citibike_trips_to_staging.hpl</name><type>PIPELINE</type><xloc>480</xloc><yloc>120</yloc><parallel>N</parallel></action>
    <action><filename>${PROJECT_HOME}/D_pipelines/01_ETL_Source_To_StagingDB/03_load_noaa_weather_to_staging.hpl</filename><wait_until_finished>Y</wait_until_finished><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><run_configuration>local</run_configuration><name>03_load_noaa_weather_to_staging.hpl</name><type>PIPELINE</type><xloc>480</xloc><yloc>200</yloc><parallel>N</parallel></action>
    <action><filename>${PROJECT_HOME}/D_pipelines/01_ETL_Source_To_StagingDB/04_load_gbfs_station_to_staging.hpl</filename><wait_until_finished>Y</wait_until_finished><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><run_configuration>local</run_configuration><name>04_load_gbfs_station_to_staging.hpl</name><type>PIPELINE</type><xloc>480</xloc><yloc>280</yloc><parallel>N</parallel></action>
    <action><filename>${PROJECT_HOME}/D_pipelines/01_ETL_Source_To_StagingDB/01_validate_divvy_raw_to_staging.hpl</filename><wait_until_finished>Y</wait_until_finished><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><run_configuration>local</run_configuration><name>01_validate_divvy_raw_to_staging.hpl</name><type>PIPELINE</type><xloc>784</xloc><yloc>40</yloc><parallel>N</parallel></action>
    <action><filename>${PROJECT_HOME}/D_pipelines/01_ETL_Source_To_StagingDB/02_validate_citibike_raw_to_staging.hpl</filename><wait_until_finished>Y</wait_until_finished><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><run_configuration>local</run_configuration><name>02_validate_citibike_raw_to_staging.hpl</name><type>PIPELINE</type><xloc>784</xloc><yloc>120</yloc><parallel>N</parallel></action>
    <action><filename>${PROJECT_HOME}/D_pipelines/01_ETL_Source_To_StagingDB/03_validate_noaa_raw_to_staging.hpl</filename><wait_until_finished>Y</wait_until_finished><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><run_configuration>local</run_configuration><name>03_validate_noaa_raw_to_staging.hpl</name><type>PIPELINE</type><xloc>784</xloc><yloc>200</yloc><parallel>N</parallel></action>
    <action><filename>${PROJECT_HOME}/D_pipelines/01_ETL_Source_To_StagingDB/04_validate_gbfs_raw_to_staging.hpl</filename><wait_until_finished>Y</wait_until_finished><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><run_configuration>local</run_configuration><name>04_validate_gbfs_raw_to_staging.hpl</name><type>PIPELINE</type><xloc>784</xloc><yloc>280</yloc><parallel>N</parallel></action>
    <action><filename>${PROJECT_HOME}/D_pipelines/01_ETL_Source_To_StagingDB/05_audit_dq_rule_results.hpl</filename><wait_until_finished>Y</wait_until_finished><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><run_configuration>local</run_configuration><name>05_audit_dq_rule_results.hpl</name><type>PIPELINE</type><xloc>1088</xloc><yloc>120</yloc><parallel>N</parallel></action>
    <action><filename>${PROJECT_HOME}/D_pipelines/01_ETL_Source_To_StagingDB/05_audit_staging_load_counts.hpl</filename><wait_until_finished>Y</wait_until_finished><parameters><pass_all_parameters>Y</pass_all_parameters></parameters><run_configuration>local</run_configuration><name>05_audit_staging_load_counts.hpl</name><type>PIPELINE</type><xloc>1088</xloc><yloc>240</yloc><parallel>N</parallel></action>
  </actions>
  <hops>
    <hop><from>Start</from><to>Check staging/control DB</to><evaluation>Y</evaluation><unconditional>Y</unconditional><enabled>Y</enabled></hop>
    <hop><from>Check staging/control DB</from><to>00_start_etl_source_to_staging.hpl</to><evaluation>Y</evaluation><unconditional>N</unconditional><enabled>Y</enabled></hop>
    <hop><from>00_start_etl_source_to_staging.hpl</from><to>01_load_divvy_trips_to_staging.hpl</to><evaluation>Y</evaluation><unconditional>N</unconditional><enabled>Y</enabled></hop>
    <hop><from>01_load_divvy_trips_to_staging.hpl</from><to>02_load_citibike_trips_to_staging.hpl</to><evaluation>Y</evaluation><unconditional>N</unconditional><enabled>Y</enabled></hop>
    <hop><from>02_load_citibike_trips_to_staging.hpl</from><to>03_load_noaa_weather_to_staging.hpl</to><evaluation>Y</evaluation><unconditional>N</unconditional><enabled>Y</enabled></hop>
    <hop><from>03_load_noaa_weather_to_staging.hpl</from><to>04_load_gbfs_station_to_staging.hpl</to><evaluation>Y</evaluation><unconditional>N</unconditional><enabled>Y</enabled></hop>
    <hop><from>04_load_gbfs_station_to_staging.hpl</from><to>01_validate_divvy_raw_to_staging.hpl</to><evaluation>Y</evaluation><unconditional>N</unconditional><enabled>Y</enabled></hop>
    <hop><from>01_validate_divvy_raw_to_staging.hpl</from><to>02_validate_citibike_raw_to_staging.hpl</to><evaluation>Y</evaluation><unconditional>N</unconditional><enabled>Y</enabled></hop>
    <hop><from>02_validate_citibike_raw_to_staging.hpl</from><to>03_validate_noaa_raw_to_staging.hpl</to><evaluation>Y</evaluation><unconditional>N</unconditional><enabled>Y</enabled></hop>
    <hop><from>03_validate_noaa_raw_to_staging.hpl</from><to>04_validate_gbfs_raw_to_staging.hpl</to><evaluation>Y</evaluation><unconditional>N</unconditional><enabled>Y</enabled></hop>
    <hop><from>04_validate_gbfs_raw_to_staging.hpl</from><to>05_audit_dq_rule_results.hpl</to><evaluation>Y</evaluation><unconditional>N</unconditional><enabled>Y</enabled></hop>
    <hop><from>05_audit_dq_rule_results.hpl</from><to>05_audit_staging_load_counts.hpl</to><evaluation>Y</evaluation><unconditional>N</unconditional><enabled>Y</enabled></hop>
  </hops>
</workflow>
